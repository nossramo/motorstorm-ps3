+    rsx_draw_engine_guest_read(RSX_LOCATION_LOCAL, 0x40000u + 272u + 254u,
+                               272u, 2u, 1u);
+    CHECK(base[272u+254u] == 3 && base[272u+255u] == 7 && base[272u+256u] == 11,
+          "B8 transfer extracts blue from three RGBA8 host pixels at the row edge");
+    CHECK(base[272u+253u] == 0xEE && base[272u+257u] == 0xEE && base[544u] == 0xEE,
+          "B8 row clipping preserves padding and adjacent rows");
+
+    memset(base, 0xEE, 272u * 4u);
+    rsx_draw_engine_cpu_read(GUEST_LOCAL_EA + 0x40000u + 272u + 256u, 1u);
+    int ok = 1;
+    for (u32 x = 0; x < 257u; ++x)
+        if (base[272u+x] != (u8)(4u*x+3u)) ok = 0;
+    CHECK(ok && base[271u] == 0xEE && base[272u+257u] == 0xEE && base[544u] == 0xEE,
+          "CPU byte load synchronizes all 257 B8 pixels in only the requested row");
