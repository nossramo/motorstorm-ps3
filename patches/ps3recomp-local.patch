+/* RPCS3 TextureUtils documents one shared row pitch for every linear mip.
+ * This fixture deliberately puts poison into padding and the old packed
+ * locations, so correct offsets and row traversal are both required. */
+static void test_linear_mip_pitch(void)
+{
+    const u32 widths[4]={8,4,2,1}, heights[4]={4,2,1,1};
+    const u32 starts[4]={0,52,78,91};
+    rsx_tex_level levels[RSX_MAX_TEXTURE_LEVELS];
+    u8 source[104],decoded[32];
+    memset(source,0xEE,sizeof source);
+    for (u32 m=0;m<4;++m)
+        for(u32 y=0;y<heights[m];++y)
+            for(u32 x=0;x<widths[m];++x)
+                source[starts[m]+y*13+x]=(u8)(m*41+y*8+x);
+    CHECK(rsx_texture_mip_chain(0xA1,8,4,4,13,levels)==4);
+    for(u32 m=0;m<4;++m) {
+        CHECK(levels[m].offset==starts[m]);
+        CHECK(levels[m].tl.row_bytes==13);
+        CHECK(levels[m].tl.face_bytes==13*heights[m]);
+        rsx_texture_decode(decoded,widths[m],source+starts[m],widths[m],heights[m],
+                           &levels[m].tl,0);
+        for(u32 y=0;y<heights[m];++y)
+            for(u32 x=0;x<widths[m];++x)
+                CHECK(decoded[y*widths[m]+x]==m*41+y*8+x);
+    }
+    /* The actual game's nine rendered B8 levels start at these offsets. */
+    const u32 motorstorm[9]={0,0x1000000,0x1800000,0x1C00000,0x1E00000,
+                             0x1F00000,0x1F80000,0x1FC0000,0x1FE0000};
+    CHECK(rsx_texture_mip_chain(0xA1,4096,4096,13,4096,levels)==13);
+    for(u32 m=0;m<9;++m) CHECK(levels[m].offset==motorstorm[m]);
+    /* Swizzled and explicitly tight/no-pitch inputs retain packed levels. */
+    CHECK(rsx_texture_mip_chain(0x81,8,4,4,13,levels)==4);
+    CHECK(levels[1].offset==32 && levels[2].offset==40 && levels[3].offset==42);
+    CHECK(rsx_texture_mip_chain(0xA1,8,4,4,0,levels)==4);
+    CHECK(levels[1].offset==32 && levels[2].offset==40 && levels[3].offset==42);
+}
