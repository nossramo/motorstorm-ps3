+            return None
+        for j in range(end - 1, -1, -1):
+            w = prefix[j]; a = operands(w)
+            if w.mnemonic in ('bl', 'bctrl', 'blrl', 'sc'):
+                return None  # a call may clobber the pointer's source register
+            if not a or a[0] != name or w.mnemonic.startswith(('st', 'lf')):
+                continue
+            if w.mnemonic not in ('lwz', 'ld') or len(a) != 2:
+                return None
+            address = mem(a[1])
+            if address is None:
+                return None
+            disp, base = address
+            width = 8 if w.mnemonic == 'ld' else 4
+            if base == 'r2':
+                return [(disp, width == 8)]
+            if base != 'r1':
+                chain = resolve(base, j, depth + 1)
+                return chain + [(disp, width == 8)] if chain and len(chain) < 2 else None
