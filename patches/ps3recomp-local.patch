+int rsx_fp_metadata_build(rsx_fp_metadata* out, const u8* ucode, u32 bytes)
+{
+    if (!out) return 0;
+    out->bytes = out->instructions = out->constants = 0;
+    out->hash_valid = 0;
+    if (!ucode || bytes > sizeof(out->code)) return 0;
+    for (u32 off = 0; off + 16 <= bytes;) {
+        const u32 w0 = rsx_fp_read_word(ucode + off);
+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        if (w2 & FP_BRANCH) return 0;
+        out->instruction_offsets[out->instructions] = off;
+        memcpy(out->code + out->instructions++ * 16u, ucode + off, 16);
+        off += 16;
+        if (fp_instruction_has_constant(w1,w2,w3)) {
+            if (off + 16 > bytes || out->constants == RSX_FP_MAX_INLINE_CONSTANTS) return 0;
+            out->constant_offsets[out->constants++] = off;
+            off += 16;
+        }
+        if (w0 & FP_END) {
+            if (off != bytes) return 0;
+            const u8 masks[16] = {15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15};
+            out->sampled_units = rsx_fp_texture_units(ucode,bytes);
+            out->gamma_units = rsx_fp_texture_gamma_units(ucode,bytes,masks);
+            out->expand_units = rsx_fp_texture_expand_units(ucode,bytes,masks);
+            out->bytes = bytes;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+int rsx_fp_metadata_matches(const rsx_fp_metadata* meta, const u8* ucode, u32 bytes)
+{
+    if (!meta || !ucode || !meta->bytes || meta->bytes != bytes) return 0;
+    for (u32 i = 0; i < meta->instructions; ++i)
+        if (memcmp(meta->code + i * 16u, ucode + meta->instruction_offsets[i], 16)) return 0;
+    return 1;
+}
+
+int rsx_fp_metadata_copy(rsx_fp_metadata* dst, const rsx_fp_metadata* src)
+{
+    if (!dst || !src || !src->bytes || src->bytes>sizeof(src->code) ||
+        !src->instructions || src->instructions>4096 ||
+        src->constants>RSX_FP_MAX_INLINE_CONSTANTS) return 0;
+    if (dst==src) return 1;
+    dst->bytes=src->bytes;
+    dst->instructions=src->instructions;
+    dst->constants=src->constants;
+    dst->sampled_units=src->sampled_units;
+    dst->gamma_units=src->gamma_units;
+    dst->expand_units=src->expand_units;
+    memcpy(dst->instruction_offsets,src->instruction_offsets,src->instructions*sizeof(u32));
+    memcpy(dst->constant_offsets,src->constant_offsets,src->constants*sizeof(u32));
+    memcpy(dst->code,src->code,src->instructions*16u);
+    dst->last_seed=src->hash_valid ? src->last_seed : 0;
+    dst->last_hash=src->hash_valid ? src->last_hash : 0;
+    dst->hash_valid=src->hash_valid;
+    return 1;
+}
+
+u64 rsx_fp_metadata_hash(rsx_fp_metadata* meta, const u8* ucode, u64 seed)
+{
+    if (!meta->hash_valid || meta->last_seed != seed) {
+        meta->last_hash = rsx_fp_structural_hash(ucode,meta->bytes,seed);
+        meta->last_seed = seed;
+        meta->hash_valid = 1;
