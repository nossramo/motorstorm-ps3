@@ -0,0 +1,213 @@
+/* Exercise the recorded backend draw on a real device, including reset. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+float cellAvconfExt_display_gamma(void) { return 1; }
+static id<MTLTexture> test_depth;
+static void test_rg16_sample_order(void) {
+    /* Stored halves +0.25, -0.5 must sample as (-0.5,+0.25,-0.5,+0.25).
+     * Exercise both guest uploads and the production colour-alias view. */
+    const u8 rgba[4]={0x00,0xb8,0x00,0x34};
+    const u16 halves[2]={0x3400,0xb800};
+    u32 source=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,1,1,rgba,4);
+    u32 snapshot=eng_color_rg16_snapshot(NULL,source,1,1);assert(snapshot);
+    NSError* error=nil;
+    NSString* code=@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "kernel void probe(texture2d<float> t [[texture(0)]], device float4* out [[buffer(0)]]) {"
+        "constexpr sampler s(coord::normalized,filter::nearest);out[0]=t.sample(s,float2(0.5));}";
+    id<MTLLibrary> lib=[s_dev newLibraryWithSource:code options:nil error:&error];assert(lib);
+    id<MTLComputePipelineState> pso=[s_dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"probe"] error:&error];assert(pso);
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];eng_encode_records(cb,nil);
+    [cb commit];[cb waitUntilCompleted];assert(!cb.error);s_eng_rec_count=0;
+    u32 views[2]={0};
+    for(unsigned override=0;override<2;++override) {
+        u32 remap=0xAAE4u|(override<<16);
+        views[override]=eng_surface_view(NULL,snapshot,remap,0xBFu);assert(views[override]);
+        u32 uploaded=eng_texture_create(NULL,RSX_BE_FMT_R16G16F,1,1,1,1,remap,0xBFu);assert(uploaded);
+        eng_texture_upload(NULL,uploaded,0,0,1,1,halves,4,1);
+        for(unsigned route=0;route<2;++route) {
+            id<MTLBuffer> rb=[s_dev newBufferWithLength:16 options:MTLResourceStorageModeShared];
+            cb=[s_queue commandBuffer];id<MTLComputeCommandEncoder> e=[cb computeCommandEncoder];
+            [e setComputePipelineState:pso];[e setTexture:eng_obj(route?uploaded:views[override]) atIndex:0];
+            [e setBuffer:rb offset:0 atIndex:0];[e dispatchThreads:MTLSizeMake(1,1,1) threadsPerThreadgroup:MTLSizeMake(1,1,1)];
+            [e endEncoding];[cb commit];[cb waitUntilCompleted];assert(!cb.error);
+            const float* got=rb.contents;
+            assert(got[0]==-0.5f && got[1]==(override?-0.5f:0.25f) && got[2]==-0.5f && got[3]==0.25f);
+        }
+        eng_obj_release(NULL,uploaded);
+    }
+    assert(views[0]!=views[1]);
+    eng_obj_release(NULL,views[0]);eng_obj_release(NULL,views[1]);
+    eng_obj_release(NULL,snapshot);eng_obj_release(NULL,source);
+    puts("Metal RG16F sampling: PASS (RPCS3 channel order, override, GPU alias and CPU upload)");
+}
+static void test_color_rg16(void) {
+    /* Exercise production queue ordering and compare raw output bits against
+     * the CPU upload path, including all half bit patterns, odd crop widths,
+     * NaNs and subnormals. Two snapshots separated by a clear must differ. */
+    const unsigned w=1024,h=257,n=w*h;
+    unsigned char* rgba=malloc(n*4),*guest=malloc(n*4),*expected=malloc(n*4),*actual=malloc(n*4);
+    assert(rgba&&guest&&expected&&actual);
+    for(unsigned i=0;i<n;i++) {
+        unsigned x=i&65535u,y=(i*40503u+719u)&65535u;
+        rgba[4*i]=x&255;rgba[4*i+1]=y>>8;rgba[4*i+2]=y&255;rgba[4*i+3]=x>>8;
+        guest[4*i]=rgba[4*i+3];guest[4*i+1]=rgba[4*i];
+        guest[4*i+2]=rgba[4*i+1];guest[4*i+3]=rgba[4*i+2];
+    }
+    NSError* error=nil;
+    s_eng_helper_lib=[s_dev newLibraryWithSource:kEngHelperMSL options:nil error:&error];assert(s_eng_helper_lib);
+    u32 source=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,w,h,rgba,w*4);assert(source);
+    assert(!eng_color_rg16_snapshot(NULL,source,w+1,h));
+    u32 out=eng_color_rg16_snapshot(NULL,source,w,h);assert(out);
+    u32 cropped=eng_color_rg16_snapshot(NULL,source,1021,253);assert(cropped);
+    EngRecord* clear=&s_eng_rec[s_eng_rec_count++];memset(clear,0,sizeof *clear);
+    clear->kind=ENG_REC_CLEAR_COLOR;clear->rt[0]=source;
+    clear->clear_rgba[0]=1;clear->clear_rgba[3]=1;
+    u32 after=eng_color_rg16_snapshot(NULL,source,w,h);assert(after);
+    id<MTLBuffer> rb=[s_dev newBufferWithLength:n*4 options:MTLResourceStorageModeShared];assert(rb);
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];eng_encode_records(cb,nil);
+    id<MTLBlitCommandEncoder> blit=[cb blitCommandEncoder];
+    [blit copyFromTexture:eng_obj(out) sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+        sourceSize:MTLSizeMake(w,h,1) toBuffer:rb destinationOffset:0 destinationBytesPerRow:w*4 destinationBytesPerImage:n*4];
+    [blit endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+    rsx_tex_layout layout;rsx_texture_layout_pitched(0xBF,w,h,w*4,&layout);
+    rsx_texture_decode(expected,w*4,guest,w,h,&layout,0);
+    assert(!memcmp(expected,rb.contents,n*4));
+    memcpy(actual,rb.contents,n*4);
+    for(unsigned which=0;which<2;which++) {
+        unsigned cw=which?w:1021,ch=which?h:253;
+        cb=[s_queue commandBuffer];blit=[cb blitCommandEncoder];
+        [blit copyFromTexture:eng_obj(which?after:cropped) sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+            sourceSize:MTLSizeMake(cw,ch,1) toBuffer:rb destinationOffset:0 destinationBytesPerRow:w*4 destinationBytesPerImage:n*4];
+        [blit endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+        for(unsigned row=0;row<ch;row++)for(unsigned col=0;col<cw;col++) {
+            unsigned i=row*w+col;const unsigned char* pixel=(const unsigned char*)rb.contents+4*i;
+            if(!which) assert(!memcmp(pixel,expected+4*i,4));
+            else assert(pixel[0]==255&&pixel[1]==255&&pixel[2]==0&&pixel[3]==0);
+        }
+    }
+    s_eng_rec_count=0;
+    eng_obj_release(NULL,out);eng_obj_release(NULL,cropped);eng_obj_release(NULL,after);eng_obj_release(NULL,source);
+    free(rgba);free(guest);free(expected);free(actual);
+    puts("Metal RGBA8 to RG16F: PASS (all 65,536 half bit patterns, crop and ordered snapshots)");
+}
+static void test_packed_range(void) {
+    /* Every representable depth in [0.5,1), where Z24 half-way rounding is
+     * most exposed, plus low/endpoint values in the last scanline. This uses
+     * real depth storage and the production fragment helper, not a CPU model. */
+    const unsigned w=4096,h=2048,n=w*h;
+    id<MTLBuffer> source=[s_dev newBufferWithLength:n*4 options:MTLResourceStorageModeShared];
+    uint32_t* bits=source.contents;
+    for(unsigned i=0;i<n;i++) bits[i]=0x3f000000u+i;
+    for(unsigned i=0;i<w;i++) bits[n-w+i]=(uint32_t)(((uint64_t)i*0x3f800000u)/(w-1));
+    MTLTextureDescriptor* td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float width:w height:h mipmapped:NO];
+    td.storageMode=MTLStorageModePrivate;td.usage=MTLTextureUsageShaderRead;
+    id<MTLTexture> depth=[s_dev newTextureWithDescriptor:td];assert(depth);
+    td.pixelFormat=MTLPixelFormatRGBA8Unorm;td.storageMode=MTLStorageModeShared;td.usage=MTLTextureUsageRenderTarget;
+    id<MTLTexture> out=[s_dev newTextureWithDescriptor:td];assert(out);
+    NSError* err=nil;
+    id<MTLLibrary> lib=[s_dev newLibraryWithSource:kEngHelperMSL options:nil error:&err];assert(lib);
+    MTLRenderPipelineDescriptor* pd=[MTLRenderPipelineDescriptor new];
+    pd.vertexFunction=[lib newFunctionWithName:@"eng_fullscreen_vs"];
+    pd.fragmentFunction=[lib newFunctionWithName:@"eng_depth_packed_fs"];
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatRGBA8Unorm;
+    id<MTLRenderPipelineState> pipe=[s_dev newRenderPipelineStateWithDescriptor:pd error:&err];assert(pipe);
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    id<MTLBlitCommandEncoder> blit=[cb blitCommandEncoder];
+    [blit copyFromBuffer:source sourceOffset:0 sourceBytesPerRow:w*4 sourceBytesPerImage:n*4 sourceSize:MTLSizeMake(w,h,1) toTexture:depth destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+    [blit endEncoding];
+    MTLRenderPassDescriptor* rp=[MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture=out;rp.colorAttachments[0].loadAction=MTLLoadActionDontCare;rp.colorAttachments[0].storeAction=MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> e=[cb renderCommandEncoderWithDescriptor:rp];
+    [e setRenderPipelineState:pipe];[e setFragmentTexture:depth atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+    unsigned char* rgba=malloc(n*4);assert(rgba);
+    [out getBytes:rgba bytesPerRow:w*4 fromRegion:MTLRegionMake2D(0,0,w,h) mipmapLevel:0];
+    for(unsigned i=0;i<n;i++) {
+        float d;memcpy(&d,bits+i,4);unsigned v=(unsigned)((double)d*16777215.0+0.5);
+        if(rgba[4*i]!=((v>>8)&255) || rgba[4*i+1]!=(v&255) || rgba[4*i+2]!=0 || rgba[4*i+3]!=(v>>16)) {
+            fprintf(stderr,"packed depth mismatch at %u, depth bits %08x, value %06x\n",i,bits[i],v);abort();
+        }
+    }
+    free(rgba);puts("Metal packed depth range: PASS (8,388,608 CPU/GPU comparisons)");
+}
+static float render(float slope) {
+    MTLTextureDescriptor* td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float width:16 height:16 mipmapped:NO];
+    td.storageMode=MTLStorageModePrivate;td.usage=MTLTextureUsageRenderTarget|MTLTextureUsageShaderRead;
+    id<MTLTexture> depth=[s_dev newTextureWithDescriptor:td];assert(depth);test_depth=depth;
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    MTLRenderPassDescriptor* rp=[MTLRenderPassDescriptor renderPassDescriptor];
+    rp.depthAttachment.texture=depth;rp.depthAttachment.loadAction=MTLLoadActionClear;
+    rp.depthAttachment.storeAction=MTLStoreActionStore;rp.depthAttachment.clearDepth=1;
+    id<MTLRenderCommandEncoder> enc=[cb renderCommandEncoderWithDescriptor:rp];assert(enc);
+    eng_set_depth_bias(NULL,0,slope);
+    EngRecord r=s_eng_pending;r.pipeline=1;r.topology=MTLPrimitiveTypeTriangle;r.vertex_count=3;
+    r.vp[2]=r.vp[3]=16;r.sc[2]=r.sc[3]=16;
+    for(unsigned i=0;i<RSX_BE_MAX_TEXTURES;i++)r.samp[i]=-1;
+    for(unsigned i=0;i<RSX_BE_MAX_VERTEX_TEXTURES;i++)r.vsamp[i]=-1;
+    eng_encode_draw(enc,&r,nil);[enc endEncoding];
+    id<MTLBuffer> out=[s_dev newBufferWithLength:4096 options:MTLResourceStorageModeShared];
+    id<MTLBlitCommandEncoder> blit=[cb blitCommandEncoder];
+    [blit copyFromTexture:depth sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(16,16,1) toBuffer:out destinationOffset:0 destinationBytesPerRow:256 destinationBytesPerImage:4096];
+    [blit endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+    float value;memcpy(&value,(char*)out.contents+8*256+8*4,4);return value;
+}
+static void test_crop(void) {
+    NSError* err=nil;
+    id<MTLLibrary> lib=[s_dev newLibraryWithSource:kEngHelperMSL options:nil error:&err];
+    if (!lib) fprintf(stderr,"%s\n",err.localizedDescription.UTF8String);
+    assert(lib);
+    MTLRenderPipelineDescriptor* pd=[MTLRenderPipelineDescriptor new];
+    pd.vertexFunction=[lib newFunctionWithName:@"eng_fullscreen_vs"];
+    pd.fragmentFunction=[lib newFunctionWithName:@"eng_depth_fs"];
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatR32Float;
+    id<MTLRenderPipelineState> pipe=[s_dev newRenderPipelineStateWithDescriptor:pd error:&err];assert(pipe);
+    MTLTextureDescriptor* td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR32Float width:8 height:16 mipmapped:NO];
+    td.usage=MTLTextureUsageRenderTarget; td.storageMode=MTLStorageModeShared;
+    id<MTLTexture> out=[s_dev newTextureWithDescriptor:td];assert(out);
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    MTLRenderPassDescriptor* rp=[MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture=out;rp.colorAttachments[0].loadAction=MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction=MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> e=[cb renderCommandEncoderWithDescriptor:rp];
+    [e setRenderPipelineState:pipe];[e setFragmentTexture:test_depth atIndex:0];
+    MTLSamplerDescriptor* sd=[MTLSamplerDescriptor new];
+    [e setFragmentSamplerState:[s_dev newSamplerStateWithDescriptor:sd] atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+    float pixels[128];[out getBytes:pixels bytesPerRow:32 fromRegion:MTLRegionMake2D(0,0,8,16) mipmapLevel:0];
+    assert(fabsf(pixels[8*8+4]-0.25625f)<0.00001f);
+    pd.fragmentFunction=[lib newFunctionWithName:@"eng_depth_packed_fs"];
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatRGBA8Unorm;
+    pipe=[s_dev newRenderPipelineStateWithDescriptor:pd error:&err];assert(pipe);
+    td.pixelFormat=MTLPixelFormatRGBA8Unorm;
+    out=[s_dev newTextureWithDescriptor:td];assert(out);
+    cb=[s_queue commandBuffer];rp.colorAttachments[0].texture=out;
+    e=[cb renderCommandEncoderWithDescriptor:rp];[e setRenderPipelineState:pipe];
+    [e setFragmentTexture:test_depth atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+    unsigned char rgba[512];[out getBytes:rgba bytesPerRow:32 fromRegion:MTLRegionMake2D(0,0,8,16) mipmapLevel:0];
+    for (int i=0;i<128;i++) {
+        unsigned v=(unsigned)((double)pixels[i]*16777215.0+0.5);
+        assert(rgba[4*i]==((v>>8)&255) && rgba[4*i+1]==(v&255) && rgba[4*i+2]==0 && rgba[4*i+3]==(v>>16));
+    }
+    puts("Metal packed depth: PASS (128 pixels exactly match CPU quantization/channels)");
+    printf("Metal cropped depth: PASS (%g, expected 0.25625)\n",pixels[8*8+4]);
+}
+int main(void) { @autoreleasepool {
+    s_dev=MTLCreateSystemDefaultDevice();assert(s_dev);s_queue=[s_dev newCommandQueue];
+    NSError* error=nil;
+    id<MTLLibrary> lib=[s_dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal; vertex float4 vs(uint i [[vertex_id]]) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)};return float4(p[i],0.3+0.1*p[i].x,1); }" options:nil error:&error];assert(lib);
+    MTLRenderPipelineDescriptor* pd=[MTLRenderPipelineDescriptor new];pd.vertexFunction=[lib newFunctionWithName:@"vs"];pd.depthAttachmentPixelFormat=MTLPixelFormatDepth32Float;
+    s_eng_pipe[0].pso=[s_dev newRenderPipelineStateWithDescriptor:pd error:&error];assert(s_eng_pipe[0].pso);
+    MTLDepthStencilDescriptor* ds=[MTLDepthStencilDescriptor new];ds.depthCompareFunction=MTLCompareFunctionAlways;ds.depthWriteEnabled=YES;
+    s_eng_pipe[0].ds=[s_dev newDepthStencilStateWithDescriptor:ds];s_eng_pipe_count=1;
+    float before=render(0),biased=render(2),reset=render(0);
+    assert(biased>before+0.01f && fabsf(reset-before)<0.000001f);
+    test_crop();
+    test_packed_range();
+    test_color_rg16();
+    test_rg16_sample_order();
+    printf("Metal depth slope and reset: PASS (%g -> %g -> %g)\n",before,biased,reset);
+} }
diff --git a/libs/video/tests/test_metal_fp_alias.m b/libs/video/tests/test_metal_fp_alias.m
new file mode 100644
index 0000000..becfb01
--- /dev/null
+++ b/libs/video/tests/test_metal_fp_alias.m
@@ -0,0 +1,55 @@
+/* Execute synthetic NV40 programs through the production decompiler and Metal.
+ * Numeric checks catch stale registers, lane order and masked/predicated writes. */
+#import <Metal/Metal.h>
+#include "rsx_fp_decompiler.h"
+#include "rsx_shader_msl.h"
+#include "rsx_test_programs.h"
+#include <math.h>
+#include <string.h>
+static u8 program[512]; static u32 size;
+static void ins(u32 op,u32 reg,int half,u32 mask,u32 source,int end) {
+    rsx_test_fp_instr(program+size,(op<<24)|(reg<<1)|(half?128:0)|(mask<<9)|end,source);
+    size+=16;
+}
+static void constant(u32 reg,int half,u32 mask,float x,float y,float z,float w) {
+    ins(1,reg,half,mask,2|RSX_TEST_FP_SWZ_IDENT,0);
+    float values[]={x,y,z,w};
+    for(int i=0;i<4;i++){u32 bits;memcpy(&bits,&values[i],4);rsx_test_fp_put_word(program+size+4*i,bits);}size+=16;
+}
+static u32 src(u32 reg,int half){return (reg<<2)|(half?256:0)|RSX_TEST_FP_SWZ_IDENT;}
+static int run(id<MTLDevice> dev, const char* name,u32 control,const float expected[4]) {
+    char hlsl[65536],msl[65536],log[4096];
+    if(rsx_fp_decompile(program,size,control,hlsl,sizeof hlsl)<0 ||
+       rsx_hlsl_to_msl(hlsl,1,msl,sizeof msl,log,sizeof log)) {fprintf(stderr,"FAIL %s translation %s\n",name,log);return 1;}
+    NSError* err=nil;MTLCompileOptions* options=[MTLCompileOptions new];options.fastMathEnabled=NO;
+    id<MTLLibrary> lib=[dev newLibraryWithSource:[NSString stringWithUTF8String:msl] options:options error:&err];
+    id<MTLLibrary> vl=[dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal; vertex float4 v(uint i [[vertex_id]]) { return float4(i==1?3.0:-1.0,i==2?3.0:-1.0,0,1); }" options:options error:&err];
+    MTLRenderPipelineDescriptor* pd=[MTLRenderPipelineDescriptor new];pd.vertexFunction=[vl newFunctionWithName:@"v"];pd.fragmentFunction=[lib newFunctionWithName:@"main0"];
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatRGBA32Float;
+    id<MTLRenderPipelineState> ps=[dev newRenderPipelineStateWithDescriptor:pd error:&err];
+    if(!ps){fprintf(stderr,"FAIL %s Metal: %s\n",name,err.description.UTF8String);return 1;}
+    MTLTextureDescriptor* td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float width:1 height:1 mipmapped:NO];td.usage=MTLTextureUsageRenderTarget;td.storageMode=MTLStorageModeShared;
+    id<MTLTexture> tex=[dev newTextureWithDescriptor:td];MTLRenderPassDescriptor* pass=[MTLRenderPassDescriptor renderPassDescriptor];pass.colorAttachments[0].texture=tex;pass.colorAttachments[0].loadAction=MTLLoadActionClear;pass.colorAttachments[0].storeAction=MTLStoreActionStore;
+    id<MTLCommandQueue> q=[dev newCommandQueue];id<MTLCommandBuffer> cb=[q commandBuffer];id<MTLRenderCommandEncoder> enc=[cb renderCommandEncoderWithDescriptor:pass];[enc setRenderPipelineState:ps];[enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];[enc endEncoding];[cb commit];[cb waitUntilCompleted];
+    float actual[4];[tex getBytes:actual bytesPerRow:16 fromRegion:MTLRegionMake2D(0,0,1,1) mipmapLevel:0];
+    int bad=cb.status!=MTLCommandBufferStatusCompleted;
+    for(int i=0;i<4;i++)if(!isfinite(actual[i])||fabsf(actual[i]-expected[i])>1e-6f)bad=1;
+    printf("%s %s: %.9g %.9g %.9g %.9g\n",bad?"FAIL":"PASS",name,actual[0],actual[1],actual[2],actual[3]);return bad;
+}
+int main(void){@autoreleasepool{
+    id<MTLDevice> dev=MTLCreateSystemDefaultDevice();if(!dev)return 2;int bad=0;
+    /* MotorStorm: write H0.xy velocity; UP4UB reads the same bits via R0.x. */
+    size=0;constant(0,1,3,0.5f,-0.25f,0,0);ins(0x28,0,1,15,src(0,0),1);
+    bad+=run(dev,"velocity packed alias",0,(float[]){0,56.f/255,0,180.f/255});
+    /* Full -> half, odd register and upper two full lanes. */
+    size=0;constant(10,0,15,1,1,1,1);ins(1,0,1,15,src(21,1),1);
+    bad+=run(dev,"full to odd half",0,(float[]){0,1.875f,0,1.875f});
+    /* Partial H20.y write preserves R10.x's low half exactly. */
+    size=0;constant(10,0,15,1,1,1,1);constant(20,1,2,0,0.5f,0,0);ins(0x28,0,1,15,src(10,0),1);
+    bad+=run(dev,"masked half write",0,(float[]){0,0,0,56.f/255});
+    /* A false predicate must not replace either view. CC starts at zero. */
+    size=0;constant(10,0,15,1,1,1,1);u32 at=size;constant(20,1,2,0,0.5f,0,0);
+    u32 w=rsx_fp_read_word(program+at+4);w=(w&~(7u<<18))|(1u<<20);rsx_test_fp_put_word(program+at+4,w);
+    ins(1,0,1,15,src(20,1),1);bad+=run(dev,"false predicate preserves aliases",0,(float[]){0,1.875f,0,1.875f});
+    return bad?1:0;
+}}
diff --git a/libs/video/tests/test_metal_guest_sampler.m b/libs/video/tests/test_metal_guest_sampler.m
new file mode 100644
index 0000000..2285053
--- /dev/null
+++ b/libs/video/tests/test_metal_guest_sampler.m
@@ -0,0 +1,120 @@
+/* Compare the production cached sampler to an independently constructed Metal
+ * sampler on a mip-coloured texture with an elongated sample footprint. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+float cellAvconfExt_display_gamma(void) { return 1; }
+int cellGcmOffsetIsDisplay(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveOffset(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveLocated(int loc,u32 off) { (void)loc;(void)off;assert(0);return 0; }
+void rsx_fetch_attrib(const rsx_state* st,int idx,u32 vi,float out[4]) { (void)st;(void)idx;(void)vi;(void)out;assert(0); }
+int main(void) { @autoreleasepool {
+    setenv("RSX_GUEST_ANISOTROPY","1",1); setenv("PS3_ANISO","0",1);
+    setenv("RSX_GUEST_LOD_BIAS","1",1);
+    s_dev=MTLCreateSystemDefaultDevice(); assert(s_dev); s_queue=[s_dev newCommandQueue];
+    rsx_be_sampler_desc desc={.min_linear=1,.mag_linear=1,.mip_present=1,
+        .wrap_s=1,.wrap_t=1,.wrap_r=1,.max_anisotropy=2,.min_lod=0,.max_lod=8};
+    const int two=eng_sampler_slot(&desc); assert(two>=0);
+    desc.max_anisotropy=1; const int one=eng_sampler_slot(&desc); assert(one>=0 && one!=two);
+    desc.max_anisotropy=2; assert(eng_sampler_slot(&desc)==two);
+    desc.max_anisotropy=0; assert(eng_sampler_slot(&desc)==one);
+    desc.min_linear=0; desc.max_anisotropy=2; const int nearest=eng_sampler_slot(&desc);
+    desc.max_anisotropy=1; assert(eng_sampler_slot(&desc)==nearest);
+    desc.min_linear=1; desc.mip_present=0; desc.max_anisotropy=2;
+    const int unmipped=eng_sampler_slot(&desc);
+    desc.max_anisotropy=1; assert(eng_sampler_slot(&desc)==unmipped);
+
+    MTLSamplerDescriptor* expected=[MTLSamplerDescriptor new];
+    expected.minFilter=MTLSamplerMinMagFilterLinear; expected.magFilter=MTLSamplerMinMagFilterLinear;
+    expected.mipFilter=MTLSamplerMipFilterNearest; expected.maxAnisotropy=2;
+    expected.lodMinClamp=0; expected.lodMaxClamp=8;
+    expected.sAddressMode=expected.tAddressMode=expected.rAddressMode=MTLSamplerAddressModeRepeat;
+    id<MTLSamplerState> reference=[s_dev newSamplerStateWithDescriptor:expected]; assert(reference);
+    MTLTextureDescriptor* td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR32Float
+        width:256 height:256 mipmapped:YES]; td.storageMode=MTLStorageModeShared;
+    id<MTLTexture> texture=[s_dev newTextureWithDescriptor:td]; assert(texture);
+    float* level=malloc(256*256*sizeof(float)); assert(level);
+    for (u32 mip=0; mip<9; ++mip) {
+        u32 side=256>>mip;
+        for (u32 i=0;i<side*side;++i) level[i]=(float)mip/8.f;
+        [texture replaceRegion:MTLRegionMake2D(0,0,side,side) mipmapLevel:mip withBytes:level bytesPerRow:side*sizeof(float)];
+    }
+    free(level);
+    NSString* source=@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "kernel void check(texture2d<float> t [[texture(0)]], sampler s [[sampler(0)]], "
+        "device float* out [[buffer(0)]], uint i [[thread_position_in_grid]]) { "
+        "out[i]=t.sample(s,float2(0.37,0.43),gradient2d(float2((8.+float(i)/32.)/256.,0),float2(0,1./256.))).r; }\n"
+        "kernel void check_lod(texture2d<float> t [[texture(0)]], sampler s [[sampler(0)]], "
+        "device float* out [[buffer(0)]], uint i [[thread_position_in_grid]]) { "
+        "out[i]=t.sample(s,float2(0.37,0.43),gradient2d(float2(8./256.,0),float2(0,8./256.))).r; "
+        "out[i+256]=t.sample(s,float2(0.37,0.43),level(3.)).r; }";
+    NSError* error=nil;
+    id<MTLLibrary> library=[s_dev newLibraryWithSource:source options:nil error:&error];
+    if (!library) { fprintf(stderr,"%s\n",error.localizedDescription.UTF8String); return 1; }
+    id<MTLComputePipelineState> pipeline=[s_dev newComputePipelineStateWithFunction:[library newFunctionWithName:@"check"] error:&error]; assert(pipeline);
+    id<MTLBuffer> output=[s_dev newBufferWithLength:3*256*sizeof(float) options:MTLResourceStorageModeShared];
+    id<MTLSamplerState> samplers[3]={s_eng_samp[two].samp,reference,s_eng_samp[one].samp};
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer]; id<MTLComputeCommandEncoder> enc=[cb computeCommandEncoder];
+    [enc setComputePipelineState:pipeline]; [enc setTexture:texture atIndex:0];
+    for (u32 i=0;i<3;++i) {
+        [enc setSamplerState:samplers[i] atIndex:0]; [enc setBuffer:output offset:i*256*sizeof(float) atIndex:0];
+        [enc dispatchThreadgroups:MTLSizeMake(4,1,1) threadsPerThreadgroup:MTLSizeMake(64,1,1)];
+    }
+    [enc endEncoding]; [cb commit]; [cb waitUntilCompleted]; assert(cb.status==MTLCommandBufferStatusCompleted);
+    const float* result=output.contents;
+    assert(!memcmp(result,result+256,256*sizeof(float)));
+    u32 changed=0; for (u32 i=0;i<256;++i) changed+=result[i]!=result[i+512];
+    assert(changed>0);
+    printf("PASS: 256 GPU samples match explicit Metal 2x sampler; %u differ from 1x; cache reuse/reset and point/unmipped gating pass\n",changed);
+#if __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000 || __IPHONE_OS_VERSION_MAX_ALLOWED >= 260000
+    if (@available(macOS 26.0, iOS 26.0, *)) {
+        pipeline=[s_dev newComputePipelineStateWithFunction:[library newFunctionWithName:@"check_lod"] error:&error];
+        assert(pipeline);
+        output=[s_dev newBufferWithLength:2*512*sizeof(float) options:MTLResourceStorageModeShared];
+        desc=(rsx_be_sampler_desc){.min_linear=1,.mag_linear=1,.mip_present=1,.mip_linear=1,
+            .wrap_s=1,.wrap_t=1,.wrap_r=1,.max_anisotropy=1,.max_lod=8};
+        expected.mipFilter=MTLSamplerMipFilterLinear; expected.maxAnisotropy=1;
+        const int zero=eng_sampler_slot(&desc);
+        const float biases[]={-16,-2,-.796875f,-1.f/256,0,1.f/256,1,4095.f/256};
+        for (u32 b=0;b<sizeof biases/sizeof biases[0];++b) {
+            desc.lod_bias=biases[b];
+            const int slot=eng_sampler_slot(&desc); assert(slot>=0);
+            assert((slot==zero)==(biases[b]==0));
+            assert(eng_sampler_slot(&desc)==slot);
+            expected.lodBias=biases[b];
+            reference=[s_dev newSamplerStateWithDescriptor:expected]; assert(reference);
+            id<MTLSamplerState> pair[2]={s_eng_samp[slot].samp,reference};
+            cb=[s_queue commandBuffer]; enc=[cb computeCommandEncoder];
+            [enc setComputePipelineState:pipeline]; [enc setTexture:texture atIndex:0];
+            for (u32 i=0;i<2;++i) {
+                [enc setSamplerState:pair[i] atIndex:0];
+                [enc setBuffer:output offset:i*512*sizeof(float) atIndex:0];
+                [enc dispatchThreadgroups:MTLSizeMake(4,1,1) threadsPerThreadgroup:MTLSizeMake(64,1,1)];
+            }
+            [enc endEncoding]; [cb commit]; [cb waitUntilCompleted];
+            assert(cb.status==MTLCommandBufferStatusCompleted);
+            result=output.contents;
+            assert(!memcmp(result,result+512,512*sizeof(float)));
+            /* Mip-coloured texture gives an independent result, allowing the
+             * documented Metal S4.6 rounding of the guest S4.8 bias. The
+             * Vulkan LOD operation used by RPCS3 adds sampler bias to both
+             * derivative-derived and explicit Lod operands. Metal agrees. */
+            float wanted=fminf(8,fmaxf(0,3+biases[b]))/8;
+            for (u32 i=0;i<256;++i) {
+                assert(fabsf(result[i]-wanted)<=1.f/256);
+                assert(fabsf(result[i+256]-wanted)<=1.f/256);
+            }
+        }
+        desc.lod_bias=0; assert(eng_sampler_slot(&desc)==zero);
+        desc.min_lod=1; const int clamped=eng_sampler_slot(&desc); assert(clamped!=zero);
+        desc.max_lod=7; assert(eng_sampler_slot(&desc)!=clamped);
+        desc.mip_present=0; desc.lod_bias=0; const int no_bias=eng_sampler_slot(&desc);
+        desc.lod_bias=-2; assert(eng_sampler_slot(&desc)==no_bias);
+        puts("PASS: 4096 GPU LOD samples match explicit Metal bias; signed bounds, cache identity/reset, LOD clamps, unmipped and explicit-level sampling pass");
+    } else {
+        puts("SKIP: sampler LOD bias requires macOS/iOS 26");
+    }
+#endif
+    eng_shutdown(NULL);
+    return 0;
+} }
diff --git a/libs/video/tests/test_metal_msaa_engine.m b/libs/video/tests/test_metal_msaa_engine.m
new file mode 100644
index 0000000..b70df6e
--- /dev/null
+++ b/libs/video/tests/test_metal_msaa_engine.m
@@ -0,0 +1,130 @@
+/* Production pipeline, command recording, snapshots and MSAA pass transitions. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+float cellAvconfExt_display_gamma(void) { return 1; }
+int cellGcmOffsetIsDisplay(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveOffset(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveLocated(int loc,u32 off) { (void)loc;(void)off;assert(0);return 0; }
+void rsx_fetch_attrib(const rsx_state* s,int i,u32 v,float o[4])
+{ (void)s;(void)i;(void)v;(void)o;assert(0); }
+
+static void read_colour(u32 handle, u8 out[16*8*4])
+{
+    id<MTLTexture> t=eng_obj(handle); assert(t.width==16 && t.height==8);
+    id<MTLBuffer> buffer=[s_dev newBufferWithLength:256*8 options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    id<MTLBlitCommandEncoder> copy=[cb blitCommandEncoder];
+    [copy copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+              sourceSize:MTLSizeMake(16,8,1) toBuffer:buffer destinationOffset:0
+   destinationBytesPerRow:256 destinationBytesPerImage:256*8];
+    [copy endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    assert(cb.status==MTLCommandBufferStatusCompleted);
+    for(unsigned y=0;y<8;++y) memcpy(out+y*64,(u8*)buffer.contents+y*256,64);
+}
+
+static u32 pipeline(unsigned colour, int write_depth)
+{
+    const char* vs="float4 main(float4 p : ATTR0) : SV_Position { return p; }";
+    const char* fs[]={
+        "float4 main() : SV_Target0 { return float4(1,0,0,1); }",
+        "float4 main() : SV_Target0 { return float4(0,1,0,1); }",
+        "float4 main() : SV_Target0 { return float4(0,0,1,1); }"
+    };
+    rsx_be_render_state state={0};
+    state.color_mask=0x01010101;
+    state.depth_test=state.depth_write=write_depth;
+    state.depth_func=0x201; /* LESS */
+    state.stencil_enable=write_depth;
+    state.s_func=0x207; state.s_func_mask=state.s_write_mask=255;
+    state.s_fail=state.s_zfail=0x1E00; state.s_zpass=0x1E01; /* KEEP / REPLACE */
+    rsx_vertex_layout_plan layout={0}; layout.count=1;
+    u32 p=eng_pipeline_create(NULL,vs,fs[colour],&state,&layout,16,RSX_BE_FMT_R8G8B8A8,1);
+    assert(p && s_eng_pipe[p-1].pso && s_eng_pipe[p-1].pso_2x);
+    return p;
+}
+
+static void draw(u32 p, u32 colour, u32 depth, int msaa, unsigned x, unsigned width, int full)
+{
+    const float triangle[3][4]={{-1,1,.25,1},{1,1,.25,1},{-1,-1,.25,1}};
+    const float fullscreen[3][4]={{-1,1,.25,1},{3,1,.25,1},{-1,-3,.25,1}};
+    eng_bind_targets(NULL,&colour,1,depth); eng_bind_pipeline(NULL,p);
+    eng_set_sample_layout(NULL,msaa ? 3 : 0,msaa ? 0xffff0001u : 0xffff0000u);
+    eng_set_viewport(NULL,0,0,16,8); eng_set_scissor(NULL,x,0,width,8);
+    eng_set_stencil_ref(NULL,msaa==2 ? 91 : 23);
+    eng_draw(NULL,RSX_TOPOLOGY_TRIANGLES,full ? fullscreen : triangle,3,16,NULL,0);
+}
+
+static void read_depth(u32 handle, float out[16*8*4])
+{
+    NSString* source=@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "vertex float4 full(uint i [[vertex_id]]) {return float4(i==1?3.:-1.,i==2?3.:-1.,0.,1.);}\n"
+        "fragment float4 inspect(float4 p [[position]], depth2d<float,access::read> z [[texture(0)]],"
+        "texture2d<uint,access::read> s [[texture(1)]]) {return float4(z.read(uint2(p.xy)),float(s.read(uint2(p.xy)).r),0,1);}";
+    NSError* err=nil;
+    id<MTLLibrary> lib=[s_dev newLibraryWithSource:source options:nil error:&err]; assert(lib);
+    MTLRenderPipelineDescriptor* pd=[MTLRenderPipelineDescriptor new];
+    pd.vertexFunction=[lib newFunctionWithName:@"full"];
+    pd.fragmentFunction=[lib newFunctionWithName:@"inspect"];
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatRGBA32Float;
+    id<MTLRenderPipelineState> pso=[s_dev newRenderPipelineStateWithDescriptor:pd error:&err]; assert(pso);
+    MTLTextureDescriptor* td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float
+        width:16 height:8 mipmapped:NO];
+    td.storageMode=MTLStorageModeShared; td.usage=MTLTextureUsageRenderTarget;
+    id<MTLTexture> result=[s_dev newTextureWithDescriptor:td];
+    id<MTLTexture> depth=eng_obj(handle);
+    MTLRenderPassDescriptor* pass=[MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture=result;
+    pass.colorAttachments[0].loadAction=MTLLoadActionDontCare;
+    pass.colorAttachments[0].storeAction=MTLStoreActionStore;
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    id<MTLRenderCommandEncoder> enc=[cb renderCommandEncoderWithDescriptor:pass];
+    [enc setRenderPipelineState:pso]; [enc setFragmentTexture:depth atIndex:0];
+    [enc setFragmentTexture:[depth newTextureViewWithPixelFormat:MTLPixelFormatX32_Stencil8] atIndex:1];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; [enc endEncoding];
+    [cb commit]; [cb waitUntilCompleted]; assert(cb.status==MTLCommandBufferStatusCompleted);
+    [result getBytes:out bytesPerRow:16*16 fromRegion:MTLRegionMake2D(0,0,16,8) mipmapLevel:0];
+}
+
+int main(void) { @autoreleasepool {
+    setenv("RSX_METAL_NATIVE_MSAA","1",1);
+    s_dev=MTLCreateSystemDefaultDevice(); assert(s_dev);
+    s_queue=[s_dev newCommandQueue]; s_guest_shaders=1;
+    assert(!create_placeholders() && !eng_init(NULL,16,8));
+    const u32 colour=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,16,8,NULL,0);
+    const u32 depth=eng_depth_target_create(NULL,16,8);
+    const u32 red=pipeline(0,1), green=pipeline(1,0), blue=pipeline(2,1);
+    const float black[4]={0,0,0,1};
+    eng_clear_color(NULL,colour,black);
+    eng_clear_depth_stencil(NULL,depth,RSX_BE_CLEAR_DEPTH|RSX_BE_CLEAR_STENCIL,1,17);
+    draw(red,colour,depth,1,0,16,0);
+    const u32 first=eng_color_snapshot(NULL,colour);
+    draw(green,colour,depth,0,12,4,1);
+    eng_clear_depth_stencil(NULL,depth,RSX_BE_CLEAR_DEPTH,.75,0);
+    draw(blue,colour,depth,2,4,4,0);
+    const u32 last=eng_color_snapshot(NULL,colour);
+    eng_submit_and_wait(NULL,0);
+    assert(s_eng_checked_completed && !s_eng_encoding_failed);
+    assert(s_eng_msaa_obj[colour-1] && s_eng_msaa_obj[depth-1]);
+    u8 original[16*8*4], final[16*8*4]; float ds[16*8*4];
+    read_colour(first,original); read_colour(last,final); read_depth(depth,ds);
+    for(unsigned y=0;y<8;++y) for(unsigned x=0;x<8;++x) for(unsigned s=0;s<2;++s) {
+        unsigned i=(y*16+x*2+s)*4;
+        int covered=x+y+(s==0 ? 1.5f : .5f)<8;
+        assert(original[i]==(covered ? 255 : 0) && original[i+1]==0 && original[i+2]==0);
+        int isblue=covered && x>=2 && x<4, isgreen=x>=6;
+        assert(final[i]==(covered && !isblue && !isgreen ? 255 : 0));
+        assert(final[i+1]==(isgreen ? 255 : 0) && final[i+2]==(isblue ? 255 : 0));
+        assert(ds[i]==(isblue ? .25f : .75f));
+        assert(ds[i+1]==(isblue ? 91 : covered ? 23 : 17));
+    }
+    /* Handle reuse cannot retain another surface's paired texture. */
+    eng_obj_release(NULL,colour);
+    const u32 reused=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,16,8,NULL,0);
+    assert(reused==colour && !s_eng_msaa_obj[reused-1]);
+    eng_set_sample_layout(NULL,4,0xffff0001);
+    assert(s_eng_encoding_failed); /* unsupported modes must be explicit */
+    eng_shutdown(NULL);
+    puts("PASS: production 2x/1x/2x transitions, diagonal coverage, scissor, immutable snapshots, partial depth clear, stencil preservation and handle reuse");
+    return 0;
+} }
diff --git a/libs/video/tests/test_metal_msaa_samples.m b/libs/video/tests/test_metal_msaa_samples.m
new file mode 100644
index 0000000..39b52ba
--- /dev/null
+++ b/libs/video/tests/test_metal_msaa_samples.m
@@ -0,0 +1,151 @@
+/* Actual GPU storage roundtrips and analytic edge coverage. */
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../rsx_metal_msaa.h"
+
+static id<MTLTexture> texture(id<MTLDevice> device, MTLPixelFormat format,
+                              NSUInteger width, NSUInteger height, NSUInteger samples)
+{
+    MTLTextureDescriptor* d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:
+        format width:width height:height mipmapped:NO];
+    d.sampleCount = samples;
+    d.textureType = samples == 2 ? MTLTextureType2DMultisample : MTLTextureType2D;
+    d.storageMode = samples == 2 || format == MTLPixelFormatDepth32Float_Stencil8
+        ? MTLStorageModePrivate : MTLStorageModeShared;
+    d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+    id<MTLTexture> t = [device newTextureWithDescriptor:d]; assert(t); return t;
+}
+static void complete(id<MTLCommandBuffer> command)
+{
+    [command commit]; [command waitUntilCompleted];
+    if (command.status != MTLCommandBufferStatusCompleted)
+        fprintf(stderr,"%s\n",command.error.localizedDescription.UTF8String);
+    assert(command.status == MTLCommandBufferStatusCompleted);
+}
+int main(void) { @autoreleasepool {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice(); assert(device);
+    id<MTLCommandQueue> queue = [device newCommandQueue]; assert(queue);
+    RSXMetalSampleTransfer* transfer = [[RSXMetalSampleTransfer alloc] initWithDevice:device];
+    assert(transfer);
+    enum { W=32,H=16,N=W*H*2 };
+    MTLSamplePosition positions[2]; [device getDefaultSamplePositions:positions count:2];
+    assert(positions[0].x==.75 && positions[0].y==.75);
+    assert(positions[1].x==.25 && positions[1].y==.25);
+    unsigned char values[N*4], result[N*4];
+    for (unsigned i=0;i<sizeof values;++i) values[i]=(unsigned char)(i*97+i/17);
+    id<MTLTexture> packed=texture(device,MTLPixelFormatRGBA8Unorm,W*2,H,1);
+    id<MTLTexture> multi=texture(device,MTLPixelFormatRGBA8Unorm,W,H,2);
+    id<MTLTexture> output=texture(device,MTLPixelFormatRGBA8Unorm,W*2,H,1);
+    [packed replaceRegion:MTLRegionMake2D(0,0,W*2,H) mipmapLevel:0
+                withBytes:values bytesPerRow:W*2*4];
+    id<MTLCommandBuffer> command=[queue commandBuffer];
+    for (int repeat=0;repeat<4;++repeat) {
+        assert([transfer encode:command from:repeat ? output : packed to:multi]);
+        assert([transfer encode:command from:multi to:output]);
+    }
+    complete(command);
+    [output getBytes:result bytesPerRow:W*2*4 fromRegion:MTLRegionMake2D(0,0,W*2,H) mipmapLevel:0];
+    assert(!memcmp(values,result,sizeof values));
+    assert(![transfer encode:[queue commandBuffer] from:multi to:multi]);
+
+    /* HDR surfaces carry finite signed values outside [0,1]. A normalized
+     * colour conversion or an averaged resolve would corrupt these samples. */
+    for (unsigned f=0;f<2;++f) {
+        MTLPixelFormat format=f ? MTLPixelFormatRGBA32Float : MTLPixelFormatRGBA16Float;
+        const unsigned bytes=f ? 16 : 8;
+        unsigned char input[N*16], back[N*16];
+        for (unsigned i=0;i<N*4;++i) {
+            float v=((int)(i%257)-128)*.0625f;
+            if (f) memcpy(input+i*4,&v,4);
+            else { _Float16 half=(_Float16)v; memcpy(input+i*2,&half,2); }
+        }
+        packed=texture(device,format,W*2,H,1);
+        multi=texture(device,format,W,H,2);
+        output=texture(device,format,W*2,H,1);
+        [packed replaceRegion:MTLRegionMake2D(0,0,W*2,H) mipmapLevel:0
+                    withBytes:input bytesPerRow:W*2*bytes];
+        command=[queue commandBuffer];
+        for (int repeat=0;repeat<4;++repeat) {
+            assert([transfer encode:command from:repeat ? output : packed to:multi]);
+            assert([transfer encode:command from:multi to:output]);
+        }
+        complete(command);
+        [output getBytes:back bytesPerRow:W*2*bytes
+             fromRegion:MTLRegionMake2D(0,0,W*2,H) mipmapLevel:0];
+        assert(!memcmp(input,back,N*bytes));
+    }
+
+    NSString* source=@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "vertex float4 full(uint i [[vertex_id]]) {return float4(i==1?3.:-1.,i==2?3.:-1.,0.,1.);}\n"
+        "vertex float4 tri(uint i [[vertex_id]]) {return float4(i==1?1.:-1.,i==2?-1.:1.,0.,1.);}\n"
+        "fragment float4 white() {return float4(1.);}\n"
+        "struct DS {float z [[depth(any)]]; uint s [[stencil]];};\n"
+        "fragment DS seed(float4 p [[position]]) {uint i=uint(p.x)+uint(p.y)*64;"
+        "return {float(i+1)/2048.,(i*53)&255};}\n"
+        "fragment float4 inspect(float4 p [[position]], depth2d<float,access::read> z [[texture(0)]],"
+        "texture2d<uint,access::read> s [[texture(1)]]) {return float4(z.read(uint2(p.xy)),float(s.read(uint2(p.xy)).r),0,1);}";
+    NSError* error=nil; id<MTLLibrary> lib=[device newLibraryWithSource:source options:nil error:&error];
+    if (!lib) fprintf(stderr,"%s\n",error.localizedDescription.UTF8String); assert(lib);
+    MTLRenderPipelineDescriptor* pd=[MTLRenderPipelineDescriptor new];
+    pd.vertexFunction=[lib newFunctionWithName:@"full"]; pd.fragmentFunction=[lib newFunctionWithName:@"seed"];
+    pd.depthAttachmentPixelFormat=pd.stencilAttachmentPixelFormat=MTLPixelFormatDepth32Float_Stencil8;
+    id<MTLRenderPipelineState> seed=[device newRenderPipelineStateWithDescriptor:pd error:&error]; assert(seed);
+    MTLDepthStencilDescriptor* dd=[MTLDepthStencilDescriptor new]; dd.depthCompareFunction=MTLCompareFunctionAlways; dd.depthWriteEnabled=YES;
+    MTLStencilDescriptor* sd=[MTLStencilDescriptor new]; sd.stencilCompareFunction=MTLCompareFunctionAlways;
+    sd.depthStencilPassOperation=MTLStencilOperationReplace; dd.frontFaceStencil=dd.backFaceStencil=sd;
+    id<MTLDepthStencilState> ds=[device newDepthStencilStateWithDescriptor:dd];
+    id<MTLTexture> z=texture(device,MTLPixelFormatDepth32Float_Stencil8,W*2,H,1);
+    id<MTLTexture> zmulti=texture(device,MTLPixelFormatDepth32Float_Stencil8,W,H,2);
+    id<MTLTexture> zout=texture(device,MTLPixelFormatDepth32Float_Stencil8,W*2,H,1);
+    command=[queue commandBuffer];
+    MTLRenderPassDescriptor* pass=[MTLRenderPassDescriptor renderPassDescriptor];
+    pass.depthAttachment.texture=pass.stencilAttachment.texture=z;
+    pass.depthAttachment.loadAction=pass.stencilAttachment.loadAction=MTLLoadActionDontCare;
+    pass.depthAttachment.storeAction=pass.stencilAttachment.storeAction=MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> enc=[command renderCommandEncoderWithDescriptor:pass];
+    [enc setRenderPipelineState:seed]; [enc setDepthStencilState:ds];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; [enc endEncoding];
+    for (int repeat=0;repeat<4;++repeat) {
+        assert([transfer encode:command from:repeat ? zout : z to:zmulti]);
+        assert([transfer encode:command from:zmulti to:zout]);
+    }
+    id<MTLTexture> inspection=texture(device,MTLPixelFormatRGBA32Float,W*2,H,1);
+    pd.depthAttachmentPixelFormat=pd.stencilAttachmentPixelFormat=MTLPixelFormatInvalid;
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatRGBA32Float;
+    pd.fragmentFunction=[lib newFunctionWithName:@"inspect"];
+    id<MTLRenderPipelineState> inspect=[device newRenderPipelineStateWithDescriptor:pd error:&error]; assert(inspect);
+    pass=[MTLRenderPassDescriptor renderPassDescriptor]; pass.colorAttachments[0].texture=inspection;
+    pass.colorAttachments[0].loadAction=MTLLoadActionDontCare; pass.colorAttachments[0].storeAction=MTLStoreActionStore;
+    enc=[command renderCommandEncoderWithDescriptor:pass]; [enc setRenderPipelineState:inspect];
+    [enc setFragmentTexture:zout atIndex:0];
+    [enc setFragmentTexture:[zout newTextureViewWithPixelFormat:MTLPixelFormatX32_Stencil8] atIndex:1];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; [enc endEncoding];
+    complete(command);
+    float depths[N*4]; [inspection getBytes:depths bytesPerRow:W*2*16 fromRegion:MTLRegionMake2D(0,0,W*2,H) mipmapLevel:0];
+    for (unsigned i=0;i<N;++i) {
+        assert(depths[i*4]==(i+1)/2048.f);
+        assert(depths[i*4+1]==((i*53)&255));
+    }
+    /* At x+y=7, the triangle covers sample 1 (.25,.25), not sample 0
+     * (.75,.75). Flattened horizontal sampling would not have this pattern. */
+    multi=texture(device,MTLPixelFormatRGBA8Unorm,8,8,2);
+    output=texture(device,MTLPixelFormatRGBA8Unorm,16,8,1);
+    pd.vertexFunction=[lib newFunctionWithName:@"tri"]; pd.fragmentFunction=[lib newFunctionWithName:@"white"];
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatRGBA8Unorm; pd.rasterSampleCount=2;
+    id<MTLRenderPipelineState> triangle=[device newRenderPipelineStateWithDescriptor:pd error:&error]; assert(triangle);
+    command=[queue commandBuffer]; pass=[MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture=multi; pass.colorAttachments[0].loadAction=MTLLoadActionClear;
+    pass.colorAttachments[0].clearColor=MTLClearColorMake(0,0,0,0); pass.colorAttachments[0].storeAction=MTLStoreActionStore;
+    enc=[command renderCommandEncoderWithDescriptor:pass]; [enc setRenderPipelineState:triangle];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; [enc endEncoding];
+    assert([transfer encode:command from:multi to:output]); complete(command);
+    [output getBytes:result bytesPerRow:16*4 fromRegion:MTLRegionMake2D(0,0,16,8) mipmapLevel:0];
+    for (unsigned y=0;y<8;++y) for (unsigned x=0;x<8;++x) for (unsigned s=0;s<2;++s) {
+        unsigned inside=x+y+(s==0 ? 1.5f : .5f)<8;
+        assert(result[(y*16+x*2+s)*4]==(inside ? 255 : 0));
+    }
+    puts("PASS: 1024 samples each of RGBA8, FP16, FP32, depth and stencil survive four 2x MSAA roundtrips; all 256 stencil values; 128 analytic edge samples preserve diagonal coverage.");
+    return 0;
+} }
diff --git a/libs/video/tests/test_metal_shared_stage.m b/libs/video/tests/test_metal_shared_stage.m
new file mode 100644
index 0000000..aa8a8d9
--- /dev/null
+++ b/libs/video/tests/test_metal_shared_stage.m
@@ -0,0 +1,78 @@
+/* Verify production staging lifetime against an intentionally blocked GPU. */
+#define ENG_STAGE_MAX (8u << 20)
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+float cellAvconfExt_display_gamma(void) { return 1; }
+int cellGcmOffsetIsDisplay(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveOffset(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveLocated(int loc,u32 off) { (void)loc;(void)off;assert(0);return 0; }
+void rsx_fetch_attrib(const rsx_state* st,int idx,u32 vi,float out[4]) { (void)st;(void)idx;(void)vi;(void)out;assert(0); }
+int main(void) { @autoreleasepool {
+    s_dev=MTLCreateSystemDefaultDevice();assert(s_dev);s_queue=[s_dev newCommandQueue];
+    s_eng_direct_stage=1;
+    u8 original[32]; for(u32 i=0;i<sizeof original;++i)original[i]=(u8)(i*7+1);
+    u32 first,second,grown;
+    assert(eng_stage_copy(original,17,&first) && first==0);
+    assert(eng_stage_copy(original,32,&second) && second==256);
+    assert(eng_stage_reserve((4u<<20)+16,&grown));
+    assert(!memcmp(s_eng_stage+first,original,17));
+    assert(!memcmp(s_eng_stage+second,original,32));
+    id<MTLBuffer> source=s_eng_stages[s_eng_stage_slot].buffer;
+    id<MTLBuffer> output=[s_dev newBufferWithLength:64 options:MTLResourceStorageModeShared];
+    id<MTLSharedEvent> gate=[s_dev newSharedEvent];
+    id<MTLCommandBuffer> a=[s_queue commandBuffer];
+    [a encodeWaitForEvent:gate value:1];
+    id<MTLBlitCommandEncoder> copy=[a blitCommandEncoder];
+    [copy copyFromBuffer:source sourceOffset:second toBuffer:output destinationOffset:0 size:32];
+    [copy endEncoding];[a commit];eng_stage_submitted(a);
+    assert(eng_stage_reserve(32,&first));
+    assert(s_eng_stages[s_eng_stage_slot].buffer!=source);
+    memset(s_eng_stage,0xb3,32);
+    id<MTLCommandBuffer> b=[s_queue commandBuffer];copy=[b blitCommandEncoder];
+    [copy copyFromBuffer:s_eng_stages[s_eng_stage_slot].buffer sourceOffset:0
+               toBuffer:output destinationOffset:32 size:32];
+    [copy endEncoding];[b commit];eng_stage_submitted(b);
+    assert(eng_stage_reserve(32,&first));memset(s_eng_stage,0xc4,32);
+    assert(!memcmp((u8*)source.contents+second,original,32));
+    id<MTLCommandBuffer> c=[s_queue commandBuffer];[c commit];eng_stage_submitted(c);
+    assert(eng_stage_reserve(32,&first));memset(s_eng_stage,0xd5,32);
+    id<MTLCommandBuffer> d=[s_queue commandBuffer];[d commit];eng_stage_submitted(d);
+    /* All four slots are GPU-owned. A fifth reservation must wait, rather
+     * than reuse the first slot merely because its CPU producer returned. */
+    __block int released=0;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW,20*NSEC_PER_MSEC),
+                   dispatch_get_global_queue(QOS_CLASS_DEFAULT,0), ^{
+        __atomic_store_n(&released,1,__ATOMIC_RELEASE);gate.signaledValue=1;
+    });
+    assert(eng_stage_reserve(32,&first));
+    assert(__atomic_load_n(&released,__ATOMIC_ACQUIRE));
+    assert(s_eng_stages[s_eng_stage_slot].buffer==source);
+    [a waitUntilCompleted];[b waitUntilCompleted];[c waitUntilCompleted];[d waitUntilCompleted];
+    assert(a.status==MTLCommandBufferStatusCompleted && b.status==MTLCommandBufferStatusCompleted);
+    assert(!memcmp(output.contents,original,32));
+    for(int i=32;i<64;++i)assert(((u8*)output.contents)[i]==0xb3);
+    u32 used=s_eng_stage_used;
+    assert(!eng_stage_reserve(ENG_STAGE_MAX+1,&first) && s_eng_stage_used==used);
+    /* Force a rollover between draws. Constants for the next draw must be
+     * staged AFTER submission, along with that draw's vertex/index bytes. */
+    s_eng_stage_used=ENG_STAGE_MAX-256;
+    assert(eng_prepare_draw(NULL,2048));
+    assert(s_eng_stage_used==0 && s_eng_checked_completed);
+    eng_bind_vs_constants(NULL,original,32);
+    eng_bind_ps_constants(NULL,original,17);
+    const u32 indices[3]={0,1,2};
+    u8 vertices[48];memset(vertices,0x5a,sizeof vertices);
+    eng_draw(NULL,RSX_TOPOLOGY_TRIANGLES,vertices,3,16,indices,3);
+    assert(s_eng_rec_count==1);
+    const EngRecord* record=&s_eng_rec[0];
+    assert(!memcmp(s_eng_stage+record->vs_cb_off,original,32));
+    assert(!memcmp(s_eng_stage+record->ps_cb_off,original,17));
+    assert(!memcmp(s_eng_stage+record->vb_off,vertices,48));
+    assert(!memcmp(s_eng_stage+record->ib_off,indices,12));
+    s_eng_rec_count=0; /* fixture record has no pipeline; bytes verified above */
+    assert(!eng_prepare_draw(NULL,(u64)ENG_STAGE_MAX+1));
+    eng_shutdown(NULL);
+    puts("PASS: alignment, growth preservation, GPU-owned bytes immutable, full pool waits, completed buffers reused, draw rollover preserves constants/vertices/indices, oversized allocation rejected");
+    return 0;
+}}
diff --git a/libs/video/tests/test_metal_vertex_packed.m b/libs/video/tests/test_metal_vertex_packed.m
new file mode 100644
index 0000000..2fc26f8
--- /dev/null
+++ b/libs/video/tests/test_metal_vertex_packed.m
@@ -0,0 +1,85 @@
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include "rsx_vertex_packed.h"
+#include "rsx_vertex_packed_msl.h"
+#include "rsx_vertex_formats.h"
+#include <assert.h>
+static u32 random_state = 0x3ac0741;
+static u32 rnd(void) { random_state ^= random_state << 13; random_state ^= random_state >> 17; random_state ^= random_state << 5; return random_state; }
+int main(void) { @autoreleasepool {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice(); assert(device);
+    id<MTLCommandQueue> queue = [device newCommandQueue]; assert(queue);
+    MTLCompileOptions* options = [MTLCompileOptions new]; options.fastMathEnabled = NO;
+    NSError* error = nil;
+    id<MTLLibrary> library = [device newLibraryWithSource:[NSString stringWithUTF8String:rsx_vertex_packed_msl] options:options error:&error];
+    if (!library) { fprintf(stderr, "%s\n", error.localizedDescription.UTF8String); return 1; }
+    id<MTLComputePipelineState> pipeline = [device newComputePipelineStateWithFunction:[library newFunctionWithName:@"rsx_unpack_vertices"] error:&error];
+    assert(pipeline);
+    id<MTLBuffer> norms = [device newBufferWithLength:RSX_PACKED_NORM_FLOATS * 4 options:MTLResourceStorageModeShared];
+    rsx_vertex_pack_norm_table(norms.contents);
+    unsigned long vertices = 0;
+    for (u32 type = 0; type < 8; ++type) for (u32 size = 1; size <= 4; ++size) for (u32 mixed = 0; mixed < 3; ++mixed) {
+        const u32 count = mixed ? 257 : ((type == 1 || type == 3) && size == 4 ? 65536 : 2053);
+        const u32 source_count = mixed == 2 ? 65536 : count;
+        u8* source = malloc((size_t)source_count * 16); assert(source);
+        for (u32 i = 0; i < source_count * 16; ++i) source[i] = (u8)rnd();
+        // Every half/snorm representation occurs in the large cases.
+        if (count == 65536) for (u32 i = 0; i < count; ++i)
+            for (u32 c = 0; c < 4; ++c) { source[i*16+c*2]=(u8)(i>>8); source[i*16+c*2+1]=(u8)i; }
+        rsx_vertex_ref* refs = malloc((size_t)count * sizeof *refs); assert(refs);
+        for (u32 i = 0; i < count; ++i)
+            refs[i] = (rsx_vertex_ref){mixed == 2 ? i * 251u : (mixed ? i : i + 0xffff0u), mixed ? 0u : 16u};
+        rsx_vertex_fetch_plan plan = {0};
+        rsx_vertex_layout_plan_init(&plan.layout, mixed ? 0x8049 : 1);
+        rsx_vertex_fetch_attr* a = &plan.attr[0];
+        a->desc.type = type; a->desc.size = size; a->stride = 16;
+        a->elem_size = rsx_vertex_attrib_size(type, size);
+        a->stable_base = source; a->stable_last = source_count - 1;
+        const u32 default_bits[4] = {0x7fc001ab,0x80000000,0x00000001,0x40000000};
+        memcpy(a->default_value, default_bits, 16);
+        if (mixed) for (u32 slot = 1; slot < 4; ++slot) {
+            rsx_vertex_fetch_attr* other = &plan.attr[plan.layout.attrs[slot]];
+            *other = *a;
+            other->desc.type = slot == 3 ? 0 : (type + slot) % 8;
+            other->elem_size = rsx_vertex_attrib_size(other->desc.type, size);
+            other->desc.frequency = slot == 1 ? 3 : 5;
+            if (slot == 2) plan.divider_mask |= 1u << plan.layout.attrs[slot];
+        }
+        rsx_packed_vertices packed = {0};
+        if (mixed == 2) assert(!rsx_vertex_pack(&plan, refs, count, &packed));
+        assert(rsx_vertex_pack_ex(&plan, refs, count, &packed, mixed == 2));
+        u8* expected = malloc((size_t)count * plan.layout.stride); assert(expected);
+        for (u32 i = 0; i < count; ++i) assert(rsx_vertex_fetch_one(&plan, &refs[i], expected + i*plan.layout.stride));
+        const u32 blob_offset = 256, output_offset = blob_offset + packed.size;
+        const size_t output_bytes = (size_t)count * plan.layout.stride;
+        id<MTLBuffer> arena = [device newBufferWithLength:output_offset + output_bytes + 256 options:MTLResourceStorageModeShared];
+        memset(arena.contents, 0xa5, arena.length);
+        memcpy((u8*)arena.contents + blob_offset, packed.data, packed.size);
+        const u32 groups = (count + RSX_PACKED_GROUP_SIZE - 1) / RSX_PACKED_GROUP_SIZE;
+        id<MTLBuffer> jobs = [device newBufferWithLength:groups * sizeof(rsx_packed_work) options:MTLResourceStorageModeShared];
+        rsx_packed_work* work = jobs.contents;
+        for (u32 i = 0; i < groups; ++i) work[i] = (rsx_packed_work){blob_offset, output_offset, i * RSX_PACKED_GROUP_SIZE, count};
+        // The GPU must consume the immutable snapshot, never the live source.
+        memset(source, 0xcc, (size_t)source_count * 16);
+        id<MTLCommandBuffer> command = [queue commandBuffer];
+        id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
+        [encoder setComputePipelineState:pipeline];
+        [encoder setBuffer:arena offset:0 atIndex:0]; [encoder setBuffer:jobs offset:0 atIndex:1]; [encoder setBuffer:norms offset:0 atIndex:2];
+        [encoder dispatchThreadgroups:MTLSizeMake(groups,1,1) threadsPerThreadgroup:MTLSizeMake(RSX_PACKED_GROUP_SIZE,1,1)];
+        [encoder endEncoding]; [command commit]; [command waitUntilCompleted];
+        assert(command.status == MTLCommandBufferStatusCompleted);
+        const u8* actual = (const u8*)arena.contents + output_offset;
+        if (memcmp(expected, actual, output_bytes)) {
+            for (size_t i = 0; i < output_bytes; ++i) if (expected[i] != actual[i]) {
+                fprintf(stderr,"type=%u size=%u mismatch byte=%zu expected=%02x actual=%02x\n",type,size,i,expected[i],actual[i]);break;
+            }
+            return 1;
+        }
+        for (size_t i = 0; i < 256; ++i) assert(actual[output_bytes + i] == 0xa5);
+        assert(!memcmp((u8*)arena.contents+blob_offset, packed.data, packed.size));
+        vertices += count;
+        free(source);free(refs);free(expected);rsx_vertex_pack_destroy(&packed);
+    }
+    printf("PASS: Metal decoded %lu vertices byte-identically to CPU, all formats/sizes, all half/snorm bit patterns, mixed attributes, divisors, modulo, defaults, wrap, source lifetime and output bounds\n", vertices);
+    return 0;
+} }
diff --git a/libs/video/tests/test_msl_cache.cpp b/libs/video/tests/test_msl_cache.cpp
new file mode 100644
index 0000000..e403bcd
--- /dev/null
+++ b/libs/video/tests/test_msl_cache.cpp
@@ -0,0 +1,129 @@
+/* Real translator regression: cached text must exactly match uncached MSL.
+ * Corruption, stale identity and collisions must be misses, never wrong code. */
+#include "../rsx_shader_msl.h"
+#include "../rsx_msl_disk_cache.h"
+#include <cassert>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <thread>
+#include <vector>
+#include <sys/wait.h>
+
+namespace fs=std::filesystem;
+static const char* shader=
+    "float4 main(float4 v : TEXCOORD0) : SV_Target0 { return max(v,float4(0,0,0,0)); }";
+static std::string translate(const char* source=shader,int stage=RSX_SHADER_STAGE_FRAGMENT)
+{
+    char out[512*1024],log[4096];
+    int result=rsx_hlsl_to_msl(source,stage,out,sizeof out,log,sizeof log);
+    if(result)std::fprintf(stderr,"%s\n",log);
+    assert(result==0);
+    return out;
+}
+static std::vector<fs::path> entries(const fs::path& dir)
+{
+    std::vector<fs::path> paths;
+    for(const auto& e:fs::directory_iterator(dir))
+        if(e.path().extension()==".mslcache")paths.push_back(e.path());
+    return paths;
+}
+static RsxMslCacheStats stats()
+{
+    RsxMslCacheStats s;rsx_hlsl_to_msl_cache_stats(&s);return s;
+}
+static std::string read(const fs::path& p)
+{
+    std::ifstream f(p,std::ios::binary);return {std::istreambuf_iterator<char>(f),{}};
+}
+int main(int argc,char** argv)
+{
+    if(argc==4 && std::string(argv[1])=="--child") {
+        setenv("PS3RECOMP_MSL_CACHE",argv[2],1);unsetenv("PS3RECOMP_MSL_FAST");
+        assert(translate()==read(argv[3]));
+        assert(stats().disk_hits==1 && stats().translations==0);
+        return 0;
+    }
+    if(argc==3 && std::string(argv[1])=="--bench") {
+        /* Real captured HLSL, no GPU required. Use a fresh directory supplied
+         * through the same optional cache setting as the game. */
+        std::string source=read(argv[2]);assert(!source.empty());
+        auto start=std::chrono::steady_clock::now();
+        std::string first=translate(source.c_str());
+        auto middle=std::chrono::steady_clock::now();
+        for(int i=0;i<50;++i)assert(translate(source.c_str())==first);
+        auto end=std::chrono::steady_clock::now();
+        auto s=stats();
+        std::printf("cold_ms=%.6f warm_mean_ms=%.6f translations=%llu disk_hits=%llu bytes=%zu\n",
+            std::chrono::duration<double,std::milli>(middle-start).count(),
+            std::chrono::duration<double,std::milli>(end-middle).count()/50,
+            (unsigned long long)s.translations,(unsigned long long)s.disk_hits,first.size());
+        return 0;
+    }
+    char temporary[]="/tmp/ps3recomp-msl-cache-XXXXXX";
+    const char* created=mkdtemp(temporary);assert(created);const fs::path dir=created;
+    unsetenv("PS3RECOMP_MSL_CACHE");unsetenv("PS3RECOMP_MSL_FAST");
+    const std::string expected=translate();
+    assert(expected.find("precise::")!=std::string::npos);
+    setenv("PS3RECOMP_MSL_CACHE",created,1);
+    assert(translate()==expected);assert(stats().disk_writes==1);
+    assert(translate()==expected);assert(stats().disk_hits==1);
+    assert(stats().translations==2);auto files=entries(dir);assert(files.size()==1);
+    const fs::path original=files[0];
+    /* Full-key check is separate from the path hash: emulate a filename
+     * collision or stale compiler/options identity using the private format. */
+    char guarded[512*1024];memset(guarded,0x5a,sizeof guarded);
+    assert(!rsx_msl_cache::load(original.string(),"different source/version",guarded,sizeof guarded));
+    assert(guarded[0]==0x5a);
+    for(int mode=0;mode<3;++mode) {
+        std::string bytes=read(original);
+        if(mode==0)bytes.back()^=1;        // corrupt payload
+        if(mode==1)bytes[0]^=1;           // stale format identity
+        if(mode==2)bytes.resize(11);      // truncated header
+        std::ofstream(original,std::ios::binary).write(bytes.data(),bytes.size());
+        auto before=stats();assert(translate()==expected);
+        assert(stats().translations==before.translations+1);
+        assert(translate()==expected);
+    }
+    { std::ofstream f(original,std::ios::binary|std::ios::app);f<<"trailing garbage"; }
+    auto before=stats();assert(translate()==expected);
+    assert(stats().translations==before.translations+1);
+    char small[32],log[4096];memset(small,0x5a,sizeof small);
+    assert(rsx_hlsl_to_msl(shader,1,small,8,log,sizeof log)==-1);
+    for(unsigned i=8;i<sizeof small;++i)assert(small[i]==0x5a);
+    assert(translate()==expected);  // short output did not replace good entry
+    assert(rsx_hlsl_to_msl(shader,99,small,sizeof small,log,sizeof log)==-1);
+    const size_t valid_files=entries(dir).size();
+    assert(rsx_hlsl_to_msl("not valid HLSL",1,small,sizeof small,log,sizeof log)==-1);
+    assert(entries(dir).size()==valid_files);
+    setenv("PS3RECOMP_MSL_FAST","",1);
+    const std::string fast=translate();assert(fast!=expected && fast.find("fast::")!=std::string::npos);
+    assert(entries(dir).size()==valid_files+1);assert(translate()==fast);
+    unsetenv("PS3RECOMP_MSL_FAST");assert(translate()==expected);
+    /* Changed source obtains a distinct cache entry. */
+    const char* other="float4 main(float4 v:TEXCOORD0):SV_Target0{return min(v,1);}";
+    const auto changed=translate(other);assert(changed!=expected);assert(translate(other)==changed);
+    /* Identical source text can translate for two different shader stages. */
+    const auto vertex=translate("void main(){}",RSX_SHADER_STAGE_VERTEX);
+    const auto fragment=translate("void main(){}",RSX_SHADER_STAGE_FRAGMENT);
+    assert(vertex!=fragment);
+    before=stats();
+    assert(translate("void main(){}",RSX_SHADER_STAGE_VERTEX)==vertex);
+    assert(translate("void main(){}",RSX_SHADER_STAGE_FRAGMENT)==fragment);
+    assert(stats().disk_hits==before.disk_hits+2);
+    std::vector<std::thread> workers;
+    before=stats();
+    for(int i=0;i<8;++i)workers.emplace_back([&]{assert(translate()==expected);});
+    for(auto& t:workers)t.join();assert(stats().disk_hits==before.disk_hits+8);
+    /* A new process must hit disk without invoking glslang. */
+    const fs::path expected_file=dir/"expected.txt";
+    std::ofstream(expected_file)<<expected;
+    pid_t child=fork();assert(child>=0);
+    if(child==0) { execl(argv[0],argv[0],"--child",created,expected_file.c_str(),(char*)nullptr);_exit(127); }
+    int status=0;assert(waitpid(child,&status,0)==child && WIFEXITED(status) && WEXITSTATUS(status)==0);
+    setenv("PS3RECOMP_MSL_CACHE",(dir/"missing").c_str(),1);
+    assert(translate()==expected); // unavailable cache is never a render failure
+    fs::remove_all(dir);
+    std::puts("PASS: exact uncached/cold/warm MSL; fresh-process disk hit; source/math/stage/identity checks; corruption/truncation/trailing bytes; bounded output; failed translations; unavailable directory; concurrent readers.");
+}
diff --git a/libs/video/tests/test_sampled_dimensions.c b/libs/video/tests/test_sampled_dimensions.c
new file mode 100644
index 0000000..06f0ec5
--- /dev/null
+++ b/libs/video/tests/test_sampled_dimensions.c
@@ -0,0 +1,123 @@
+/* Real draw-engine cache/binding regression; synthetic guest programs only. */
+#define main original_engine_tests_main
+#include "test_rsx_draw_engine.c"
+#undef main
+#include "rsx_test_programs.h"
+
+static char captured_ps[65536];
+static u32 small_volume(void* u, rsx_be_format f, u32 w, u32 h, u32 d,
+                         u32 levels, u32 remap, u32 format)
+{
+    (void)u; (void)remap; (void)format;
+    CHECK(f == RSX_BE_FMT_R8G8B8A8 && w == 4 && h == 4 && d == 4 && levels == 1,
+          "sampled volume remains a real 4x4x4 resource");
+    return stub_handle();
+}
+static u32 capture_pipeline(void* u, const char* vs, const char* ps,
+                            const rsx_be_render_state* rs,
+                            const rsx_vertex_layout_plan* l, u32 stride,
+                            rsx_be_format f, u32 n)
+{
+    snprintf(captured_ps, sizeof captured_ps, "%s", ps);
+    return stub_pipeline_create(u, vs, ps, rs, l, stride, f, n);
+}
+
+/* Small 2D, cube and volume resources at separate readable guest addresses. */
+static void set_texture(u32 unit, int kind)
+{
+    const u32 base = M_TEX_UNIT + unit * 32u;
+    m(base, 0x60000u + unit * 0x1000u);
+    m(base + 4, 2u | ((kind == 3 ? 3u : 2u) << 4) |
+        (0xA5u << 8) | (1u << 16) | (kind == 6 ? 4u : 0u));
+    m(base + 8, 0x00030303u);
+    m(base + 12, 0x80000000u);
+    m(base + 16, 0xAAE4u);
+    m(base + 20, 0x01010000u);
+    m(base + 24, 0x00040004u);
+    m(0x1840u + unit * 4u, ((kind == 3 ? 4u : 1u) << 20) | 16u);
+}
+
+static void set_program(u32 unit, u32 opcode)
+{
+    u8 vp[16];
+    rsx_test_vp_mov_out(vp, 0, RSX_TEST_VP_SWZ_IDENT, 0, 1);
+    m(0x1E9C, 0);
+    for (u32 i = 0; i < 4; i++) {
+        u32 w; memcpy(&w, vp + i * 4, 4); m(0xB80 + i * 4, w);
+    }
+    m(0x1EA0, 0);
+    rsx_test_fp_instr(vm_base + TEX_OFFSET,
+        RSX_TEST_FP_OPC(opcode) | RSX_TEST_FP_MASK_XYZW |
+        RSX_TEST_FP_INSRC_TC0 | RSX_TEST_FP_END | (unit << 17),
+        RSX_TEST_FP_SRC_INPUT | RSX_TEST_FP_SWZ_IDENT);
+    m(0x8E4, TEX_OFFSET | 2); m(0x1D60, 64);
+}
+
+static void check_case(int enabled, int metadata, u32 sampled, u32 opcode)
+{
+    setenv("RSX_FP_SAMPLED_DIMENSIONS", enabled ? "1" : "0", 1);
+    setenv("RSX_FP_METADATA_CACHE", metadata ? "1" : "0", 1);
+    engine_up();
+    rsx_draw_backend backend = g_stub_backend;
+    backend.pipeline_create = capture_pipeline;
+    backend.texture_create_3d = small_volume;
+    rsx_draw_engine_set_backend(&backend);
+    set_program(sampled, opcode);
+    for (u32 u = 0; u < 16; u++) set_texture(u, 2);
+    draw_triangle();
+    const u32 original = stub.bound_pipeline;
+    CHECK(original && stub.bound_mask == (1u << sampled),
+          "initial sample unit %u opcode %u (mode %d metadata %d)",
+          sampled, opcode, enabled, metadata);
+    int expected = 1;
+    for (u32 u = 0; u < 16; u++) {
+        if (u == sampled) continue;
+        for (int kind = 3; kind <= 6; kind += 3) {
+            set_texture(u, kind);
+            draw_triangle();
+            if (!enabled) expected++;
+            CHECK(stub.n_pipeline_create == expected &&
+                  (!enabled || stub.bound_pipeline == original) &&
+                  stub.bound_mask == (1u << sampled),
+                  "unused unit %u kind %d: mode %d preserves binding; pipelines %d",
+                  u, kind, enabled, stub.n_pipeline_create);
+        }
+        set_texture(u, 2);
+        draw_triangle();
+        CHECK(stub.bound_pipeline == original,
+              "restoring unused unit %u reuses original pipeline", u);
+    }
+    /* Used dimensions MUST still specialize HLSL and retain the same slot. */
+    set_texture(sampled, 6); draw_triangle();
+    const u32 cube = stub.bound_pipeline;
+    char declaration[64];
+    snprintf(declaration, sizeof declaration, "TextureCube rsx_tex%u :", sampled);
+    CHECK(cube != original && stub.n_pipeline_create == ++expected &&
+          strstr(captured_ps, declaration) && stub.bound_mask == (1u << sampled),
+          "used cube still changes pipeline and declares the correct slot");
+    set_texture(sampled, 3); draw_triangle();
+    snprintf(declaration, sizeof declaration, "Texture3D   rsx_tex%u :", sampled);
+    CHECK(stub.bound_pipeline != original && stub.bound_pipeline != cube &&
+          stub.n_pipeline_create == ++expected &&
+          strstr(captured_ps, declaration) && stub.bound_mask == (1u << sampled),
+          "used volume still changes pipeline and declares the correct slot");
+    set_texture(sampled, 2); draw_triangle();
+    CHECK(stub.bound_pipeline == original && stub.n_pipeline_create == expected,
+          "used 2D switchback reuses the right original pipeline");
+    engine_down();
+}
+
+int main(void)
+{
+    vm_base = calloc(1, GUEST_BYTES);
+    if (!vm_base) return 2;
+    ppu_vm_size = GUEST_BYTES;
+    const u32 ops[] = {0x17, 0x18, 0x2F, 0x31}; /* implemented TEX/TXP/TXL/TXB */
+    for (int mode = 0; mode < 2; mode++)
+        for (int metadata = 0; metadata < 2; metadata++)
+            for (u32 i = 0; i < sizeof ops / sizeof ops[0]; i++)
+                check_case(mode, metadata, i == 0 ? 0 : 15, ops[i]);
+    free(vm_base);
+    printf("sampled dimensions failures: %d\n", g_failures);
+    return g_failures ? 1 : 0;
+}
diff --git a/libs/video/tests/test_surface_seed.c b/libs/video/tests/test_surface_seed.c
new file mode 100644
index 0000000..d475eaf
--- /dev/null
+++ b/libs/video/tests/test_surface_seed.c
@@ -0,0 +1,145 @@
+/* Exercise the production seed converter and its actual dispatcher callsite. */
+#define main original_engine_tests_main
+#include "test_rsx_draw_engine.c"
+#undef main
+#include "../rsx_draw_engine.c"
+#include <assert.h>
+
+static u8* seed_source;
+static u32 seed_span, seed_request, seed_calls;
+static const u32 seed_offset=0x1000;
+static const u8* bounded_seed_reader(void* user,u32 location,u32 offset,u32 bytes)
+{
+    (void)user;
+    seed_calls++;seed_request=bytes;
+    if(location!=RSX_LOCATION_MAIN || offset!=seed_offset || bytes>seed_span) return NULL;
+    return seed_source;
+}
+static void seed_fixture(u32 w,u32 h,u32 bpp,u32 pitch)
+{
+    free(seed_source);
+    seed_span=(h-1)*pitch+w*bpp;
+    seed_source=malloc(seed_span);assert(seed_source);
+    for(u32 i=0;i<seed_span;++i)seed_source[i]=(u8)(i*37+11);
+    seed_calls=seed_request=0;
+}
+static void verify_seed(const u8* output,u32 w,u32 h,u32 color,u32 pitch)
+{
+    assert(output);
+    for(u32 y=0;y<h;++y)for(u32 x=0;x<w;++x) {
+        const u8* src=seed_source+y*pitch+x*(color==9?1:4);
+        const u8* dst=output+(y*w+x)*4;
+        if(color==9) assert(dst[0]==src[0] && dst[1]==src[0] &&
+                           dst[2]==src[0] && dst[3]==255);
+        else assert(dst[0]==src[1] && dst[1]==src[2] &&
+                    dst[2]==src[3] && dst[3]==src[0]);
+    }
+}
+static void differential(void)
+{
+    rsx_draw_engine_set_guest_memory(bounded_seed_reader,NULL);
+    u32 row;
+    /* Exact-length B8 memory: the old ARGB request cannot even be satisfied. */
+    seed_fixture(7,3,1,11);
+    g.surface_typed_seed=0;
+    assert(!eng_surface_seed(1,seed_offset,7,3,RSX_BE_FMT_R8G8B8A8,11,9,1,&row));
+    assert(seed_request==84 && seed_span==29);
+    g.surface_typed_seed=1;
+    verify_seed(eng_surface_seed(1,seed_offset,7,3,RSX_BE_FMT_R8G8B8A8,11,9,1,&row),7,3,9,11);
+    assert(row==28 && seed_request==29);
+    for(u32 w=1;w<70;w+=3)for(u32 h=1;h<15;h+=3)for(u32 color=8;color<=9;++color) {
+        const u32 bpp=color==9?1:4,pitch=w*bpp+(w%5);
+        seed_fixture(w,h,bpp,pitch);
+        const u8* dst=eng_surface_seed(1,seed_offset,w,h,RSX_BE_FMT_R8G8B8A8,pitch,color,1,&row);
+        verify_seed(dst,w,h,color,pitch);
+        assert(row==w*4 && seed_request==seed_span);
+    }
+    seed_fixture(5,2,4,20);
+    verify_seed(eng_surface_seed(1,seed_offset,5,2,RSX_BE_FMT_R8G8B8A8,0,8,1,&row),5,2,8,20);
+    /* Invalid/unsupported descriptions must not read guest memory at all. */
+    const u32 calls=seed_calls;
+    assert(!eng_surface_seed(1,seed_offset,5,2,RSX_BE_FMT_R8G8B8A8,19,8,1,&row));
+    assert(!eng_surface_seed(1,seed_offset,0,2,RSX_BE_FMT_R8G8B8A8,20,8,1,&row));
+    assert(!eng_surface_seed(1,seed_offset,5,0,RSX_BE_FMT_R8G8B8A8,20,8,1,&row));
+    assert(!eng_surface_seed(1,seed_offset,5,2,RSX_BE_FMT_R8G8B8A8,UINT32_MAX,8,1,&row));
+    assert(!eng_surface_seed(1,UINT32_MAX-5,5,2,RSX_BE_FMT_R8G8B8A8,20,8,1,&row));
+    assert(!eng_surface_seed(1,seed_offset,5,2,RSX_BE_FMT_R8G8B8A8,20,8,2,&row));
+    assert(!eng_surface_seed(1,seed_offset,5,2,RSX_BE_FMT_R8G8B8A8,20,10,1,&row));
+    assert(!eng_surface_seed(0,seed_offset,5,2,RSX_BE_FMT_R8G8B8A8,20,8,1,&row));
+    assert(seed_calls==calls && row==0);
+    seed_span=19;
+    assert(!eng_surface_seed(1,seed_offset,5,2,RSX_BE_FMT_R8G8B8A8,20,8,1,&row));
+    assert(row==0);
+    free(g.tex_staging);g.tex_staging=NULL;g.tex_staging_cap=0;
+    puts("PASS: B8 one-byte source span, ARGB component order, 230 padded/odd layouts, exact final-row bounds, invalid dimensions/pitch/overflow and unsupported layouts");
+}
+static u32 expected_color,expected_pitch;
+static int captured;
+static u32 capture_seed(void* u,rsx_be_format f,u32 w,u32 h,const void* seed,u32 row)
+{
+    assert(f==RSX_BE_FMT_R8G8B8A8 && row==w*4);
+    verify_seed(seed,w,h,expected_color,expected_pitch);
+    captured++;
+    return stub_color_create(u,f,w,h,seed,row);
+}
+static void dispatcher_case(u32 color)
+{
+    setenv("RSX_SURFACE_GPU_SEED","0",1);
+    setenv("RSX_SURFACE_TYPED_SEED","1",1);
+    rsx_draw_backend backend=g_stub_backend;
+    backend.color_target_create=capture_seed;
+    rsx_draw_engine_set_backend(&backend);
+    assert(!rsx_draw_engine_init(1280,720));
+    rsx_draw_engine_set_guest_memory(bounded_seed_reader,NULL);
+    expected_color=color;expected_pitch=color==9?11:32;
+    seed_fixture(7,3,color==9?1:4,expected_pitch);
+    m(M_CONTEXT_DMA_COLOR_A,DMA_MAIN);
+    m(M_SURFACE_FORMAT,color|(1u<<8));
+    m(M_SURFACE_CLIP_H,7u<<16);m(M_SURFACE_CLIP_V,3u<<16);
+    m(M_COLOR_A_OFFSET,seed_offset);m(M_COLOR_A_PITCH,expected_pitch);
+    captured=0;m(M_CLEAR_BUFFERS,0xF0);
+    assert(captured==1 && seed_request==seed_span);
+    m(M_CLEAR_BUFFERS,0xF0);
+    assert(captured==1); /* Existing target is retained, not repeatedly seeded. */
+    engine_down();
+    assert(!g.surface_typed_seed);
+}
+static int gpu_calls,gpu_fail;
+static u32 capture_gpu_seed(void* u,u32 w,u32 h,const void* source,u32 pitch)
+{
+    assert(source==seed_source && w==7 && h==3 && pitch==11);
+    assert(seed_request==29);gpu_calls++;
+    return gpu_fail?0:stub_color_create(u,RSX_BE_FMT_R8G8B8A8,w,h,NULL,0);
+}
+static void gpu_dispatcher_case(int enabled,int available,int fail,u32 color)
+{
+    setenv("RSX_SURFACE_GPU_SEED",enabled?"1":"0",1);
+    rsx_draw_backend backend=g_stub_backend;
+    backend.color_target_create=capture_seed;
+    backend.color_target_create_b8=available?capture_gpu_seed:NULL;
+    rsx_draw_engine_set_backend(&backend);
+    assert(!rsx_draw_engine_init(1280,720));
+    rsx_draw_engine_set_guest_memory(bounded_seed_reader,NULL);
+    expected_color=color;expected_pitch=color==9?11:32;
+    seed_fixture(7,3,color==9?1:4,expected_pitch);
+    gpu_calls=captured=0;gpu_fail=fail;
+    u32 slot=eng_surface_get(1,seed_offset,7,3,RSX_BE_FMT_R8G8B8A8,expected_pitch,color,1);
+    assert(slot!=ENG_INVALID);
+    const int attempted=enabled && available && color==9;
+    assert(gpu_calls==attempted && captured==!(attempted && !fail));
+    assert(seed_request==seed_span);
+    assert(eng_surface_get(1,seed_offset,7,3,RSX_BE_FMT_R8G8B8A8,expected_pitch,color,1)==slot);
+    assert(gpu_calls==attempted && captured==!(attempted && !fail));
+    engine_down();assert(!g.surface_gpu_seed);
+}
+int main(void)
+{
+    differential();
+    dispatcher_case(8);dispatcher_case(9);
+    gpu_dispatcher_case(1,1,0,9);gpu_dispatcher_case(1,1,1,9);
+    gpu_dispatcher_case(0,1,0,9);gpu_dispatcher_case(1,0,0,9);
+    gpu_dispatcher_case(1,1,0,8);
+    free(seed_source);
+    puts("PASS: real dispatcher supplies guest color format, raster type and pitch; existing target reused; shutdown reset");
+    return g_failures?1:0;
+}
diff --git a/libs/video/tests/test_vertex_packed.c b/libs/video/tests/test_vertex_packed.c
new file mode 100644
index 0000000..b2533a4
--- /dev/null
+++ b/libs/video/tests/test_vertex_packed.c
@@ -0,0 +1,89 @@
+#include "rsx_vertex_packed.h"
+#include "rsx_vertex_formats.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static u32 state = 0x17a4019;
+static u32 random_word(void) { state ^= state << 13; state ^= state >> 17; state ^= state << 5; return state; }
+static void unpack(const rsx_packed_vertices* packed, u32 vertex, u8* output)
+{
+    const rsx_packed_header* h = (const void*)packed->data;
+    const rsx_vertex_ref* refs = (const void*)(packed->data + h->refs_offset);
+    assert(h->bytes == packed->size && vertex < h->count);
+    for (u32 slot = 0; slot < h->attributes; ++slot) {
+        const rsx_packed_attr* a = &h->attr[slot];
+        float* value = (float*)(output + slot * 16);
+        if (!a->type) { memcpy(value, a->defaults, 16); continue; }
+        u32 element = rsx_vertex_element_index(refs[vertex].vertex_id, refs[vertex].base_index,
+                                               a->frequency, a->modulo);
+        assert(element >= a->first && element <= a->last);
+        u64 offset = a->offset + (u64)(element - a->first) * a->stride;
+        assert(offset + rsx_vertex_attrib_size(a->type, a->size) <= h->bytes);
+        assert(rsx_vertex_decode_element(a->type, a->size, packed->data + offset, value));
+    }
+}
+int main(void)
+{
+    _Static_assert(sizeof(rsx_packed_attr) == 48, "shared GPU attribute ABI");
+    _Static_assert(sizeof(rsx_packed_header) == 784, "shared GPU header ABI");
+    u8* source = malloc(16384u * 64u); assert(source);
+    u8 expected[24][64], actual[64];
+    rsx_vertex_ref refs[24];
+    rsx_packed_vertices packed = {0};
+    rsx_vertex_fetch_plan plan = {0};
+    rsx_vertex_layout_plan_init(&plan.layout, (1u << 0) | (1u << 3) | (1u << 6) | (1u << 15));
+    unsigned cases = 0;
+    for (u32 type = 0; type < 8; ++type) for (u32 size = 1; size <= 4; ++size)
+    for (u32 frequency = 0; frequency <= 3; ++frequency) for (u32 modulo = 0; modulo <= 1; ++modulo)
+    for (u32 sparse = 0; sparse <= 1; ++sparse) {
+        const u32 source_bytes = sparse ? 16384u * 64u : 2048u;
+        for (u32 i = 0; i < source_bytes; ++i) source[i] = (u8)random_word();
+        for (u32 i = 0; i < 24; ++i) {
+            refs[i].vertex_id = sparse ? 300u + i * 601u : (frequency <= 1 ? 0xFFFF0u + i : i);
+            refs[i].base_index = 16;
+        }
+        plan.divider_mask = modulo ? 0xffff : 0;
+        for (u32 slot = 0; slot < 4; ++slot) {
+            rsx_vertex_fetch_attr* f = &plan.attr[plan.layout.attrs[slot]];
+            memset(f, 0, sizeof *f);
+            f->desc.type = (type + slot) % 8; f->desc.size = size;
+            f->desc.frequency = frequency;
+            f->stride = 64; f->elem_size = rsx_vertex_attrib_size(f->desc.type, size);
+            f->stable_first = sparse && frequency <= 1 ? 100 : 0;
+            f->stable_base = source + slot * 16 + f->stable_first * 64;
+            f->stable_last = sparse ? 16383 : 31;
+            u32 defaults[4]; for (u32 i = 0; i < 4; ++i) defaults[i] = random_word();
+            memcpy(f->default_value, defaults, 16);
+        }
+        for (u32 i = 0; i < 24; ++i)
+            assert(rsx_vertex_fetch_one(&plan, &refs[i], expected[i]));
+        if (sparse) assert(!rsx_vertex_pack(&plan, refs, 24, &packed));
+        assert(rsx_vertex_pack_ex(&plan, refs, 24, &packed, sparse));
+        // All interleaved source windows overlap. There is one source copy,
+        // not a full strided block per attribute. Then retire the source data.
+        assert(packed.size <= sizeof(rsx_packed_header) + sizeof refs + 2048 + 16);
+        memset(source, 0xDC, source_bytes);
+        for (u32 i = 0; i < 24; ++i) {
+            unpack(&packed, i, actual);
+            assert(!memcmp(actual, expected[i], sizeof actual));
+        }
+        ++cases;
+    }
+    const u32 previous = packed.size;
+    rsx_vertex_fetch_attr* f = &plan.attr[0];
+    f->desc.type = RSX_VERTEX_TYPE_F; f->elem_size = 16;
+    f->stable_base = NULL;
+    assert(!rsx_vertex_pack(&plan, refs, 24, &packed) && packed.size == previous);
+    assert(!rsx_vertex_pack_ex(&plan, refs, 24, &packed, 1) && packed.size == previous);
+    f->stable_base = source; f->stable_last = 0;
+    assert(!rsx_vertex_pack(&plan, refs, 24, &packed));
+    assert(!rsx_vertex_pack_ex(&plan, refs, 24, &packed, 1) && packed.size == previous);
+    f->stable_last = 1000000;
+    assert(!rsx_vertex_pack(&plan, refs, 24, &packed)); // reject before reading an enormous span
+    assert(!rsx_vertex_pack(&plan, refs, 0, &packed));
+    rsx_vertex_pack_destroy(&packed);
+    free(source);
+    assert(!packed.data && !packed.size && !packed.capacity);
+    printf("PASS: %u snapshots, %u bit-identical vertices, sparse gather, overlapping ranges, immutable bytes and rejected invalid plans\n", cases, cases * 24);
+}
diff --git a/libs/video/tests/test_vertex_remap_cache.c b/libs/video/tests/test_vertex_remap_cache.c
new file mode 100644
index 0000000..b3a9ad1
--- /dev/null
+++ b/libs/video/tests/test_vertex_remap_cache.c
@@ -0,0 +1,115 @@
+/* Include the production helper to inject a hash collision deterministically.
+ * Output is checked against the original general hash-table implementation. */
+#include "../rsx_vertex_compact.c"
+#include <assert.h>
+#include <stdio.h>
+#include <time.h>
+
+static u32 rng = 0x845123u;
+static u32 random32(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+static rsx_vertex_ref source[65536], expected[65536], actual[65536];
+static rsx_vertex_remap oracle, work;
+static rsx_vertex_remap_cache cache;
+static u64 checked;
+
+static void compare(u32 count)
+{
+    memcpy(expected, source, count * sizeof(*source));
+    memcpy(actual, source, count * sizeof(*source));
+    u32 a = 0, b = 0;
+    assert(rsx_vertex_remap_build(&oracle, expected, count, &a));
+    assert(rsx_vertex_remap_build_cached(&cache, &work, actual, count, &b));
+    assert(a == b && !memcmp(expected, actual, a * sizeof(*source)));
+    for (u32 i = 0; i < count; ++i) {
+        assert(oracle.occurrence_to_unique[i] == work.occurrence_to_unique[i]);
+        assert(work.occurrence_to_unique[i] < b);
+        assert(!memcmp(&source[i], &actual[work.occurrence_to_unique[i]], sizeof(*source)));
+    }
+    assert(cache.bytes <= REMAP_CACHE_LIMIT);
+    checked += count;
+}
+
+int main(void)
+{
+    u32 result;
+    assert(!rsx_vertex_remap_build_cached(&cache, NULL, source, 24, &result));
+    assert(!rsx_vertex_remap_build_cached(&cache, &work, NULL, 24, &result));
+    assert(!rsx_vertex_remap_build_cached(&cache, &work, source, 24, NULL));
+    for (u32 trial = 0; trial < 3000; ++trial) {
+        u32 count = trial < 26 ? trial : (trial % 101 ? 24 + random32() % 2048 : 65536);
+        for (u32 i = 0; i < count; ++i)
+            source[i] = (rsx_vertex_ref){random32() & 1023u, trial};
+        if (trial % 3 == 0)
+            for (u32 i = 0; i < count; ++i) source[i].vertex_id = i;
+        if (count && trial % 7 == 0) source[count-1].base_index ^= 0xffffffffu;
+        if (count && trial % 11 == 0) source[count-1].vertex_id = 0xffffffffu;
+        const int room = cache.bytes + (size_t)count * 20u <= REMAP_CACHE_LIMIT;
+        compare(count);
+        /* Hit must restore output after an unrelated remap and after the
+         * caller's occurrence buffer has been destroyed/reallocated. */
+        rsx_vertex_remap_destroy(&work);
+        const u64 hits = cache.hits;
+        compare(count);
+        if (room && count >= 24 && count <= 16384) assert(cache.hits == hits + 1);
+        if (count) { source[count-1].base_index ^= 32u; compare(count); }
+    }
+    assert(cache.hits > 2000 && cache.misses > 2000 && cache.bypasses > 0);
+    rsx_vertex_remap_cache_destroy(&cache);
+
+    /* A 64-bit hash collision alone must not authorize reuse. Move the old
+     * snapshot to the changed input's bucket and force its hash to match. */
+    for (u32 i = 0; i < 96; ++i) source[i] = (rsx_vertex_ref){i % 12, 4};
+    compare(96);
+    remap_cache_entry* entries = cache.entries;
+    remap_cache_entry* old = NULL;
+    for (u32 i = 0; i < REMAP_CACHE_BUCKETS * REMAP_CACHE_WAYS; ++i)
+        if (entries[i].data) old = entries + i;
+    assert(old);
+    source[95].vertex_id = 57;
+    const u64 hash = XXH3_64bits(source, 96 * sizeof(*source));
+    remap_cache_entry* destination = entries +
+        (hash & (REMAP_CACHE_BUCKETS - 1u)) * REMAP_CACHE_WAYS;
+    if (destination != old) { *destination = *old; memset(old, 0, sizeof(*old)); }
+    destination->hash = hash;
+    compare(96);
+    assert(cache.hits == 0 && cache.misses == 2);
+    compare(96);
+    assert(cache.hits == 1);
+    rsx_vertex_remap_cache_destroy(&cache);
+
+    /* Keep inserting large distinct streams until the budget rejects a new
+     * snapshot; all requests must still produce the full correct remap. */
+    for (u32 trial = 0; trial < 140; ++trial) {
+        for (u32 i = 0; i < 16384; ++i)
+            source[i] = (rsx_vertex_ref){i % 512, 0x10000u + trial};
+        compare(16384);
+    }
+    assert(cache.bytes > (31u << 20) && cache.bytes <= REMAP_CACHE_LIMIT);
+    rsx_vertex_remap_cache_destroy(&cache);
+    assert(!cache.entries && !cache.bytes && !cache.hits);
+    compare(0); compare(1);
+    printf("PASS remap cache: %llu references, exact output/order, mutation, collision, eviction, capacity, reset\n",
+        (unsigned long long)checked);
+#ifdef REMAP_BENCH
+    for (u32 count = 96; count <= 8192; count = count == 96 ? 384 : count == 384 ? 2048 : count * 4) {
+        for (u32 i = 0; i < count; ++i) source[i] = (rsx_vertex_ref){random32() % (count / 3), 77};
+        for (int mode = 0; mode < 2; ++mode) {
+            struct timespec begin, end;
+            clock_gettime(CLOCK_THREAD_CPUTIME_ID, &begin);
+            for (u32 repeat = 0; repeat < 20000; ++repeat) {
+                memcpy(actual, source, count * sizeof(*source));
+                assert(mode ? rsx_vertex_remap_build_cached(&cache, &work, actual, count, &result)
+                            : rsx_vertex_remap_build_dense(&work, actual, count, &result));
+            }
+            clock_gettime(CLOCK_THREAD_CPUTIME_ID, &end);
+            double ns = (end.tv_sec - begin.tv_sec) * 1e9 + end.tv_nsec - begin.tv_nsec;
+            printf("count=%u mode=%s CPU_ns_per_ref=%.3f (includes input copy; not gameplay)\n",
+                count, mode ? "cached" : "dense", ns / (20000. * count));
+        }
+    }
+#endif
+    rsx_vertex_remap_cache_destroy(&cache);
+    rsx_vertex_remap_destroy(&oracle);
+    rsx_vertex_remap_destroy(&work);
+    return 0;
+}
diff --git a/libs/video/tests/test_vertex_remap_dense.c b/libs/video/tests/test_vertex_remap_dense.c
new file mode 100644
index 0000000..83eb12e
--- /dev/null
+++ b/libs/video/tests/test_vertex_remap_dense.c
@@ -0,0 +1,68 @@
+#include "rsx_vertex_compact.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+static u32 rng = 0x42813u;
+static u32 random32(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+static double now(void) {
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec + t.tv_nsec * 1e-9;
+}
+
+int main(void)
+{
+    const u32 capacity = 65536;
+    rsx_vertex_ref *source = malloc(capacity * sizeof(*source));
+    rsx_vertex_ref *a = malloc(capacity * sizeof(*a)), *b = malloc(capacity * sizeof(*b));
+    assert(source && a && b);
+    rsx_vertex_remap hash = {0}, dense = {0};
+    assert(!rsx_vertex_remap_build_dense(NULL, source, 1, &rng));
+    assert(!rsx_vertex_remap_build_dense(&dense, NULL, 1, &rng));
+    assert(!rsx_vertex_remap_build_dense(&dense, source, 1, NULL));
+    u64 checked = 0;
+    for (u32 trial = 0; trial < 4000; ++trial) {
+        u32 count = trial < 2 ? trial : (trial % 100 == 0 ? capacity : random32() % 4096);
+        const u32 base = random32();
+        for (u32 i = 0; i < count; ++i) {
+            source[i].base_index = base;
+            source[i].vertex_id = trial % 3 == 0 ? i : random32() & (trial % 3 == 1 ? 255u : 65535u);
+        }
+        /* Late fallback must not observe a partly overwritten input prefix. */
+        if (count && trial % 7 == 0) source[count-1].base_index ^= 1u;
+        if (count && trial % 11 == 0) source[count-1].vertex_id = 0xffffffffu;
+        if (count > 1 && trial % 13 == 0) source[count-1] = source[0];
+        if (trial % 97 == 0) dense.dense_generation = 0xffffffffu;
+        memcpy(a, source, count * sizeof(*a)); memcpy(b, source, count * sizeof(*b));
+        u32 na = 0, nb = 0;
+        assert(rsx_vertex_remap_build(&hash, a, count, &na));
+        assert(rsx_vertex_remap_build_dense(&dense, b, count, &nb));
+        assert(na == nb && memcmp(a, b, na * sizeof(*a)) == 0);
+        for (u32 i = 0; i < count; ++i) {
+            const u32 ia = rsx_vertex_remap_index(&hash, i), ib = rsx_vertex_remap_index(&dense, i);
+            assert(ia == ib && ib < nb);
+            assert(memcmp(&source[i], &b[ib], sizeof(*b)) == 0);
+        }
+        checked += count;
+    }
+    printf("PASS dense remap: 4000 groups, %llu references, fallback/order/rollover/reuse\n", (unsigned long long)checked);
+#ifdef REMAP_BENCH
+    const u32 count = 8192, iterations = 4000;
+    for (u32 i=0; i<count; ++i) source[i] = (rsx_vertex_ref){random32()%2048, 0x12345678};
+    volatile u32 sink = 0;
+    for (int mode = 0; mode < 2; ++mode) {
+        double begin = now();
+        for (u32 i=0; i<iterations; ++i) {
+            memcpy(a, source, count*sizeof(*a)); u32 unique;
+            assert((mode ? rsx_vertex_remap_build_dense : rsx_vertex_remap_build)(mode ? &dense : &hash, a, count, &unique));
+            sink += unique;
+        }
+        printf("%s %.2f ns/reference (includes source copy)\n", mode ? "dense" : "hash", (now()-begin)*1e9/(count*iterations));
+    }
+    (void)sink;
+#endif
+    rsx_vertex_remap_destroy(&hash); rsx_vertex_remap_destroy(&dense);
+    free(source); free(a); free(b); return 0;
+}
diff --git a/libs/video/tests/test_vp_metadata.c b/libs/video/tests/test_vp_metadata.c
new file mode 100644
index 0000000..3972b0d
--- /dev/null
+++ b/libs/video/tests/test_vp_metadata.c
@@ -0,0 +1,130 @@
+/* Differential tests of the real engine's byte-validated vertex cache. */
+#define main original_engine_tests_main
+#include "test_rsx_draw_engine.c"
+#undef main
+#include "../rsx_draw_engine.c"
+#include "rsx_test_programs.h"
+#include <assert.h>
+
+static u32 random_state=0x654321;
+static u32 random_word(void)
+{
+    random_state^=random_state<<13;random_state^=random_state>>17;
+    random_state^=random_state<<5;return random_state;
+}
+static u32 ordinary_mask(const u8* code,u32 instrs)
+{
+    rsx_vp_input_analysis a={0xFFFFu,0};
+    return rsx_vp_analyze_inputs(code,instrs*16u,&a)==(int)instrs && a.exact && a.input_mask
+        ? a.input_mask : 0xFFFFu;
+}
+static void compare(const u8* code,u32 instrs)
+{
+    const eng_vertex_metadata* m=eng_vertex_metadata_get(code,instrs);
+    assert(m && m->bytes==instrs*16u && !memcmp(m->code,code,m->bytes));
+    assert(m->hash==eng_fnv1a(code,instrs*16u,ENG_PROGRAM_HASH_SEED));
+    assert(m->input_mask==ordinary_mask(code,instrs));
+}
+static void differential(void)
+{
+    g.vp_meta_enabled=1;
+    u8 code[RSX_DSP_VP_INSTR*16u],other[sizeof code];
+    for(u32 trial=0;trial<2500;++trial) {
+        const u32 n=1+random_word()%RSX_DSP_VP_INSTR;
+        for(u32 i=0;i<n;++i)
+            rsx_test_vp_vec_out(code+i*16,random_word()%32,random_word()%16,
+                               (random_word()&255u)<<8,random_word()%16,i+1==n);
+        compare(code,n);
+        const u64 misses=g.vp_meta_misses,hits=g.vp_meta_hits;
+        memcpy(other,code,n*16u);compare(other,n);
+        assert(g.vp_meta_misses==misses && g.vp_meta_hits==hits+1);
+        /* Every byte is relevant to identity, including unsupported opcodes. */
+        for(u32 byte=0;byte<16;++byte) {
+            const u32 offset=(random_word()%n)*16u+byte;
+            code[offset]^=1;
+            compare(code,n);
+            code[offset]^=1;
+            compare(code,n);
+        }
+    }
+    for(u32 i=0;i<RSX_DSP_VP_INSTR;++i)
+        rsx_test_vp_mov_out(code+i*16,i%16,RSX_TEST_VP_SWZ_IDENT,0,i+1==RSX_DSP_VP_INSTR);
+    compare(code,RSX_DSP_VP_INSTR);
+    assert(!eng_vertex_metadata_get(NULL,1) && !eng_vertex_metadata_get(code,0) &&
+           !eng_vertex_metadata_get(code,RSX_DSP_VP_INSTR+1));
+
+    /* Force a selector collision: the full instruction comparison must win. */
+    rsx_test_vp_mov_out(code,0,RSX_TEST_VP_SWZ_IDENT,0,1);
+    rsx_test_vp_mov_out(other,1,RSX_TEST_VP_SWZ_IDENT,0,1);
+    const eng_vertex_metadata saved=*eng_vertex_metadata_get(code,1);
+    const u64 selector=XXH3_64bits(other,16);
+    eng_vertex_metadata* bucket=&g.vp_meta[(selector&(ENG_VP_CACHE_BUCKETS-1))*ENG_VP_CACHE_WAYS];
+    memset(bucket,0,ENG_VP_CACHE_WAYS*sizeof(*bucket));
+    bucket[0]=saved;bucket[0].selector=selector;
+    u64 misses=g.vp_meta_misses;
+    compare(other,1);
+    assert(g.vp_meta_misses==misses+1);
+
+    /* Three real programs in one two-way bucket exercise replacement. */
+    u8 colliding[3][16];u32 found=0;
+    memset(g.vp_meta,0,sizeof g.vp_meta);
+    for(u32 i=0;i<10000 && found<3;++i) {
+        rsx_test_vp_mov_out(code,i%16,((i/16)&255u)<<8,0,1);
+        if((XXH3_64bits(code,16)&(ENG_VP_CACHE_BUCKETS-1))==0)
+            memcpy(colliding[found++],code,16);
+    }
+    assert(found==3);
+    compare(colliding[0],1);compare(colliding[1],1);compare(colliding[0],1);
+    compare(colliding[2],1);misses=g.vp_meta_misses;
+    compare(colliding[1],1);assert(g.vp_meta_misses==misses+1);
+    g.vp_meta_enabled=0;assert(!eng_vertex_metadata_get(code,1));
+    memset(g.vp_meta,0,sizeof g.vp_meta);
+    g.vp_meta_serial=g.vp_meta_hits=g.vp_meta_misses=0;
+    puts("PASS: 2500 random programs, every instruction byte position, relocation, full hash collision, bucket eviction, maximum size, malformed/unsupported analysis and disabled cache");
+}
+static void install(const u8* code,u32 instrs,u32 start)
+{
+    m(0x1E9C,start);
+    for(u32 i=0;i<instrs*4;++i) {
+        u32 word;memcpy(&word,code+4*i,4);m(0xB80+(i%4)*4,word);
+    }
+    m(0x1EA0,start);m(0x1D60,64);
+}
+static void engine_case(int enabled)
+{
+    setenv("RSX_VP_METADATA_CACHE",enabled?"1":"0",1);
+    engine_up();
+    u8 code[32];rsx_vertex_layout_plan layout;
+    rsx_test_fp_mov_r0_col0(vm_base+TEX_OFFSET,RSX_TEST_FP_SWZ_IDENT);
+    m(0x8E4,TEX_OFFSET|2);
+    rsx_test_vp_mov_out(code,0,RSX_TEST_VP_SWZ_IDENT,0,1);
+    install(code,1,0);draw_triangle();
+    const u32 original=stub.bound_pipeline;
+    eng_vertex_layout(&layout);
+    CHECK(original && layout.mask==1,"original vertex program and compact input layout");
+    install(code,1,50);draw_triangle();
+    CHECK(stub.bound_pipeline==original,"moving program start preserves pipeline identity");
+    const u64 misses=g.vp_meta_misses;
+    g.rsx.constants[0][0]^=0x40000000;
+    draw_triangle();
+    CHECK(stub.bound_pipeline==original && g.vp_meta_misses==misses,
+          "changing live transform constants preserves program identity");
+    rsx_test_vp_mov_out(code,0,RSX_TEST_VP_SWZ_IDENT,0,0);
+    rsx_test_vp_mov_out(code+16,1,RSX_TEST_VP_SWZ_IDENT,1,1);
+    install(code,2,50);draw_triangle();eng_vertex_layout(&layout);
+    CHECK(stub.bound_pipeline!=original && layout.mask==3,"moving END and adding an input invalidates cached results");
+    rsx_test_vp_mov_out(code,0,RSX_TEST_VP_SWZ_IDENT,0,1);
+    install(code,1,50);draw_triangle();
+    CHECK(stub.bound_pipeline==original,"shortening program restores original pipeline");
+    CHECK(enabled ? g.vp_meta_hits>0 : !g.vp_meta_hits,"cache is actually used only when enabled");
+    engine_down();
+    CHECK(!g.vp_meta_hits && !g.vp_meta_misses && !g.vp_meta_serial,"shutdown invalidates vertex metadata");
+}
+int main(void)
+{
+    differential();
+    vm_base=calloc(1,GUEST_BYTES);assert(vm_base);ppu_vm_size=GUEST_BYTES;
+    engine_case(0);engine_case(1);engine_case(1);
+    free(vm_base);
+    return g_failures?1:0;
+}
diff --git a/runtime/memory/guest_read_sync.c b/runtime/memory/guest_read_sync.c
new file mode 100644
index 0000000..328ad0b
--- /dev/null
+++ b/runtime/memory/guest_read_sync.c
@@ -0,0 +1,47 @@
+#include "../../include/ps3emu/guest_read_sync.h"
+unsigned char ps3_gpu_dirty_pages[1u << 20];
+/* Fine dirty state underneath the existing inline page check. One bit per
+ * 64 guest bytes is 8 MiB of virtual BSS; only GPU-backed pages are touched.
+ * Page flags stay armed, avoiding a clear-vs-redraw race with CPU readers. */
+static uint64_t dirty_lines[1u << 20];
+static void (*sync_handler)(uint32_t, uint32_t);
+static uint64_t line_mask(uint32_t first, uint32_t last) {
+    return (UINT64_MAX << first) & (UINT64_MAX >> (63u - last));
+}
+void ps3_gpu_sync_set_handler(void (*handler)(uint32_t, uint32_t)) {
+    __atomic_store_n(&sync_handler, handler, __ATOMIC_RELEASE);
+}
+void ps3_gpu_sync_dispatch(uint32_t a, uint32_t n) {
+    if (!n || (uint64_t)a + n > 0x100000000ull) return;
+    uint32_t first = a >> 12, last = (uint32_t)(((uint64_t)a + n - 1) >> 12);
+    int dirty = 0;
+    for (uint32_t p = first; p <= last; ++p) {
+        uint32_t lo = p == first ? (a >> 6) & 63u : 0u;
+        uint32_t hi = p == last ? (uint32_t)(((uint64_t)a + n - 1) >> 6) & 63u : 63u;
+        if (__atomic_load_n(&dirty_lines[p], __ATOMIC_ACQUIRE) & line_mask(lo, hi)) {
+            dirty = 1; break;
+        }
+    }
+    if (!dirty) return;
+    void (*h)(uint32_t, uint32_t) = __atomic_load_n(&sync_handler, __ATOMIC_ACQUIRE);
+    if (h) h(a, n);
+}
+void ps3_gpu_sync_mark(uint32_t a, uint32_t n, int dirty) {
+    if (!n || (uint64_t)a + n > 0x100000000ull) return;
+    /* Mark every touched line dirty; clear only lines completely synchronized.
+     * A partial-row read must not expose a dirty neighbour in the same page. */
+    uint64_t lo = dirty ? a / 64u : ((uint64_t)a + 63u) / 64u;
+    uint64_t end = dirty ? ((uint64_t)a + n + 63u) / 64u : ((uint64_t)a + n) / 64u;
+    if (lo >= end) return;
+    for (uint32_t p = (uint32_t)(lo / 64u); p <= (end - 1u) / 64u; ++p) {
+        uint32_t first = p == lo / 64u ? (uint32_t)lo & 63u : 0u;
+        uint32_t last = p == (end - 1u) / 64u ? (uint32_t)(end - 1u) & 63u : 63u;
+        uint64_t mask = line_mask(first, last);
+        if (dirty) {
+            __atomic_fetch_or(&dirty_lines[p], mask, __ATOMIC_RELEASE);
+            __atomic_store_n(&ps3_gpu_dirty_pages[p], 1, __ATOMIC_RELEASE);
+        } else {
+            __atomic_fetch_and(&dirty_lines[p], ~mask, __ATOMIC_RELEASE);
+        }
+    }
+}
diff --git a/runtime/platform/apple_game_qos.h b/runtime/platform/apple_game_qos.h
new file mode 100644
index 0000000..6506bc4
--- /dev/null
+++ b/runtime/platform/apple_game_qos.h
@@ -0,0 +1,33 @@
+#ifndef PS3_APPLE_GAME_QOS_H
+#define PS3_APPLE_GAME_QOS_H
+
+/* Optional host scheduling experiment. Call once at a gameplay thread's
+ * entry, never inside a job. This leaves guest priority and scheduling
+ * semantics alone and does not select a physical CPU core.
+ * Apple: https://developer.apple.com/videos/play/tech-talks/110147/
+ * Do not combine with pthread_setschedparam, which opts out of QoS. */
+#ifdef __APPLE__
+#include <pthread.h>
+#include <pthread/qos.h>
+#include <stdio.h>
+#include <stdlib.h>
+static inline void ps3_apple_game_qos(const char* role, int frame_critical)
+{
+    const char* enabled = getenv("PS3_GAMEPLAY_QOS");
+    if (!enabled || atoi(enabled) == 0) return;
+    int before_rel = 0, after_rel = 0;
+    qos_class_t before = QOS_CLASS_UNSPECIFIED, after = QOS_CLASS_UNSPECIFIED;
+    pthread_get_qos_class_np(pthread_self(), &before, &before_rel);
+    qos_class_t requested = frame_critical ? QOS_CLASS_USER_INTERACTIVE
+                                           : QOS_CLASS_USER_INITIATED;
+    int rc = pthread_set_qos_class_self_np(requested, 0);
+    pthread_get_qos_class_np(pthread_self(), &after, &after_rel);
+    fprintf(stderr, "[host qos] %s before=%u/%d requested=%u actual=%u/%d rc=%d\n",
+            role, (unsigned)before, before_rel, (unsigned)requested,
+            (unsigned)after, after_rel, rc);
+}
+#else
+static inline void ps3_apple_game_qos(const char* role, int frame_critical)
+{ (void)role; (void)frame_critical; }
+#endif
+#endif
diff --git a/runtime/spu/tests/test_dispatch_checks.c b/runtime/spu/tests/test_dispatch_checks.c
new file mode 100644
index 0000000..72a82c2
--- /dev/null
+++ b/runtime/spu/tests/test_dispatch_checks.c
@@ -0,0 +1,72 @@
+/* Differentially compare release transfers with the complete diagnostic hook. */
+#include "../spu_drain.c"
+#include <assert.h>
+#include <time.h>
+static jmp_buf stop;
+static unsigned stack_switches;
+static void switches_stack(spu_context* ctx) { (void)ctx; }
+void spu_check_stack_reset(spu_context* ctx,void (*fn)(spu_context*))
+{
+    if(ctx->host_depth && !ctx->policy_mode && fn==switches_stack) {
+        ++stack_switches;longjmp(stop,2);
+    }
+}
+void spu_halt(spu_context* ctx) { ctx->status=0x1234;longjmp(stop,1); }
+static int invoke(spu_context* ctx,int fast,void* fn)
+{
+    int result=setjmp(stop);
+    if(!result) {
+        if(fast)spu_task_launch_check(ctx,fn);
+        else spu_task_launch_slow(ctx,fn);
+    }
+    return result;
+}
+static double clock_s(void)
+{
+    struct timespec t;clock_gettime(CLOCK_THREAD_CPUTIME_ID,&t);
+    return t.tv_sec+t.tv_nsec*1e-9;
+}
+__attribute__((noinline)) static double bench(spu_context* ctx,int fast)
+{
+    double start=clock_s();
+    for(unsigned i=0;i<5000000;++i) {
+        ctx->pc=0x4000+(i&255)*4;
+        if(fast)spu_task_launch_check(ctx,NULL);else spu_task_launch_slow(ctx,NULL);
+    }
+    return clock_s()-start;
+}
+int main(void)
+{
+    setenv("SPU_FAST_DISPATCH","1",1);
+    assert(spu_fast_dispatch_init()==1);
+    spu_context* a=calloc(1,sizeof *a);spu_context* b=calloc(1,sizeof *b);assert(a&&b);
+    for(unsigned i=0;i<2048;++i) {
+        memset(a,0,sizeof *a);
+        a->pc=(i%5==0)?0:((i%7==0)?SPU_LS_SIZE:0x4000+i*4);
+        a->steps=i%3==0?0:i;
+        a->image_id=(i%3==0)?0:900;a->policy_mode=i&1;
+        a->host_depth=(i%4);a->gpr[3]._u32[0]=0x12345678;
+        memcpy(b,a,sizeof *b);
+        void* fn=i%11==0?(void*)switches_stack:NULL;
+        int reference=invoke(a,0,fn),candidate=invoke(b,1,fn);
+        assert(reference==candidate && !memcmp(a,b,sizeof *a));
+    }
+    assert(stack_switches);
+    memset(a,0,sizeof *a);a->pc=0x1234;a->policy_mode=1;
+    g_pm_flow_ctx=a;g_pm_flow_n=0;
+    assert(!invoke(a,1,NULL) && g_pm_flow_n==1 && g_pm_flow_buf[0]==0x1234);
+    g_pm_flow_ctx=NULL;
+    uint32_t recent[32];assert(!spu_recent_pcs(recent,32));
+    /* Every existing observation/compatibility option forces the full path,
+     * even a value of zero: some legacy switches use presence semantics. */
+    const char* probes[]={"MOTORSTORM_WWS_WAIT_TRACE","SPU_NO_LS0_END",
+        "SPU_EXITTRACE","SPU_STEPTRACE","SPU_STEPTRACE_FROM","SPU_JOBDRAIN"};
+    for(unsigned i=0;i<sizeof probes/sizeof probes[0];++i) {
+        setenv(probes[i],"0",1);assert(!spu_fast_dispatch_init());unsetenv(probes[i]);
+    }
+    assert(spu_fast_dispatch_init()==1);
+    memset(a,0,sizeof *a);a->image_id=900;a->host_depth=4;a->policy_mode=1;
+    double slow=bench(a,0),fast=bench(a,1);
+    printf("PASS: 2048 identical contexts/exits, stack switches, flow capture and probe fallback; 5M policy transfers %.3f -> %.3f s (%.2fx)\n",slow,fast,slow/fast);
+    free(a);free(b);return 0;
+}
diff --git a/runtime/spu/tests/test_spu_lockline_host.c b/runtime/spu/tests/test_spu_lockline_host.c
new file mode 100644
index 0000000..104f4d8
--- /dev/null
+++ b/runtime/spu/tests/test_spu_lockline_host.c
@@ -0,0 +1,83 @@
+/* Real runtime lock, synthetic 128-byte shared payload. No game or GPU. */
+#include "spu_coherency.h"
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+/* The fixture does not register reservation holders. */
+void spu_ch_wake(spu_context* ctx) { (void)ctx; }
+
+enum { MAX_WORKERS = 8, WORDS = 16 };
+static pthread_mutex_t gate_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t gate_changed = PTHREAD_COND_INITIALIZER;
+static unsigned ready, started, iterations, delayed;
+static uint64_t payload[WORDS], completed[MAX_WORKERS];
+static uint64_t check_word(uint64_t n, unsigned i) { return n ^ (UINT64_C(0x9e3779b97f4a7c15) * i); }
+
+static uint64_t now(clockid_t clock)
+{
+    struct timespec t;
+    assert(!clock_gettime(clock, &t));
+    return (uint64_t)t.tv_sec * 1000000000ull + t.tv_nsec;
+}
+
+static void* worker(void* argument)
+{
+    const uintptr_t id = (uintptr_t)argument;
+    assert(!pthread_mutex_lock(&gate_lock));
+    ready++;
+    assert(!pthread_cond_broadcast(&gate_changed));
+    while (!started) assert(!pthread_cond_wait(&gate_changed, &gate_lock));
+    assert(!pthread_mutex_unlock(&gate_lock));
+    for (unsigned n = 0; n < iterations; ++n) {
+        spu_lockline_lock();
+        const uint64_t prior = payload[0];
+        for (unsigned i = 1; i < WORDS; ++i) assert(payload[i] == check_word(prior, i));
+        /* Model a lock holder that loses its CPU. This is deliberately a
+         * stress case, not an estimate of the game's critical-section cost. */
+        if (delayed && id == 0 && n % 100 == 0) {
+            const struct timespec delay = {.tv_sec = 0, .tv_nsec = 2000000};
+            assert(!nanosleep(&delay, NULL));
+        }
+        for (unsigned i = 0; i < WORDS; ++i) payload[i] = check_word(prior + 1, i);
+        completed[id]++;
+        spu_lockline_unlock();
+    }
+    return NULL;
+}
+
+int main(int argc, char** argv)
+{
+    assert(argc == 4);
+    unsigned workers = (unsigned)strtoul(argv[1], NULL, 10);
+    iterations = (unsigned)strtoul(argv[2], NULL, 10);
+    delayed = (unsigned)strtoul(argv[3], NULL, 10);
+    assert(workers && workers <= MAX_WORKERS && iterations);
+    for (unsigned i = 0; i < WORDS; ++i) payload[i] = check_word(0, i);
+    pthread_t threads[MAX_WORKERS];
+    for (uintptr_t i = 0; i < workers; ++i) assert(!pthread_create(&threads[i], NULL, worker, (void*)i));
+    assert(!pthread_mutex_lock(&gate_lock));
+    while (ready != workers) assert(!pthread_cond_wait(&gate_changed, &gate_lock));
+    const uint64_t wall = now(CLOCK_MONOTONIC), cpu = now(CLOCK_PROCESS_CPUTIME_ID);
+    started = 1;
+    assert(!pthread_cond_broadcast(&gate_changed));
+    assert(!pthread_mutex_unlock(&gate_lock));
+    for (unsigned i = 0; i < workers; ++i) assert(!pthread_join(threads[i], NULL));
+    const double cpu_ms = (now(CLOCK_PROCESS_CPUTIME_ID)-cpu)/1e6;
+    const double wall_ms = (now(CLOCK_MONOTONIC)-wall)/1e6;
+    assert(payload[0] == (uint64_t)workers * iterations);
+    for (unsigned i = 0; i < WORDS; ++i) assert(payload[i] == check_word(payload[0], i));
+    for (unsigned i = 0; i < workers; ++i) assert(completed[i] == iterations);
+    /* Configuration is latched even if a later caller changes its environment. */
+    const char* mode = getenv("SPU_LOCKLINE_HOST");
+    setenv("SPU_LOCKLINE_HOST", mode && !strcmp(mode, "1") ? "0" : "1", 1);
+    spu_lockline_lock();
+    spu_lockline_unlock();
+    printf("{\"workers\":%u,\"operations\":%llu,\"delayed_holder\":%s,\"cpu_ms\":%.6f,\"wall_ms\":%.6f}\n",
+           workers, (unsigned long long)payload[0], delayed ? "true" : "false", cpu_ms, wall_ms);
+    return 0;
+}
diff --git a/runtime/spu/tests/test_spu_mfc_owner_cache.c b/runtime/spu/tests/test_spu_mfc_owner_cache.c
new file mode 100644
index 0000000..33c6864
--- /dev/null
+++ b/runtime/spu/tests/test_spu_mfc_owner_cache.c
@@ -0,0 +1,71 @@
+/* Exercise actual engine lifetime across owners, including an allocator ABA.
+ * No engine may be retired while its execution owner is using it. */
+#include "../../platform/win32_compat.h"
+#include <stdatomic.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+static atomic_int directory_reads;
+static void counted_read(SRWLOCK* lock)
+{
+    atomic_fetch_add(&directory_reads, 1);
+    AcquireSRWLockShared(lock);
+}
+#define AcquireSRWLockShared counted_read
+#define main registry_previous_main
+#include "test_spu_mfc_slots.c"
+#undef main
+#undef AcquireSRWLockShared
+
+struct retire_request { spu_context* ctx; int range; };
+static void* retire(void* opaque)
+{
+    struct retire_request* r = opaque;
+    if (r->range)
+        spu_mfc_forget_range((uintptr_t)r->ctx, (uintptr_t)(r->ctx + 1));
+    else
+        spu_mfc_release(r->ctx);
+    /* Immediately reuse the exact context address. The caller's TLS still
+     * remembers its previous engine. Leave non-default state for it to find. */
+    mfc_for(r->ctx)->tag_completed = 0x12345678;
+    return NULL;
+}
+int main(void)
+{
+    setenv("SPU_MFC_OWNER_CACHE", "1", 1);
+    if (registry_previous_main()) return 1;
+    CHECK(s_mfc_slots == NULL);
+    spu_context* ctx = calloc(1, sizeof(*ctx));
+    CHECK(ctx != NULL);
+    mfc_engine* engine = mfc_for(ctx);
+    engine->tag_completed = 0x01020304;
+    atomic_store(&directory_reads, 0);
+    for (int i = 0; i < 1000000; ++i) {
+        if (mfc_for(ctx) != engine) { CHECK(0); break; }
+    }
+    CHECK(atomic_load(&directory_reads) == 0);
+    CHECK(engine->tag_completed == 0x01020304);
+
+    for (int range = 0; range < 2; ++range) {
+        engine->tag_completed = 0xAABBCCDD;
+        struct retire_request request = {ctx, range};
+        pthread_t thread;
+        CHECK(pthread_create(&thread, NULL, retire, &request) == 0);
+        /* The execution owner is quiescent until join; another thread may
+         * retire it, and its address may now identify a different lifetime. */
+        CHECK(pthread_join(thread, NULL) == 0);
+        atomic_store(&directory_reads, 0);
+        engine = mfc_for(ctx);
+        CHECK(atomic_load(&directory_reads) == 1);
+        CHECK(engine->tag_completed == 0x12345678);
+    }
+    spu_mfc_release(ctx);
+    engine = mfc_for(ctx);
+    CHECK(engine->tag_completed == 0xFFFFFFFFu);
+    CHECK(engine->queue_count == 0);
+    spu_mfc_release(ctx);
+    free(ctx);
+    CHECK(s_mfc_slots == NULL);
+    printf("SPU MFC owner cache: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/tests/test_ftrace_trigger.c b/tests/test_ftrace_trigger.c
new file mode 100644
index 0000000..d65ea4d
--- /dev/null
+++ b/tests/test_ftrace_trigger.c
@@ -0,0 +1,88 @@
+/* Synthetic tracing contract: no game, GPU, UI, or wall-clock waits needed. */
+#include "ps3emu/ps3_ftrace.h"
+#include <assert.h>
+#include <pthread.h>
+#include <sched.h>
+
+static int ready, go;
+
+static void* poller(void* unused)
+{
+    (void)unused;
+    __atomic_fetch_add(&ready, 1, __ATOMIC_RELEASE);
+    while (!__atomic_load_n(&go, __ATOMIC_ACQUIRE)) sched_yield();
+    for (int i=0;i<100;i++) ps3_ft_poll_trigger();
+    return NULL;
+}
+
+static void write_trigger(const char* value)
+{
+    FILE* f=fopen("trigger","w");
+    assert(f);
+    assert(fputs(value,f)>=0);
+    assert(fclose(f)==0);
+}
+
+int main(int argc, char** argv)
+{
+    assert(argc==2);
+    const int legacy=strcmp(argv[1],"legacy")==0;
+    const int pending=strcmp(argv[1],"pending")==0;
+    const int disabled=strcmp(argv[1],"disabled")==0;
+    if (disabled) {
+        assert(!PS3_FT_ON());
+        ps3_ft_poll_trigger();
+        assert(!ps3_ft_capture_paused());
+        assert(!g_ps3_ft.buf && g_ps3_ft.on==3);
+        return 0;
+    }
+    assert(PS3_FT_ON()==legacy);
+    ps3_ft_name(7,"Havok worker");
+    assert(!strcmp(g_ps3_ft.names[7],"Havok worker"));
+    assert(!ps3_ft_capture_paused());
+    if (!legacy) {
+        assert(g_ps3_ft.on==4);
+        /* Missing and neutral trigger files leave all hooks inactive. */
+        ps3_ft_poll_trigger();
+        write_trigger("0\n");
+        ps3_ft_poll_trigger();
+        assert(!PS3_FT_ON());
+        ps3_ft_span(PS3_FT_PRESENT,0,0,0,g_ps3_ft.start,g_ps3_ft.start);
+        ps3_ft_usleep(7,0x123,g_ps3_ft.start,g_ps3_ft.start+1);
+        assert(g_ps3_ft.n==0 && g_ps3_ft.us[7].n==0);
+        if (pending) return 0;
+        write_trigger("1\n");
+        uint64_t before=ps3_ft_now();
+        pthread_t threads[8];
+        for (int i=0;i<8;i++) assert(!pthread_create(&threads[i],NULL,poller,NULL));
+        while (__atomic_load_n(&ready,__ATOMIC_ACQUIRE)!=8) sched_yield();
+        __atomic_store_n(&go,1,__ATOMIC_RELEASE);
+        for (int i=0;i<8;i++) assert(!pthread_join(threads[i],NULL));
+        uint64_t after=ps3_ft_now();
+        assert(g_ps3_ft.start>=before+2000000000ull);
+        assert(g_ps3_ft.start<=after+2000000000ull);
+        assert(g_ps3_ft.end-g_ps3_ft.start==3000000000ull);
+        assert(ps3_ft_capture_paused()); /* Includes the 2-second lead-in. */
+        unsigned long long base,start,end;
+        FILE* f=fopen("trigger.ack","r");
+        assert(f);
+        assert(fscanf(f,"{\"base_ns\":%llu,\"start_ns\":%llu,\"end_ns\":%llu}",
+                      &base,&start,&end)==3);
+        fclose(f);
+        assert(base==g_ps3_ft.base && start==g_ps3_ft.start && end==g_ps3_ft.end);
+        ps3_ft_poll_trigger();
+        assert(g_ps3_ft.start==start && g_ps3_ft.end==end); /* Cannot re-arm. */
+    }
+    assert(PS3_FT_ON());
+    uint64_t start=g_ps3_ft.start, end=g_ps3_ft.end;
+    ps3_ft_span(PS3_FT_PRESENT,0,0,0,start-2,start-1);
+    assert(g_ps3_ft.n==0);
+    ps3_ft_span(PS3_FT_PRESENT,0,0,0,start+1,start+1);
+    assert(g_ps3_ft.n==1);
+    ps3_ft_span(PS3_FT_PRESENT,0,0,0,end+1,end+1);
+    assert(g_ps3_ft.dumped && g_ps3_ft.on==3);
+    assert(!ps3_ft_capture_paused() && !PS3_FT_ON());
+    ps3_ft_poll_trigger();
+    assert(g_ps3_ft.start==start && g_ps3_ft.end==end && g_ps3_ft.n==1);
+    return 0;
+}
