@@ -369,5 +370,38 @@ def test_const_base_needs_constant():
     check("non-constant base is not a constant-base jump", got, None)
 
 
+def test_spilled_toc_base():
+    """A loop restores its base from the stack, then overwrites it with target.
+
+    This is the MotorStorm Havok dispatcher shape. The two-level pointer is
+    spilled before the loop; entry offsets remain local jumps in that frame.
+    """
+    table, mid = 0x11000, 0x200000
+    mem = {TOC + 8: mid, mid - 16: table, TOC + 16: table,
+           table: 0x100, table + 4: 0x200, table + 8: 0x300}
+    tail = [w_ld(6, 1, -200), w_cmplwi(0, 7, 2), w_slwi(9, 7, 2),
+            w_lwzx(0, 9, 6), w_add(6, 0, 6), w_mtctr(6), w_bctr()]
+    two = [w_lwz(30, 2, 8), w_lwz(5, 30, -16), w_std(5, 1, -200)]
+    one = [w_lwz(5, 2, 16), w_std(5, 1, -200)]
+    want = [0x11100, 0x11200, 0x11300]
+    check("two-level spilled base with destructive add", discover(two + tail, mem), want)
+    check("one-level spilled base with destructive add", discover(one + tail, mem), want)
+    check("non-overlapping stack store preserves spilled base",
+          discover(two + [w_std(4, 1, -208)] + tail, mem), want)
+    check("reject source clobbered by call before spill",
+          discover(two[:2] + [w_b(0x400) | 1] + two[2:] + tail, mem), None)
+    for label, middle in [
+        ("overlapping store", [w_std(4, 1, -196)]),
+        ("unknown store alias", [w_std(4, 3, 0)]),
+        ("stack adjustment", [w_stdu(1, 1, -256)]),
+        ("call", [w_b(0x400) | 1]),
+    ]:
+        check("reject spilled base after " + label,
+              discover(two + middle + tail, mem), None)
+    # Branch before the store can jump directly to the reload.
+    bypass = two[:2] + [w_bc(12, 2, 8)] + two[2:] + tail
+    check("reject branch bypassing the spill", discover(bypass, mem), None)
+
+
 if __name__ == "__main__":
     sys.exit(main())
