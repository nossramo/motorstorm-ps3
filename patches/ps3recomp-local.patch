+/* Capture complete present-to-present Metal work, including intermediate
+ * commits. Opt-in diagnostics only; the resulting trace excludes PPU/RSX
+ * CPU execution and is replayed by Xcode, not a game save state. */
+static void eng_capture_boundary(void)
+{
+    const char* path = getenv("PS3RECOMP_METAL_GPU_TRACE");
+    if (!path || !*path) return;
+    static double first_present;
+    static int state, remaining;
+    if (state == 2) return;
+    MTLCaptureManager* manager = [MTLCaptureManager sharedCaptureManager];
+    if (state == 1) {
+        if (--remaining > 0) return;
+        [manager stopCapture]; state = 2;
+        fprintf(stderr, "[metal capture] saved %s\n", path);
+        return;
+    }
+    const double now = CACurrentMediaTime();
+    if (!first_present) first_present = now;
+    const char* delay = getenv("PS3RECOMP_METAL_GPU_TRACE_AFTER");
+    if (now-first_present < (delay ? atof(delay) : 140.0)) return;
+    /* Optional external latch: arm only after observing the intended scene.
+     * A wall-clock script can miss menu transitions while shaders compile. */
+    const char* trigger = getenv("PS3RECOMP_METAL_GPU_TRACE_TRIGGER");
+    if (trigger && *trigger) {
+        FILE* f = fopen(trigger, "rb");
+        if (!f) return;
+        int armed = fgetc(f) == '1';
+        fclose(f);
+        if (!armed) return;
+    }
+    state = 2; /* report failure once, never retry every frame */
+    if (![manager supportsDestination:MTLCaptureDestinationGPUTraceDocument]) {
+        fprintf(stderr, "[metal capture] file capture unavailable; launch with MTL_CAPTURE_ENABLED=1\n");
+        return;
+    }
+    MTLCaptureDescriptor* desc = [MTLCaptureDescriptor new];
+    desc.captureObject = s_dev;
+    desc.destination = MTLCaptureDestinationGPUTraceDocument;
+    desc.outputURL = [NSURL fileURLWithPath:[NSString stringWithUTF8String:path]];
+    NSError* error = nil;
+    if (![manager startCaptureWithDescriptor:desc error:&error]) {
+        fprintf(stderr, "[metal capture] failed: %s\n", error.localizedDescription.UTF8String);
+        return;
+    }
+    const char* frames = getenv("PS3RECOMP_METAL_GPU_TRACE_FRAMES");
+    remaining = frames ? atoi(frames) : 1;
+    if (remaining < 1) remaining = 1;
+    if (remaining > 120) remaining = 120;
+    state = 1;
+    fprintf(stderr, "[metal capture] capturing %d complete frame(s)\n", remaining);
+}
