+static void test_compressed_volume(void)
+{
+    for(u32 fmt=0x86;fmt<=0x88;++fmt) {
+        engine_up();stub.check_bc_volume=1;
+        rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+        const u32 levels=rsx_texture_mip_chain(fmt,32,32,6,0,lv);
+        u8* dst=vm_base+GUEST_LOCAL_EA+0x300000;
+        u32 depth=16;
+        for(u32 mip=0;mip<levels;++mip) {
+            const rsx_tex_layout* tl=&lv[mip].tl;
+            for(u32 z=0;z<depth;++z) {
+                for(u32 b=0;b<tl->face_bytes;b+=tl->block_bytes) {
+                    u8* block=dst+z*tl->face_bytes+b;
+                    memset(block,0,tl->block_bytes);
+                    if(fmt==0x87) memset(block,(z%16)*17,8);
+                    if(fmt==0x88) block[0]=123;
+                    const u16 rgb[3]={0xf800,0x07e0,0x001f};
+                    const u16 color=rgb[(z+mip)%3];
+                    u8* c=block+(fmt==0x86 ? 0 : 8);
+                    c[0]=(u8)color;c[1]=(u8)(color>>8);
+                }
+            }
+            dst+=tl->face_bytes*depth;
+            if(depth>1)depth>>=1;
+        }
+        bind_texture_unit(RSX_LOCATION_LOCAL,0x300000);
+        m(M_TEX_UNIT+4,1u|(3u<<4)|(fmt<<8)|(6u<<16));
+        m(M_TEX_UNIT+0x18,(32u<<16)|32u);m(0x1840,16u<<20);
+        draw_triangle();
+        CHECK(stub.n_volume_create==1 && stub.n_volume_upload==32 && !stub.n_texture_create,
+              "BC%u volume uploads all 32 slices over six mips, no 2D fallback",fmt-0x85);
+        draw_triangle();
+        CHECK(stub.n_volume_create==1 && stub.n_volume_upload==32,"unchanged compressed volume reuses decoded data");
+        engine_down();
+    }
+}
