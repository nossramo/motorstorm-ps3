diff --git a/include/ps3emu/guest_read_sync.h b/include/ps3emu/guest_read_sync.h
new file mode 100644
index 0000000..bf047b0
--- /dev/null
+++ b/include/ps3emu/guest_read_sync.h
@@ -0,0 +1,25 @@
+/* On-demand GPU visibility for recompiled CPU reads. Inspired by the page
+ * tracking seam in robbe1912/motorstorm-mv-recomp; independently implemented
+ * for the register-file renderer and its host-thread service queue. */
+#ifndef PS3_GUEST_READ_SYNC_H
+#define PS3_GUEST_READ_SYNC_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern unsigned char ps3_gpu_dirty_pages[1u << 20];
+void ps3_gpu_sync_dispatch(uint32_t address, uint32_t bytes);
+void ps3_gpu_sync_set_handler(void (*handler)(uint32_t, uint32_t));
+void ps3_gpu_sync_mark(uint32_t address, uint32_t bytes, int dirty);
+static inline void ps3_gpu_read_sync(uint32_t address, uint32_t bytes) {
+    if (!bytes || (uint64_t)address + bytes > 0x100000000ull) return;
+    uint32_t last = (uint32_t)(((uint64_t)address + bytes - 1) >> 12);
+    for (uint32_t p = address >> 12; p <= last; ++p)
+        if (__atomic_load_n(&ps3_gpu_dirty_pages[p], __ATOMIC_ACQUIRE)) {
+            ps3_gpu_sync_dispatch(address, bytes); return;
+        }
+}
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/input/macos_keyboard_map.h b/libs/input/macos_keyboard_map.h
new file mode 100644
index 0000000..191c6b1
--- /dev/null
+++ b/libs/input/macos_keyboard_map.h
@@ -0,0 +1,124 @@
+/* Pure mapping helpers shared by the Metal keyboard bridge and its tests. */
+#ifndef PS3RECOMP_MACOS_KEYBOARD_MAP_H
+#define PS3RECOMP_MACOS_KEYBOARD_MAP_H
+
+#include <stdint.h>
+
+typedef struct MacKeyboardPadState {
+    uint16_t buttons;
+    uint8_t left_x, left_y, right_x, right_y;
+    uint8_t enter_down, escape_down;
+} MacKeyboardPadState;
+
+typedef enum MacKeyboardContext {
+    MAC_KEYBOARD_CONTEXT_UNKNOWN = 0,
+    MAC_KEYBOARD_CONTEXT_BOOT,
+    MAC_KEYBOARD_CONTEXT_FRONTEND,
+    MAC_KEYBOARD_CONTEXT_GAMEPLAY,
+    MAC_KEYBOARD_CONTEXT_PAUSE
+} MacKeyboardContext;
+
+typedef enum MacKeyboardKeyEvent {
+    MAC_KEY_EVENT_DOWN,
+    MAC_KEY_EVENT_UP
+} MacKeyboardKeyEvent;
+
+/* Repeated key-down and release events are idempotent. */
+static inline void mac_keyboard_apply_event(uint64_t keys[2], unsigned key,
+                                            MacKeyboardKeyEvent event)
+{
+    if (key >= 128) return;
+    const unsigned word = key / 64;
+    const uint64_t bit = UINT64_C(1) << (key % 64);
+    if (event == MAC_KEY_EVENT_DOWN) {
+        keys[word] |= bit;
+    } else if (event == MAC_KEY_EVENT_UP) {
+        keys[word] &= ~bit;
+    }
+}
+
+/* Read the actual left-device modifier state; toggling on flagsChanged
+ * would turn a release after focus loss into a stuck handbrake. */
+static inline void mac_keyboard_apply_modifiers(uint64_t keys[2], int left_shift)
+{
+    mac_keyboard_apply_event(keys, 56, left_shift ? MAC_KEY_EVENT_DOWN : MAC_KEY_EVENT_UP);
+}
+
+static inline void mac_keyboard_clear(uint64_t keys[2])
+{
+    keys[0] = keys[1] = 0;
+}
+
+/* Consume keys held through a menu/race transition until each is released.
+ * This prevents an arrow used to select a menu item from becoming throttle. */
+static inline void mac_keyboard_context_transition(MacKeyboardContext context,
+    MacKeyboardContext *previous, uint64_t keys[2], uint64_t blocked[2])
+{
+    if (*previous != context) {
+        blocked[0] |= keys[0];
+        blocked[1] |= keys[1];
+        *previous = context;
+    }
+    blocked[0] &= keys[0];
+    blocked[1] &= keys[1];
+}
+
+static inline int mac_keyboard_held(uint64_t lo, uint64_t hi, unsigned key)
+{
+    if (key < 64) return (int)((lo >> key) & 1u);
+    if (key < 128) return (int)((hi >> (key - 64)) & 1u);
+    return 0;
+}
+
+static inline uint8_t mac_keyboard_axis(uint64_t lo, uint64_t hi,
+                                        unsigned negative_key, unsigned positive_key)
+{
+    const int negative = mac_keyboard_held(lo, hi, negative_key);
+    const int positive = mac_keyboard_held(lo, hi, positive_key);
+    return negative == positive ? 128 : negative ? 0 : 255;
+}
+
+static inline MacKeyboardPadState mac_keyboard_pad_state(uint64_t lo, uint64_t hi,
+                                                         MacKeyboardContext context)
+{
+    MacKeyboardPadState s = {0, 128, 128, 128, 128,
+                             (uint8_t)mac_keyboard_held(lo, hi, 36),
+                             (uint8_t)mac_keyboard_held(lo, hi, 53)};
+    const int menu = context == MAC_KEYBOARD_CONTEXT_BOOT ||
+                     context == MAC_KEYBOARD_CONTEXT_FRONTEND ||
+                     context == MAC_KEYBOARD_CONTEXT_PAUSE;
+    /* Arrow keys navigate menus; in a race, Up/Down only control triggers. */
+    if (menu && mac_keyboard_held(lo, hi, 126)) s.buttons |= 0x0010;
+    if (menu && mac_keyboard_held(lo, hi, 125)) s.buttons |= 0x0040;
+    if (mac_keyboard_held(lo, hi, 123)) s.buttons |= 0x0080;
+    if (mac_keyboard_held(lo, hi, 124)) s.buttons |= 0x0020;
+    s.left_x = mac_keyboard_axis(lo, hi, 123, 124);
+    if (context == MAC_KEYBOARD_CONTEXT_GAMEPLAY) {
+        if (mac_keyboard_held(lo, hi, 126)) s.buttons |= 0x0200; /* R2 throttle */
+        if (mac_keyboard_held(lo, hi, 125)) s.buttons |= 0x0100; /* L2 brake */
+    }
+    s.left_y = mac_keyboard_axis(lo, hi, 13, 1); /* W/S lean */
+    s.right_y = mac_keyboard_axis(lo, hi, 34, 40); /* I/K */
+    s.right_x = mac_keyboard_axis(lo, hi, 38, 37); /* J/L */
+
+    if (mac_keyboard_held(lo, hi, 49)) s.buttons |= 0x4000; /* Space: Cross */
+    if (mac_keyboard_held(lo, hi, 56)) s.buttons |= 0x2000; /* left Shift: Circle */
+    if (mac_keyboard_held(lo, hi, 8)) s.buttons |= 0x1000; /* C: Triangle */
+    if (mac_keyboard_held(lo, hi, 48)) s.buttons |= 0x0004; /* Tab: R3 */
+    if (mac_keyboard_held(lo, hi, 15)) s.buttons |= 0x0001; /* R: Select */
+    if (mac_keyboard_held(lo, hi, 3)) s.buttons |= 0x8000; /* F: Square */
+    if (s.enter_down) {
+        if (context == MAC_KEYBOARD_CONTEXT_BOOT) s.buttons |= 0x0008; /* Start */
+        else if (context == MAC_KEYBOARD_CONTEXT_FRONTEND ||
+                 context == MAC_KEYBOARD_CONTEXT_PAUSE) s.buttons |= 0x4000;
+    }
+    if (s.escape_down) {
+        if (context == MAC_KEYBOARD_CONTEXT_GAMEPLAY ||
+            context == MAC_KEYBOARD_CONTEXT_PAUSE) s.buttons |= 0x0008; /* Start */
+        else if (context == MAC_KEYBOARD_CONTEXT_BOOT ||
+                 context == MAC_KEYBOARD_CONTEXT_FRONTEND) s.buttons |= 0x2000;
+    }
+    return s;
+}
+
+#endif
diff --git a/libs/video/rsx_metal_msaa.h b/libs/video/rsx_metal_msaa.h
new file mode 100644
index 0000000..5030115
--- /dev/null
+++ b/libs/video/rsx_metal_msaa.h
@@ -0,0 +1,140 @@
+/*
+ * Reversible GPU conversion between a two-sample render target and the RSX
+ * 2x1 sample-memory layout. This is not an averaged MSAA resolve: both colour,
+ * depth and stencil samples must survive subsequent guest reads and writes.
+ *
+ * The sample-index mapping follows RPCS3 Program/MSAA resolve/unresolve passes.
+ * Metal's default 2x locations match Vulkan's standard diagonal pattern:
+ * sample 0 at (.75,.75), sample 1 at (.25,.25). Physical PS3 ordering still
+ * needs an independent hardware oracle.
+ */
+#ifndef RSX_METAL_MSAA_H
+#define RSX_METAL_MSAA_H
+#import <Metal/Metal.h>
+
+@interface RSXMetalSampleTransfer : NSObject {
+    id<MTLDevice> _device;
+    id<MTLLibrary> _library;
+    id<MTLDepthStencilState> _depthState;
+    NSMutableDictionary* _pipelines;
+}
+- (instancetype)initWithDevice:(id<MTLDevice>)device;
+- (BOOL)encode:(id<MTLCommandBuffer>)command
+          from:(id<MTLTexture>)source to:(id<MTLTexture>)destination;
+@end
+
+@implementation RSXMetalSampleTransfer
+- (instancetype)initWithDevice:(id<MTLDevice>)device
+{
+    self = [super init];
+    if (!self || ![device supportsTextureSampleCount:2]) return nil;
+    _device = device;
+    _pipelines = [NSMutableDictionary new];
+    NSString* source =
+        @"#include <metal_stdlib>\nusing namespace metal;\n"
+        "vertex float4 sample_vs(uint v [[vertex_id]]) {\n"
+        " return float4(v==1 ? 3. : -1., v==2 ? 3. : -1., 0., 1.);\n"
+        "}\n"
+        "fragment float4 colour_import(float4 p [[position]], uint s [[sample_id]],\n"
+        " texture2d<float,access::read> t [[texture(0)]]) {\n"
+        " return t.read(uint2(uint(p.x)*2+s,uint(p.y)));\n"
+        "}\n"
+        "fragment float4 colour_export(float4 p [[position]],\n"
+        " texture2d_ms<float,access::read> t [[texture(0)]]) {\n"
+        " return t.read(uint2(uint(p.x)/2,uint(p.y)),uint(p.x)&1);\n"
+        "}\n"
+        "struct DS { float z [[depth(any)]]; uint s [[stencil]]; };\n"
+        "fragment DS depth_import(float4 p [[position]], uint s [[sample_id]],\n"
+        " depth2d<float,access::read> z [[texture(0)]],\n"
+        " texture2d<uint,access::read> stencil [[texture(1)]]) {\n"
+        " uint2 q=uint2(uint(p.x)*2+s,uint(p.y));\n"
+        " return {z.read(q),stencil.read(q).r};\n"
+        "}\n"
+        "fragment DS depth_export(float4 p [[position]],\n"
+        " depth2d_ms<float,access::read> z [[texture(0)]],\n"
+        " texture2d_ms<uint,access::read> stencil [[texture(1)]]) {\n"
+        " uint2 q=uint2(uint(p.x)/2,uint(p.y)); uint s=uint(p.x)&1;\n"
+        " return {z.read(q,s),stencil.read(q,s).r};\n"
+        "}\n";
+    NSError* error = nil;
+    _library = [device newLibraryWithSource:source options:nil error:&error];
+    if (!_library) {
+        fprintf(stderr, "[RSX MSAA] transfer shaders: %s\n", error.localizedDescription.UTF8String);
+        return nil;
+    }
+    MTLDepthStencilDescriptor* ds = [MTLDepthStencilDescriptor new];
+    ds.depthCompareFunction = MTLCompareFunctionAlways;
+    ds.depthWriteEnabled = YES;
+    MTLStencilDescriptor* stencil = [MTLStencilDescriptor new];
+    stencil.stencilCompareFunction = MTLCompareFunctionAlways;
+    stencil.depthStencilPassOperation = MTLStencilOperationReplace;
+    stencil.readMask = stencil.writeMask = 255;
+    ds.frontFaceStencil = ds.backFaceStencil = stencil;
+    _depthState = [device newDepthStencilStateWithDescriptor:ds];
+    return _depthState ? self : nil;
+}
+
+- (BOOL)encode:(id<MTLCommandBuffer>)command
+          from:(id<MTLTexture>)source to:(id<MTLTexture>)destination
+{
+    if (!command || !source || !destination || source.pixelFormat != destination.pixelFormat)
+        return NO;
+    const BOOL importing = destination.sampleCount == 2;
+    id<MTLTexture> multi = importing ? destination : source;
+    id<MTLTexture> packed = importing ? source : destination;
+    if (multi.textureType != MTLTextureType2DMultisample || multi.sampleCount != 2 ||
+        packed.textureType != MTLTextureType2D || packed.sampleCount != 1 ||
+        multi.width*2 != packed.width || multi.height != packed.height) return NO;
+    const BOOL depth = source.pixelFormat == MTLPixelFormatDepth32Float_Stencil8;
+    NSNumber* key = @(((NSUInteger)source.pixelFormat << 1) | importing);
+    id<MTLRenderPipelineState> pipeline = _pipelines[key];
+    if (!pipeline) {
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction = [_library newFunctionWithName:@"sample_vs"];
+        pd.fragmentFunction = [_library newFunctionWithName:
+            depth ? (importing ? @"depth_import" : @"depth_export")
+                  : (importing ? @"colour_import" : @"colour_export")];
+        pd.rasterSampleCount = importing ? 2 : 1;
+        if (depth) {
+            pd.depthAttachmentPixelFormat = source.pixelFormat;
+            pd.stencilAttachmentPixelFormat = source.pixelFormat;
+        } else {
+            pd.colorAttachments[0].pixelFormat = source.pixelFormat;
+        }
+        NSError* error = nil;
+        pipeline = [_device newRenderPipelineStateWithDescriptor:pd error:&error];
+        if (!pipeline) {
+            fprintf(stderr, "[RSX MSAA] transfer pipeline: %s\n", error.localizedDescription.UTF8String);
+            return NO;
+        }
+        _pipelines[key] = pipeline;
+    }
+    id<MTLTexture> stencil = nil;
+    MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    if (depth) {
+        stencil = [source newTextureViewWithPixelFormat:MTLPixelFormatX32_Stencil8];
+        if (!stencil) return NO;
+        pass.depthAttachment.texture = destination;
+        pass.depthAttachment.loadAction = MTLLoadActionDontCare;
+        pass.depthAttachment.storeAction = MTLStoreActionStore;
+        pass.stencilAttachment.texture = destination;
+        pass.stencilAttachment.loadAction = MTLLoadActionDontCare;
+        pass.stencilAttachment.storeAction = MTLStoreActionStore;
+    } else {
+        pass.colorAttachments[0].texture = destination;
+        pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+        pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    }
+    id<MTLRenderCommandEncoder> encoder = [command renderCommandEncoderWithDescriptor:pass];
+    if (!encoder) return NO;
+    encoder.label = importing ? @"RSX samples to MSAA" : @"MSAA to RSX samples";
+    [encoder setRenderPipelineState:pipeline];
+    if (depth) [encoder setDepthStencilState:_depthState];
+    [encoder setFragmentTexture:source atIndex:0];
+    if (depth) [encoder setFragmentTexture:stencil atIndex:1];
+    [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [encoder endEncoding];
+    return YES;
+}
+@end
+#endif
diff --git a/libs/video/rsx_msl_disk_cache.h b/libs/video/rsx_msl_disk_cache.h
new file mode 100644
index 0000000..e4304f9
--- /dev/null
+++ b/libs/video/rsx_msl_disk_cache.h
@@ -0,0 +1,73 @@
+/* Private, optional cache of exact HLSL -> MSL translations. No GPU binaries.
+ * Callers include compiler/options identity in the key. A bad/missing cache
+ * always falls back to translation; the complete key is compared on a hit. */
+#ifndef PS3RECOMP_RSX_MSL_DISK_CACHE_H
+#define PS3RECOMP_RSX_MSL_DISK_CACHE_H
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#ifdef _WIN32
+#include <process.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace rsx_msl_cache {
+inline uint64_t hash(const std::string& text)
+{
+    uint64_t h=14695981039346656037ull;
+    for (unsigned char c:text) { h^=c; h*=1099511628211ull; }
+    return h;
+}
+inline std::string path(const std::string& dir,const std::string& key)
+{
+    char name[40];std::snprintf(name,sizeof name,"/%016llx.mslcache",(unsigned long long)hash(key));
+    return dir+name;
+}
+inline bool load(const std::string& file,const std::string& key,char* out,size_t capacity)
+{
+    FILE* f=std::fopen(file.c_str(),"rb");if (!f)return false;
+    uint64_t header[5]={};
+    bool ok=std::fread(header,sizeof header,1,f)==1 &&
+        header[0]==0x314c534d585352ull && header[1]==key.size() &&
+        header[2]>0 && header[2]<capacity && header[3]==hash(key);
+    std::string stored,msl;
+    if (ok) {
+        stored.resize(key.size());msl.resize((size_t)header[2]);
+        ok=std::fread(&stored[0],1,stored.size(),f)==stored.size() && stored==key &&
+            std::fread(&msl[0],1,msl.size(),f)==msl.size() && std::fgetc(f)==EOF &&
+            hash(msl)==header[4] && msl.find('\0')==std::string::npos;
+    }
+    std::fclose(f);
+    if (ok)std::memcpy(out,msl.c_str(),msl.size()+1);
+    return ok;
+}
+/* Caller serializes writers within the process. pid + monotonic serial keeps
+ * simultaneous processes from sharing a temporary file; readers see rename. */
+inline bool store(const std::string& file,const std::string& key,const char* source)
+{
+    static uint64_t serial=0;
+#ifdef _WIN32
+    const int pid=_getpid();
+#else
+    const int pid=(int)getpid();
+#endif
+    char suffix[64];std::snprintf(suffix,sizeof suffix,".%d.%llu.tmp",pid,
+                                  (unsigned long long)++serial);
+    const std::string tmp=file+suffix,msl(source);
+    FILE* f=std::fopen(tmp.c_str(),"wb");if (!f)return false;
+    const uint64_t header[5]={0x314c534d585352ull,key.size(),msl.size(),hash(key),hash(msl)};
+    bool ok=std::fwrite(header,sizeof header,1,f)==1 &&
+        std::fwrite(key.data(),1,key.size(),f)==key.size() &&
+        std::fwrite(msl.data(),1,msl.size(),f)==msl.size();
+    ok=(std::fclose(f)==0) && ok;
+    /* On Windows rename may refuse replacement: retain the original file,
+     * fall back next time and discard this temporary file. */
+    if (!ok || std::rename(tmp.c_str(),file.c_str())!=0) {
+        std::remove(tmp.c_str());return false;
+    }
+    return true;
+}
+}
+#endif
diff --git a/libs/video/rsx_vertex_packed.c b/libs/video/rsx_vertex_packed.c
new file mode 100644
index 0000000..751656c
--- /dev/null
+++ b/libs/video/rsx_vertex_packed.c
@@ -0,0 +1,162 @@
+#include "rsx_vertex_packed.h"
+#include "rsx_vertex_formats.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+
+typedef struct { uintptr_t begin, end; u32 offset; } source_range;
+static u64 aligned(u64 n) { return (n + 15u) & ~15ull; }
+
+/* Called only after every referenced source element has passed validation.
+ * Rebase each attribute onto the same dense reference list, preserving the
+ * original order, divisors, modulo and base-index wrap in the copied bytes.
+ * The existing GPU format decoder then consumes these immutable bytes. */
+static int pack_sparse(const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs,
+                       u32 count, rsx_packed_vertices* out, rsx_packed_header header)
+{
+    /* Ordinary RSX references wrap at 20 bits, including the dense local IDs. */
+    if (count > 0x100000u) return 0;
+    u64 bytes = aligned(sizeof header + (u64)count * sizeof(*refs));
+    for (u32 slot = 0; slot < header.attributes; ++slot) {
+        rsx_packed_attr* a = &header.attr[slot];
+        if (!a->type) continue;
+        const rsx_vertex_fetch_attr* f = &plan->attr[plan->layout.attrs[slot]];
+        a->offset = (u32)bytes;
+        a->first = 0; a->last = count - 1; a->stride = f->elem_size;
+        a->frequency = 0; a->modulo = 0;
+        bytes = aligned(bytes + (u64)count * f->elem_size);
+    }
+    if (bytes > (16u << 20)) return 0;
+    header.bytes = (u32)bytes;
+    if (out->capacity < bytes) {
+        u8* data = (u8*)realloc(out->data, (size_t)bytes);
+        if (!data) return 0;
+        out->data = data; out->capacity = (u32)bytes;
+    }
+    memcpy(out->data, &header, sizeof header);
+    rsx_vertex_ref* dense = (void*)(out->data + header.refs_offset);
+    for (u32 i = 0; i < count; ++i) dense[i] = (rsx_vertex_ref){i, 0};
+    for (u32 slot = 0; slot < header.attributes; ++slot) {
+        const rsx_packed_attr* a = &header.attr[slot];
+        if (!a->type) continue;
+        const u32 attr = plan->layout.attrs[slot];
+        const rsx_vertex_fetch_attr* f = &plan->attr[attr];
+        u8* dst = out->data + a->offset;
+        for (u32 i = 0; i < count; ++i) {
+            const u32 element = rsx_vertex_element_index(refs[i].vertex_id,
+                refs[i].base_index, f->desc.frequency, (plan->divider_mask >> attr) & 1u);
+            memcpy(dst + (size_t)i * f->elem_size,
+                f->stable_base + (u64)(element - f->stable_first) * f->stride, f->elem_size);
+        }
+    }
+    out->size = (u32)bytes;
+    return 1;
+}
+
+int rsx_vertex_pack_ex(const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs,
+                       u32 count, rsx_packed_vertices* out, int allow_sparse_gather)
+{
+    if (!plan || !refs || !count || !out || !plan->layout.count ||
+        plan->layout.count > RSX_DSP_NUM_VERTEX_ATTR ||
+        plan->layout.stride != (u32)plan->layout.count * 16u) return 0;
+    rsx_packed_header header = {0};
+    header.count = count;
+    header.attributes = plan->layout.count;
+    header.refs_offset = sizeof header;
+    source_range ranges[RSX_DSP_NUM_VERTEX_ATTR];
+    uintptr_t starts[RSX_DSP_NUM_VERTEX_ATTR] = {0};
+    u32 range_count = 0;
+    for (u32 slot = 0; slot < plan->layout.count; ++slot) {
+        u32 index = plan->layout.attrs[slot];
+        if (index >= RSX_DSP_NUM_VERTEX_ATTR) return 0;
+        const rsx_vertex_fetch_attr* f = &plan->attr[index];
+        rsx_packed_attr* a = &header.attr[slot];
+        memcpy(a->defaults, f->default_value, sizeof a->defaults);
+        if (!f->desc.type || !f->desc.size) continue;
+        if (f->desc.type > RSX_VERTEX_TYPE_UB256 || f->desc.size > 4 ||
+            !f->stable_base || !f->elem_size || !f->stride ||
+            f->elem_size != rsx_vertex_attrib_size(f->desc.type, f->desc.size) ||
+            f->stable_last < f->stable_first) return 0;
+        a->type = f->desc.type; a->size = f->desc.size;
+        a->stride = f->stride; a->first = f->stable_first; a->last = f->stable_last;
+        a->frequency = f->desc.frequency;
+        a->modulo = (plan->divider_mask >> index) & 1u;
+        for (u32 i = 0; i < count; ++i) {
+            u32 element = rsx_vertex_element_index(refs[i].vertex_id, refs[i].base_index,
+                                                   a->frequency, a->modulo);
+            if (element < a->first || element > a->last) return 0;
+        }
+        u64 bytes = (u64)(a->last - a->first) * a->stride + f->elem_size;
+        uintptr_t begin = (uintptr_t)f->stable_base;
+        if (bytes > UINTPTR_MAX - begin) return 0;
+        starts[slot] = begin;
+        ranges[range_count++] = (source_range){begin, begin + (uintptr_t)bytes, 0};
+    }
+    // At most sixteen spans: stable insertion sort needs no allocator or hash.
+    for (u32 i = 1; i < range_count; ++i) {
+        source_range value = ranges[i]; u32 j = i;
+        while (j && ranges[j - 1].begin > value.begin) {
+            ranges[j] = ranges[j - 1]; --j;
+        }
+        ranges[j] = value;
+    }
+    u32 merged = 0;
+    for (u32 i = 0; i < range_count; ++i) {
+        if (merged && ranges[i].begin <= ranges[merged - 1].end) {
+            if (ranges[i].end > ranges[merged - 1].end)
+                ranges[merged - 1].end = ranges[i].end;
+        } else ranges[merged++] = ranges[i];
+    }
+    u64 bytes = aligned(sizeof header + (u64)count * sizeof(*refs));
+    for (u32 i = 0; i < merged; ++i) {
+        if (bytes > UINT_MAX) return allow_sparse_gather ? pack_sparse(plan, refs, count, out, header) : 0;
+        ranges[i].offset = (u32)bytes;
+        bytes = aligned(bytes + ranges[i].end - ranges[i].begin);
+    }
+    const u64 decoded_bytes = (u64)count * plan->layout.stride;
+    if (bytes > (16u << 20) || bytes > decoded_bytes * 2 + 4096)
+        return allow_sparse_gather ? pack_sparse(plan, refs, count, out, header) : 0;
+    for (u32 slot = 0; slot < header.attributes; ++slot) {
+        if (!header.attr[slot].type) continue;
+        for (u32 i = 0; i < merged; ++i)
+            if (starts[slot] >= ranges[i].begin && starts[slot] < ranges[i].end) {
+                header.attr[slot].offset = ranges[i].offset +
+                                          (u32)(starts[slot] - ranges[i].begin);
+                break;
+            }
+    }
+    header.bytes = (u32)bytes;
+    if (out->capacity < bytes) {
+        u8* data = (u8*)realloc(out->data, (size_t)bytes);
+        if (!data) return 0;
+        out->data = data; out->capacity = (u32)bytes;
+    }
+    memcpy(out->data, &header, sizeof header);
+    memcpy(out->data + header.refs_offset, refs, (size_t)count * sizeof(*refs));
+    for (u32 i = 0; i < merged; ++i)
+        memcpy(out->data + ranges[i].offset, (const void*)ranges[i].begin,
+               ranges[i].end - ranges[i].begin);
+    out->size = (u32)bytes;
+    return 1;
+}
+int rsx_vertex_pack(const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs,
+                    u32 count, rsx_packed_vertices* out)
+{
+    return rsx_vertex_pack_ex(plan, refs, count, out, 0);
+}
+void rsx_vertex_pack_destroy(rsx_packed_vertices* out)
+{
+    if (!out) return;
+    free(out->data); memset(out, 0, sizeof(*out));
+}
+
+void rsx_vertex_pack_norm_table(float* table)
+{
+    for (u32 i = 0; i < 65536; ++i) table[i] = (s16)i / 32767.0f;
+    for (u32 i = 0; i < 256; ++i) table[65536 + i] = i / 255.0f;
+    for (u32 i = 0; i < 2048; ++i) table[65792 + i] =
+        (float)(i < 1024 ? (s32)i : (s32)i - 2048) / 1023.0f;
+    for (u32 i = 0; i < 1024; ++i) table[67840 + i] =
+        (float)(i < 512 ? (s32)i : (s32)i - 1024) / 511.0f;
+}
diff --git a/libs/video/rsx_vertex_packed.h b/libs/video/rsx_vertex_packed.h
new file mode 100644
index 0000000..30d77e6
--- /dev/null
+++ b/libs/video/rsx_vertex_packed.h
@@ -0,0 +1,39 @@
+/* Immutable raw vertex snapshot for optional GPU conversion. This keeps the
+ * current CPU decoder as fallback and snapshots at the same point in a draw. */
+#ifndef PS3RECOMP_RSX_VERTEX_PACKED_H
+#define PS3RECOMP_RSX_VERTEX_PACKED_H
+#include "rsx_vertex_compact.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    u32 type, size, stride, first;
+    u32 last, frequency, modulo, offset;
+    u32 defaults[4];
+} rsx_packed_attr;
+typedef struct {
+    u32 count, attributes, refs_offset, bytes;
+    rsx_packed_attr attr[RSX_DSP_NUM_VERTEX_ATTR]; // compact layout order
+} rsx_packed_header;
+typedef struct { u8* data; u32 size, capacity; } rsx_packed_vertices;
+typedef struct { u32 blob_offset, output_offset, first_vertex, count; } rsx_packed_work;
+enum { RSX_PACKED_NORM_FLOATS = 68864, RSX_PACKED_GROUP_SIZE = 64 };
+/* Exact results of the existing CPU normalized-format conversions. A shared
+ * table avoids GPU division precision differences in the parity experiment. */
+void rsx_vertex_pack_norm_table(float* table);
+/* Returns zero without publishing a snapshot when the complete source cannot
+ * be mapped, or packing would excessively expand a sparse vertex range.
+ * Call after fetch_plan_prepare, before other draw work can mutate sources.
+ * Source spans that overlap (interleaved attributes) are copied only once. */
+int rsx_vertex_pack(const rsx_vertex_fetch_plan*, const rsx_vertex_ref*, u32 count,
+                    rsx_packed_vertices* out);
+/* Optional sparse gather: snapshot only referenced raw elements when copying
+ * complete spans would exceed the budget. Uses the same GPU ABI/decoder.
+ * All sources must still have valid prepared stable ranges. */
+int rsx_vertex_pack_ex(const rsx_vertex_fetch_plan*, const rsx_vertex_ref*, u32 count,
+                       rsx_packed_vertices* out, int allow_sparse_gather);
+void rsx_vertex_pack_destroy(rsx_packed_vertices*);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/rsx_vertex_packed_msl.h b/libs/video/rsx_vertex_packed_msl.h
new file mode 100644
index 0000000..d06de96
--- /dev/null
+++ b/libs/video/rsx_vertex_packed_msl.h
@@ -0,0 +1,72 @@
+/* GPU counterpart of the current CPU vertex decoder. Keep any later RSX
+ * semantic corrections separate from moving the existing work to Metal. */
+#ifndef PS3RECOMP_VERTEX_PACKED_MSL_H
+#define PS3RECOMP_VERTEX_PACKED_MSL_H
+#define RSX_PACK_MSL(...) #__VA_ARGS__
+static const char rsx_vertex_packed_msl[] = "#include <metal_stdlib>\n" RSX_PACK_MSL(
+using namespace metal;
+struct PackedAttr {
+    uint type, size, stride, first;
+    uint last, frequency, modulo, offset;
+    uint4 defaults;
+};
+struct PackedHeader { uint count, attributes, refs_offset, bytes; PackedAttr attr[16]; };
+struct PackedWork { uint blob_offset, output_offset, first_vertex, count; };
+uint load_be16(const device uchar* p) { return (uint(p[0]) << 8) | p[1]; }
+uint load_be32(const device uchar* p) { return (uint(p[0]) << 24) | (uint(p[1]) << 16) | (uint(p[2]) << 8) | p[3]; }
+uint half_bits(uint bits) {
+    uint sign = (bits & 0x8000u) << 16;
+    uint exponent = (bits >> 10) & 31u, mantissa = bits & 1023u;
+    if (!exponent) return sign;
+    if (exponent == 31) return sign | 0x7f800000u | (mantissa << 13);
+    return sign | ((exponent + 112) << 23) | (mantissa << 13);
+}
+kernel void rsx_unpack_vertices(device uchar* storage [[buffer(0)]],
+    const device PackedWork* jobs [[buffer(1)]],
+    const device float* normalized [[buffer(2)]],
+    uint3 group [[threadgroup_position_in_grid]], uint lane [[thread_index_in_threadgroup]]) {
+    PackedWork job = jobs[group.x];
+    uint vi = job.first_vertex + lane;
+    if (vi >= job.count) return;
+    const device uchar* blob = storage + job.blob_offset;
+    const device PackedHeader* header = reinterpret_cast<const device PackedHeader*>(blob);
+    const device uint2* refs = reinterpret_cast<const device uint2*>(blob + header->refs_offset);
+    uint2 ref = refs[vi];
+    device uint4* output = reinterpret_cast<device uint4*>(storage + job.output_offset);
+    for (uint slot = 0; slot < header->attributes; ++slot) {
+        PackedAttr a = header->attr[slot];
+        uint4 result = uint4(0, 0, 0, 0x3f800000u);
+        if (!a.type) result = a.defaults;
+        else {
+            uint element = a.frequency <= 1 ? (ref.x + ref.y) & 0xfffffu :
+                           (a.modulo ? ref.x % a.frequency : ref.x / a.frequency);
+            if (element < a.first || element > a.last) result = a.defaults;
+            else {
+                const device uchar* source = blob + a.offset + (element - a.first) * a.stride;
+                if (a.type == 6) {
+                    uint bits = load_be32(source);
+                    result = uint4(as_type<uint>(normalized[65792 + (bits & 2047u)]),
+                        as_type<uint>(normalized[65792 + ((bits >> 11) & 2047u)]),
+                        as_type<uint>(normalized[67840 + (bits >> 22)]), 0x3f800000u);
+                } else for (uint c = 0; c < a.size; ++c) {
+                    switch (a.type) {
+                    case 1: result[c] = as_type<uint>(normalized[load_be16(source + c * 2)]); break;
+                    case 2: result[c] = load_be32(source + c * 4); break;
+                    case 3: result[c] = half_bits(load_be16(source + c * 2)); break;
+                    case 4: result[c] = as_type<uint>(normalized[65536 + source[c]]); break;
+                    case 5: {
+                        uint bits = load_be16(source + c * 2);
+                        int value = bits < 32768 ? int(bits) : int(bits) - 65536;
+                        result[c] = as_type<uint>(float(value)); break;
+                    }
+                    case 7: result[c] = as_type<uint>(float(source[c])); break;
+                    }
+                }
+            }
+        }
+        output[vi * header->attributes + slot] = result;
+    }
+}
+);
+#undef RSX_PACK_MSL
+#endif
diff --git a/libs/video/tests/test_fp_cached_size.c b/libs/video/tests/test_fp_cached_size.c
new file mode 100644
index 0000000..38fcbd2
--- /dev/null
+++ b/libs/video/tests/test_fp_cached_size.c
@@ -0,0 +1,195 @@
+/* Exercise the actual engine cache against fresh length decoding. */
+#define main original_engine_tests_main
+#include "test_rsx_draw_engine.c"
+#undef main
+#include "../rsx_draw_engine.c"
+#include "rsx_test_programs.h"
+
+static void install_vertex(void)
+{
+    u8 vp[16];rsx_test_vp_mov_out(vp,0,RSX_TEST_VP_SWZ_IDENT,0,1);
+    m(0x1E9C,0);
+    for(u32 i=0;i<4;++i){u32 word;memcpy(&word,vp+4*i,4);m(0xB80+4*i,word);}
+    m(0x1EA0,0);m(0x1D60,64);
+}
+static u32 decoded_size(void)
+{
+    u32 size=0;const u8* code=NULL;
+    CHECK(eng_guest_programs(NULL,NULL,&code,&size),"guest program resolves");
+    CHECK(code && size==rsx_fp_program_size(code,ENG_FP_MAX_BYTES),
+          "validated cache length equals fresh decoder");
+    return size;
+}
+static const u8* prefix_only(void* user,u32 location,u32 offset,u32 bytes)
+{
+    (void)user;(void)location;
+    return bytes<=16 ? vm_base+offset : NULL;
+}
+static void check_mode(int enabled,int relocate)
+{
+    setenv("RSX_FP_METADATA_CACHE","1",1);
+    setenv("RSX_FP_CACHED_SIZE",enabled?"1":"0",1);
+    setenv("RSX_FP_RELOCATE_CACHE",relocate?"1":"0",1);
+    engine_up();install_vertex();
+    u8* code=vm_base+TEX_OFFSET;
+    rsx_test_fp_mov_r0_col0(code,RSX_TEST_FP_SWZ_IDENT);
+    m(0x8E4,TEX_OFFSET|2);
+    draw_triangle();draw_triangle();
+    CHECK(decoded_size()==16,"short program");
+    CHECK(!enabled || g.fp_size_hits>0,"enabled path actually reused a validated length");
+    const u32 short_pipe=stub.bound_pipeline;
+
+    /* Reuse the address with a longer instruction stream and a later END. */
+    rsx_test_fp_put_word(code,rsx_fp_read_word(code)&~1u);
+    rsx_test_fp_mov_r0_col0(code+16,RSX_TEST_FP_SWZ(3,2,1,0));
+    CHECK(decoded_size()==32,"old END invalidates cached length");
+    draw_triangle();
+    CHECK(stub.bound_pipeline!=short_pipe,"changed instructions create the appropriate pipeline");
+    draw_triangle();
+
+    /* Then reuse it for one instruction plus its live inline constant. */
+    rsx_test_fp_instr(code,RSX_TEST_FP_OPC(1)|RSX_TEST_FP_MASK_XYZW|RSX_TEST_FP_END,
+                      2|RSX_TEST_FP_SWZ_IDENT);
+    for(u32 i=0;i<4;++i)rsx_test_fp_put_word(code+16+4*i,0x3f800000);
+    draw_triangle();draw_triangle();
+    const u32 constant_pipe=stub.bound_pipeline;
+    const u64 hits=g.fp_size_hits;
+    rsx_test_fp_put_word(code+16,0x40000000);
+    CHECK(decoded_size()==32,"constant payload does not change instruction length");
+    draw_triangle();
+    CHECK(stub.bound_pipeline==constant_pipe && g.fp_constants.count==1 &&
+          g.fp_constants.values[0][0]==0x40000000,"pipeline reuse refreshes the live constant");
+    CHECK(!enabled || g.fp_size_hits>hits,"changed constant still permits a byte-validated size hit");
+
+    /* Cache reuse must resolve the FULL span, not just its readable prefix. */
+    rsx_draw_engine_set_guest_memory(prefix_only,NULL);
+    u32 size=0;
+    CHECK(!eng_cached_fragment_program(RSX_LOCATION_MAIN,TEX_OFFSET,code,&size),
+          "unmapped tail rejects reuse");
+    rsx_draw_engine_set_guest_memory(NULL,NULL);
+
+    rsx_test_fp_mov_r0_col0(code,RSX_TEST_FP_SWZ_IDENT);
+    CHECK(decoded_size()==16,"shortening and removing a constant invalidates the length");
+    draw_triangle();
+    CHECK(stub.bound_pipeline==short_pipe,"restored program returns to original pipeline");
+
+    for(u32 i=1;i<=65;++i){
+        rsx_test_fp_mov_r0_col0(code+i*256,RSX_TEST_FP_SWZ_IDENT);
+        m(0x8E4,(TEX_OFFSET+i*256)|2);draw_triangle();
+    }
+    m(0x8E4,TEX_OFFSET|2);
+    CHECK(decoded_size()==16,"evicted address decodes correctly");
+    draw_triangle();
+    CHECK(stub.bound_pipeline==short_pipe,"eviction does not alter rendered pipeline");
+    CHECK(enabled || !g.fp_size_hits,"disabled mode remains the original decoder");
+    CHECK(relocate ? g.fp_relocate_hits>0 : !g.fp_relocate_hits,
+          "relocation path is used only when enabled");
+    engine_down();
+    CHECK(!g.fp_size_hits && !g.fp_size_misses && !g.fp_relocate_hits,
+          "shutdown clears cached-size and relocation state");
+}
+static void check_hash_probe(void)
+{
+    u8 code[16];
+    rsx_fp_metadata* meta=calloc(1,sizeof(*meta));
+    CHECK(meta!=NULL,"hash-probe fixture allocation");
+    if(!meta)return;
+    rsx_test_fp_mov_r0_col0(code,RSX_TEST_FP_SWZ_IDENT);
+    CHECK(rsx_fp_metadata_build(meta,code,sizeof code),"hash-probe metadata");
+    g_ps3_ft.on=2;
+    g_ps3_ft.start=0;g_ps3_ft.end=UINT64_MAX;
+    g.fp_hash_probe=1;
+    memset(g.fp_hash_totals,0,sizeof g.fp_hash_totals);
+    const u64 seeds[3]={0,0,UINT64_MAX};
+    for(u32 i=0;i<3;++i)
+        CHECK(eng_fragment_hash(meta,code,sizeof code,seeds[i])==
+              rsx_fp_structural_hash(code,sizeof code,seeds[i]),
+              "diagnostics preserve all seeded hash results");
+    CHECK(eng_fragment_hash(NULL,code,sizeof code,1)==
+          rsx_fp_structural_hash(code,sizeof code,1),"diagnostic fallback hash");
+    for(u32 i=0;i<4;++i)
+        CHECK(g.fp_hash_totals[i].calls==1 && g.fp_hash_totals[i].bytes==16,
+              "one exact classification per hash request");
+    CHECK(!g.fp_hash_totals[0].cpu_ns,"cache hits have no CPU-clock probe");
+    g.fp_hash_probe=0;
+    eng_fragment_hash(meta,code,sizeof code,42);
+    g.fp_hash_probe=1;g_ps3_ft.on=3;
+    eng_fragment_hash(meta,code,sizeof code,43);
+    for(u32 i=0;i<4;++i)
+        CHECK(g.fp_hash_totals[i].calls==1,"disabled diagnostics do not accumulate");
+    g.fp_hash_probe=0;
+    memset(g.fp_hash_totals,0,sizeof g.fp_hash_totals);
+    free(meta);
+}
+static void check_metadata_probe(void)
+{
+    setenv("RSX_FP_RELOCATE_CACHE","0",1);
+    engine_up();
+    g.fp_meta_enabled=1;g.fp_hash_probe=1;
+    g_ps3_ft.on=2;g_ps3_ft.start=0;g_ps3_ft.end=UINT64_MAX;
+    u8* a=vm_base+TEX_OFFSET;
+    u8* b=a+256;
+    rsx_test_fp_mov_r0_col0(a,RSX_TEST_FP_SWZ_IDENT);
+    memcpy(b,a,16);
+    CHECK(eng_fragment_metadata(a,16)!=NULL,"new unmatched address");
+    CHECK(eng_fragment_metadata(a,16)!=NULL,"address hit avoids search");
+    CHECK(eng_fragment_metadata(b,16)!=NULL,"new address with reusable instructions");
+    rsx_test_fp_mov_r0_col0(b,RSX_TEST_FP_SWZ(3,2,1,0));
+    CHECK(eng_fragment_metadata(b,16)!=NULL,"existing address with unmatched instructions");
+    memcpy(a,b,16);
+    rsx_fp_metadata* meta=eng_fragment_metadata(a,16);
+    CHECK(meta && rsx_fp_metadata_matches(meta,a,16),
+          "existing address with reusable instructions still gets valid metadata");
+    for(u32 i=0;i<4;++i)
+        CHECK(g.fp_metadata_probe[i].calls==1 && g.fp_metadata_probe[i].bytes==16,
+              "metadata probe classifies every cause once");
+    g_ps3_ft.on=3;
+    engine_down();
+}
+static void check_relocation_values(void)
+{
+    setenv("RSX_FP_METADATA_CACHE","1",1);
+    setenv("RSX_FP_RELOCATE_CACHE","1",1);
+    engine_up();
+    u8* a=vm_base+TEX_OFFSET;
+    u8* b=a+256;
+    rsx_test_fp_instr(a,RSX_TEST_FP_OPC(1)|RSX_TEST_FP_MASK_XYZW|RSX_TEST_FP_END,
+                      2|RSX_TEST_FP_SWZ_IDENT);
+    for(u32 i=0;i<4;++i)rsx_test_fp_put_word(a+16+4*i,0x3f800000);
+    memcpy(b,a,32);
+    rsx_test_fp_put_word(b+16,0x40000000);
+    rsx_fp_metadata* first=eng_fragment_metadata(a,32);
+    CHECK(first!=NULL,"first relocation source");
+    if(!first){engine_down();return;}
+    const u64 seed=12345,hash=rsx_fp_metadata_hash(first,a,seed);
+    rsx_fp_metadata* second=eng_fragment_metadata(b,32);
+    CHECK(second && second!=first && second->hash_valid && second->last_hash==hash &&
+          g.fp_relocate_hits==1,"relocated instructions inherit an independently owned hash cache");
+    if(!second){engine_down();return;}
+    rsx_fp_constant_block values;
+    rsx_fp_metadata_constants(second,b,&values);
+    CHECK(values.count==1 && values.values[0][0]==0x40000000,
+          "relocation reads constants at the new address");
+    CHECK(rsx_fp_metadata_hash(second,b,UINT64_MAX)==rsx_fp_structural_hash(b,32,UINT64_MAX) &&
+          first->last_seed==seed,"new vertex seed recomputes without changing the source");
+    rsx_test_fp_mov_r0_col0(b,RSX_TEST_FP_SWZ(3,2,1,0));
+    second=eng_fragment_metadata(b,16);
+    CHECK(second && !second->hash_valid && g.fp_relocate_hits==1 &&
+          rsx_fp_metadata_matches(first,a,32),"changed code/length rebuilds independently");
+    memcpy(b,a,32);
+    second=eng_fragment_metadata(b,32);
+    CHECK(second && second->hash_valid && second->last_hash==hash && g.fp_relocate_hits==2,
+          "same-address mutation back to resident instructions is reusable");
+    engine_down();
+}
+int main(void)
+{
+    vm_base=calloc(1,GUEST_BYTES);if(!vm_base)return 2;ppu_vm_size=GUEST_BYTES;
+    check_mode(0,0);check_mode(1,0);check_mode(0,1);check_mode(1,1);check_mode(1,1);
+    check_hash_probe();
+    check_metadata_probe();
+    check_relocation_values();
+    free(vm_base);
+    printf("cached FP size failures: %d\n",g_failures);
+    return g_failures?1:0;
+}
diff --git a/libs/video/tests/test_fp_metadata.c b/libs/video/tests/test_fp_metadata.c
new file mode 100644
index 0000000..a2c85fe
--- /dev/null
+++ b/libs/video/tests/test_fp_metadata.c
@@ -0,0 +1,84 @@
+#include "../rsx_fp_decompiler.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static u32 rng = 0x31fbe9;
+static u32 random_word(void) { rng ^= rng<<13; rng ^= rng>>17; rng ^= rng<<5; return rng; }
+static void word(u8* p,u32 v) {
+    v=(v<<16)|(v>>16);p[0]=v>>24;p[1]=v>>16;p[2]=v>>8;p[3]=v;
+}
+int main(void) {
+    rsx_fp_metadata* m=calloc(1,sizeof(*m));assert(m);
+    rsx_fp_metadata* copy=malloc(sizeof(*copy));assert(copy);
+    memset(copy,0xa5,sizeof(*copy));
+    u8 code[65536],changed[65536];
+    rsx_fp_constant_block a,b;
+    for (u32 trial=0;trial<5000;++trial) {
+        u32 bytes=0,n=1+random_word()%128;
+        for (u32 i=0;i<n;++i) {
+            u32 w0=random_word()&~1u,w1=random_word(),w2=random_word()&~(1u<<31),w3=random_word();
+            if (i+1==n) w0|=1;
+            word(code+bytes,w0);word(code+bytes+4,w1);word(code+bytes+8,w2);word(code+bytes+12,w3);bytes+=16;
+            if ((w1&3)==2 || (w2&3)==2 || (w3&3)==2) {
+                for (u32 c=0;c<4;++c) word(code+bytes+4*c,random_word());bytes+=16;
+            }
+        }
+        assert(rsx_fp_metadata_build(m,code,bytes));
+        assert(m->instructions==n && rsx_fp_metadata_matches(m,code,bytes));
+        assert(!rsx_fp_metadata_matches(m,code,bytes-1));
+        for (u32 i=0;i<n;++i) {
+            u32 offset=m->instruction_offsets[i]+random_word()%16;
+            code[offset]^=1;assert(!rsx_fp_metadata_matches(m,code,bytes));code[offset]^=1;
+        }
+        memcpy(changed,code,bytes);
+        for (u32 i=0;i<m->constants;++i)
+            for(u32 c=0;c<4;++c)word(changed+m->constant_offsets[i]+4*c,random_word());
+        assert(rsx_fp_metadata_matches(m,changed,bytes));
+        assert(rsx_fp_collect_constants(changed,bytes,&a)>=0);
+        rsx_fp_metadata_constants(m,changed,&b);assert(!memcmp(&a,&b,sizeof a));
+        for (u32 i=0;i<3;++i) {
+            const u64 seed=((u64)random_word()<<32)|random_word();
+            const u64 expected=rsx_fp_structural_hash(changed,bytes,seed);
+            assert(rsx_fp_metadata_hash(m,code,seed)==expected);
+            assert(rsx_fp_metadata_hash(m,changed,seed)==expected);
+        }
+        u8 mask[16];u32 units=0;
+        for(u32 i=0;i<16;++i) { mask[i]=random_word()%16;if(mask[i])units|=1u<<i; }
+        assert(m->sampled_units==rsx_fp_texture_units(changed,bytes));
+        assert((m->gamma_units&units)==rsx_fp_texture_gamma_units(changed,bytes,mask));
+        assert((m->expand_units&units)==rsx_fp_texture_expand_units(changed,bytes,mask));
+        assert(rsx_fp_metadata_copy(copy,m));
+        assert(copy->bytes==m->bytes && copy->instructions==m->instructions &&
+               copy->constants==m->constants && copy->sampled_units==m->sampled_units &&
+               copy->gamma_units==m->gamma_units && copy->expand_units==m->expand_units);
+        assert(!memcmp(copy->instruction_offsets,m->instruction_offsets,n*sizeof(u32)));
+        assert(!memcmp(copy->constant_offsets,m->constant_offsets,m->constants*sizeof(u32)));
+        assert(rsx_fp_metadata_matches(copy,changed,bytes));
+        assert(copy->hash_valid && copy->last_seed==m->last_seed && copy->last_hash==m->last_hash);
+        assert(rsx_fp_metadata_hash(copy,changed,copy->last_seed)==
+               rsx_fp_structural_hash(changed,bytes,copy->last_seed));
+        rsx_fp_metadata_constants(copy,changed,&b);assert(!memcmp(&a,&b,sizeof a));
+        memset(copy->code,0,n*16u);
+        assert(rsx_fp_metadata_matches(m,changed,bytes)); /* independent ownership */
+    }
+    memset(code,0,sizeof code);word(code+65520,1);
+    assert(rsx_fp_metadata_build(m,code,65536) && m->instructions==4096);
+    assert(rsx_fp_metadata_copy(copy,m) && !copy->hash_valid);
+    assert(rsx_fp_metadata_matches(copy,code,65536));
+    assert(rsx_fp_metadata_copy(copy,copy));
+    assert(rsx_fp_metadata_matches(m,code,65536));
+    word(code+65520,0);assert(!rsx_fp_metadata_matches(m,code,65536));
+    assert(!rsx_fp_metadata_build(m,code,65536) && !m->bytes);
+    assert(!rsx_fp_metadata_copy(copy,m));
+    assert(!rsx_fp_metadata_copy(NULL,copy) && !rsx_fp_metadata_copy(copy,NULL));
+    word(code,1);word(code+8,1u<<31);
+    assert(!rsx_fp_metadata_build(m,code,16) && !m->bytes);
+    word(code+8,0);word(code+4,2);
+    assert(!rsx_fp_metadata_build(m,code,16));
+    assert(!rsx_fp_metadata_build(m,NULL,16));
+    assert(!rsx_fp_metadata_build(m,code,65537));
+    free(m);free(copy);
+    puts("PASS: 5000 random programs, every instruction mutation, live constants, identical seeded hashes/masks, independent metadata copies, maximum size, malformed and branch fallback");
+}
diff --git a/libs/video/tests/test_metal_b8_feedback.m b/libs/video/tests/test_metal_b8_feedback.m
new file mode 100644
index 0000000..e59b8c1
--- /dev/null
+++ b/libs/video/tests/test_metal_b8_feedback.m
@@ -0,0 +1,201 @@
+/* Actual engine + Metal: one-byte render-target feedback and channel identity. */
+#define main original_feedback_main
+#include "test_color_feedback_metal.m"
+#undef main
+#include <assert.h>
+
+float cellAvconfExt_display_gamma(void) { return 1; }
+int cellGcmOffsetIsDisplay(u32 o) { (void)o; assert(0); return 0; }
+u32 cellGcmResolveOffset(u32 o) { (void)o; assert(0); return 0; }
+void rsx_fetch_attrib(const rsx_state* s,int a,u32 v,float o[4])
+{ (void)s;(void)a;(void)v;(void)o; assert(0); }
+
+static void read_r8(u32 handle,u8* out)
+{
+    id<MTLTexture> t=eng_obj(handle);assert(t && t.pixelFormat==MTLPixelFormatR8Unorm);
+    const NSUInteger pitch=(t.width+255)&~255u;
+    id<MTLBuffer> b=[s_dev newBufferWithLength:pitch*t.height options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    id<MTLBlitCommandEncoder> e=[cb blitCommandEncoder];
+    [e copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+        sourceSize:MTLSizeMake(t.width,t.height,1) toBuffer:b destinationOffset:0
+        destinationBytesPerRow:pitch destinationBytesPerImage:pitch*t.height];
+    [e endEncoding];[cb commit];[cb waitUntilCompleted];
+    assert(cb.status==MTLCommandBufferStatusCompleted && !cb.error);
+    for(NSUInteger y=0;y<t.height;++y)memcpy(out+y*t.width,(u8*)b.contents+y*pitch,t.width);
+}
+static void all_codes(void)
+{
+    assert(!eng_init(NULL,257,3));
+    u8 pixels[257*3*4],got[257*3];
+    for(u32 i=0;i<257*3;++i) {
+        pixels[4*i]=(u8)(i+91);pixels[4*i+1]=(u8)(i+73);
+        pixels[4*i+2]=(u8)i;pixels[4*i+3]=(u8)(i+109);
+    }
+    const u32 src=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,257,3,pixels,257*4);
+    const u32 before=eng_color_b8_snapshot(NULL,src,257,3);
+    const float changed[4]={1,.25f,.5f,0};eng_clear_color(NULL,src,changed);
+    const u32 after=eng_color_b8_snapshot(NULL,src,257,3);
+    assert(before && after && before!=after);
+    const u32 view=eng_surface_view(NULL,before,0xAAE4,0xA1);
+    assert(view && eng_obj(view).swizzle.red==MTLTextureSwizzleRed &&
+        eng_obj(view).swizzle.green==MTLTextureSwizzleRed &&
+        eng_obj(view).swizzle.blue==MTLTextureSwizzleRed &&
+        eng_obj(view).swizzle.alpha==MTLTextureSwizzleOne);
+    const u32 count=s_eng_rec_count;
+    assert(!eng_color_b8_snapshot(NULL,src,258,3));
+    assert(!eng_color_b8_snapshot(NULL,src,0,3));
+    assert(!eng_color_b8_snapshot(NULL,before,257,3));
+    assert(s_eng_rec_count==count);
+    s_eng_rec_count=ENG_MAX_RECORDS;
+    const u32 objects=s_eng_obj_count;
+    assert(!eng_color_b8_snapshot(NULL,src,257,3) && s_eng_obj_count==objects);
+    s_eng_rec_count=count;
+    eng_obj_release(NULL,src);eng_submit_and_wait(NULL,0);assert(s_eng_checked_completed);
+    read_r8(before,got);for(u32 i=0;i<sizeof got;++i)assert(got[i]==(u8)i);
+    read_r8(after,got);for(u32 i=0;i<sizeof got;++i)assert(got[i]==128);
+    assert(!s_eng_dropped && !s_eng_encoding_failed);
+    eng_shutdown(NULL);
+    puts("PASS: all 256 blue codes, odd extent, immutable copies, queued clear ordering, retired source, B8 swizzle and invalid allocation guards");
+}
+static void target(u32 color,u32 offset)
+{
+    method(0x210,offset);method(0x20C,64*(color==9 ? 1:4));
+    method(0x200,64u<<16);method(0x204,64u<<16);method(0x208,0x140|color);
+}
+static void b8_engine(void)
+{
+    assert(!rsx_draw_engine_init(64,64));
+    method(0x194,0xFEED0000);target(9,0x40000);
+    method(0x1740,2u|(4u<<4)|(48u<<8));method(0x1680,0x80010000);
+    method(0x1744,2u|(4u<<4)|(48u<<8));method(0x1684,0x80010010);
+    method(0x1760,2u|(4u<<4)|(48u<<8));method(0x16A0,0x80010020);
+    const float v[36]={-1,-1,.2,1,.25,.5,.75,.125,.25,.5,0,1,
+        3,-1,.2,1,.25,.5,.75,.125,.25,.5,0,1,-1,3,.2,1,.25,.5,.75,.125,.25,.5,0,1};
+    for(u32 i=0;i<36;i++)bf(vm_base+0x10000+i*4,v[i]);
+    u8 vp[48];
+    rsx_test_vp_mov_out(vp,0,RSX_TEST_VP_SWZ_IDENT,0,0);
+    rsx_test_vp_mov_out(vp+16,1,RSX_TEST_VP_SWZ_IDENT,1,0);
+    rsx_test_vp_mov_out(vp+32,8,RSX_TEST_VP_SWZ_IDENT,7,1);
+    method(0x1E9C,0);
+    for(u32 i=0;i<12;i++){u32 w;memcpy(&w,vp+i*4,4);method(0xB80+i*4,w);}
+    method(0x1EA0,0);method(0x1D60,64);
+    rsx_test_fp_mov_r0_col0(vm_base+0x60000,RSX_TEST_FP_SWZ_IDENT);
+    method(0x8E4,0x60002);method(0xA74,0);method(0x324,0x01010101);
+    method(0x1D90,0xCC333366);method(0x1D94,0xF0);draw();
+    rsx_test_fp_tex_r0_tc0(vm_base+0x60040,0);method(0x8E4,0x60042);
+    method(0x1A00,0x40000);method(0x1A04,1|(2<<4)|(0xA1<<8)|(13<<16));
+    method(0x1A0C,0x80078000);method(0x1A14,0x01013F34);
+    method(0x1A10,0xAAE4);method(0x1A18,(64u<<16)|64);method(0x1840,64);
+    method(0x8C0,32u<<16);method(0x8C4,64u<<16);draw();
+    assert(g.b8_copies==1);
+    /* First prove the blue source (R and G become 191), then change blue
+     * on the left. The right-hand consumer must observe that queued write. */
+    method(0x324,1);method(0x1A10,0x6AE4);draw();
+    method(0x1A10,0xAAE4);method(0x8C0,(32u<<16)|32);draw();
+    assert(g.b8_copies==3);
+    eng_submit_and_wait(NULL,0);
+    u8 rgba[64*64*4];s_engine_backend.readback(NULL,g.surfaces[0].handle,0,0,64,64,rgba,64*4);
+    for(u32 y=0;y<64;++y)for(u32 x=0;x<64;++x) {
+        const u8* p=rgba+(y*64+x)*4;
+        assert(p[0]==(x<32?191:64) && p[1]==(x<32?191:128) &&
+            p[2]==255 && p[3]==(x<32?255:32));
+    }
+    /* Non-owning B8 aliases must also read blue, and cache only while the
+     * producer serial, dimensions and interpretation remain unchanged. */
+    target(8,0x50000);method(0x324,0x01010101);method(0x8C0,64u<<16);draw();
+    const u64 copies=g.b8_copies;draw();assert(g.b8_copies==copies && g.b8_reuses==1);
+    eng_submit_and_wait(NULL,0);
+    s_engine_backend.readback(NULL,g.surfaces[1].handle,0,0,64,64,rgba,64*4);
+    for(u32 i=0;i<sizeof rgba;++i)assert(rgba[i]==255);
+    target(9,0x40000);method(0x1D90,0xE0203019);method(0x1D94,0xF0);
+    target(8,0x50000);draw();assert(g.b8_copies==copies+1);
+    eng_submit_and_wait(NULL,0);
+    s_engine_backend.readback(NULL,g.surfaces[1].handle,0,0,64,64,rgba,64*4);
+    for(u32 i=0;i<64*64;++i)assert(rgba[4*i]==25 && rgba[4*i+1]==25 &&
+        rgba[4*i+2]==25 && rgba[4*i+3]==255);
+    /* Unsupported feedback must still fail, never sample stale/red bytes. */
+    rsx_dsp_texture t;rsx_dsp_get_texture(&g.rsx,0,&t);
+    eng_surface s=g.surfaces[0];assert(eng_b8_texture_compatible(&s,&t));
+    t.filter=0x01030000;assert(!eng_b8_texture_compatible(&s,&t));t.filter=0x01010000;
+    t.pitch=65;assert(!eng_b8_texture_compatible(&s,&t));t.pitch=64;
+    t.control0|=1u<<19;assert(!eng_b8_texture_compatible(&s,&t));t.control0=0x80078000;
+    t.format&=~0x20u;assert(!eng_b8_texture_compatible(&s,&t));t.format|=0x20u;
+    t.cubemap=1;assert(!eng_b8_texture_compatible(&s,&t));t.cubemap=0;
+    s.antialias=3;assert(!eng_b8_texture_compatible(&s,&t));s.antialias=0;
+    s.color_format=8;assert(!eng_b8_texture_compatible(&s,&t));s.color_format=9;
+    const u32 old_offset=g.surfaces[1].offset;g.surfaces[1].offset=s.offset+1;
+    assert(!eng_b8_no_newer_alias(&s,&t));g.surfaces[1].offset=old_offset;
+    assert(eng_b8_no_newer_alias(&s,&t));
+    g.b8_feedback=0;assert(!eng_b8_texture_compatible(&s,&t));g.b8_feedback=1;
+    /* Seven pitched levels: three live GPU producers and four untouched
+     * guest levels. Force each LOD through the real fragment shader/sampler
+     * so a correct base image with missing lower levels cannot pass. */
+    const u32 starts[7]={0,5120,7680,8960,9600,9920,10080};
+    memset(vm_base+0x70000,0xEE,10160);
+    for (u32 m=0;m<7;++m) {
+        const u32 w=64u>>m;
+        for(u32 y=0;y<w;++y)memset(vm_base+0x70000+starts[m]+y*80,21+31*m,w);
+        if (m==0 || m==2 || m==4) {
+            method(0x210,0x70000+starts[m]);method(0x20C,80);
+            method(0x200,w<<16);method(0x204,w<<16);method(0x208,0x149);
+            method(0x1D90,0xCC112200|(21+31*m));method(0x1D94,0xF0);
+        }
+    }
+    target(8,0x50000);
+    method(0x1A00,0x70000);method(0x1A04,1|(2<<4)|(0xA1<<8)|(7<<16));
+    method(0x1840,80);method(0x1A14,0x01030000);
+    const u64 before_mips=g.b8_copies;
+    for (u32 m=0;m<7;++m) {
+        method(0x1A0C,0x80000000|((m*256)<<19)|((m*256)<<7));draw();
+        eng_submit_and_wait(NULL,0);
+        s_engine_backend.readback(NULL,g.surfaces[1].handle,0,0,64,64,rgba,64*4);
+        for(u32 i=0;i<64*64;++i) {
+            if (rgba[4*i]!=21+31*m)
+                fprintf(stderr,"B8 mip %u pixel %u: got %u expected %u\n",m,i,rgba[4*i],21+31*m);
+            assert(rgba[4*i]==21+31*m && rgba[4*i+1]==21+31*m &&
+                   rgba[4*i+2]==21+31*m && rgba[4*i+3]==255);
+        }
+    }
+    assert(g.b8_copies==before_mips+1);
+    /* A CPU update to an untouched level must invalidate the assembled
+     * texture, even within the same presented frame. */
+    memset(vm_base+0x70000+starts[6],243,1);draw();
+    eng_submit_and_wait(NULL,0);
+    s_engine_backend.readback(NULL,g.surfaces[1].handle,0,0,64,64,rgba,64*4);
+    assert(rgba[0]==243 && g.b8_copies==before_mips+2);
+    /* A queued GPU write to a different level must also be visible. */
+    method(0x210,0x70000+starts[2]);method(0x20C,80);
+    method(0x200,16u<<16);method(0x204,16u<<16);method(0x208,0x149);
+    method(0x1D90,0xCC11225A);method(0x1D94,0xF0);
+    target(8,0x50000);method(0x1A0C,0x80000000|(512u<<19)|(512u<<7));draw();
+    eng_submit_and_wait(NULL,0);
+    s_engine_backend.readback(NULL,g.surfaces[1].handle,0,0,64,64,rgba,64*4);
+    assert(rgba[0]==90 && g.b8_copies==before_mips+3);
+    /* The entire assembly is guarded before allocating/queuing any work. */
+    rsx_dsp_get_texture(&g.rsx,0,&t);
+    eng_surface* root=NULL;
+    for(u32 i=0;i<g.n_surfaces;++i)if(g.surfaces[i].offset==0x70000)root=&g.surfaces[i];
+    assert(root);
+    const u32 previous=g.surfaces[1].offset;
+    g.surfaces[1].offset=0x70000+starts[2]+1;
+    assert(!eng_b8_sampled_snapshot(root,&t));g.surfaces[1].offset=previous;
+    puts("PASS: seven pitched B8 mips sampled individually, mixed GPU/CPU producers, reuse and same-frame CPU/GPU invalidation");
+    assert(!s_eng_dropped && !s_eng_encoding_failed);
+    rsx_draw_engine_shutdown();assert(!g.b8_copies && !g.b8_feedback);
+    puts("PASS: actual B8 producer/consumers, 13 declared mips with nearest filter, blue-only write mask, prior consumer visibility, non-owning alias, reuse/invalidation and strict rejection guards");
+}
+int main(void) { @autoreleasepool {
+    s_dev=MTLCreateSystemDefaultDevice();assert(s_dev);s_queue=[s_dev newCommandQueue];
+    s_headless=1;s_guest_shaders=1;
+    assert(!create_placeholders()); /* Same default bindings as the native app. */
+    all_codes();
+    vm_base=calloc(1,1u<<20);ppu_vm_size=1u<<20;assert(vm_base);
+    setenv("RSX_B8_SURFACE_FEEDBACK","1",1);
+    rsx_draw_engine_set_backend(&s_engine_backend);
+    b8_engine();
+    run(0,1,1);formats(); /* Existing ordered RGBA/float feedback still works. */
+    rsx_draw_engine_set_backend(NULL);free(vm_base);
+    printf("B8/legacy feedback checks=%u failures=%u\n",checks,failures);
+    return failures?1:0;
+} }
diff --git a/libs/video/tests/test_metal_b8_seed.m b/libs/video/tests/test_metal_b8_seed.m
new file mode 100644
index 0000000..ab75ed6
--- /dev/null
+++ b/libs/video/tests/test_metal_b8_seed.m
@@ -0,0 +1,79 @@
+/* Exercise the actual Metal initializer and queued seed/snapshot/clear path. */
+#define ENG_STAGE_MAX (32u << 20)
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+float cellAvconfExt_display_gamma(void) { return 1; }
+int cellGcmOffsetIsDisplay(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveOffset(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveLocated(int loc,u32 off) { (void)loc;(void)off;assert(0);return 0; }
+void rsx_fetch_attrib(const rsx_state* st,int idx,u32 vi,float out[4]) { (void)st;(void)idx;(void)vi;(void)out;assert(0); }
+
+static void check_texture(u32 handle,u32 w,u32 h,int cleared)
+{
+    id<MTLTexture> texture=eng_obj(handle); assert(texture);
+    const u32 pitch=(w*4+255)&~255u;
+    id<MTLBuffer> read=[s_dev newBufferWithLength:(size_t)pitch*h options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    id<MTLBlitCommandEncoder> copy=[cb blitCommandEncoder];
+    [copy copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+        sourceSize:MTLSizeMake(w,h,1) toBuffer:read destinationOffset:0
+        destinationBytesPerRow:pitch destinationBytesPerImage:(size_t)pitch*h];
+    [copy endEncoding];[cb commit];[cb waitUntilCompleted];
+    assert(cb.status==MTLCommandBufferStatusCompleted && !cb.error);
+    for(u32 y=0;y<h;++y)for(u32 x=0;x<w;++x) {
+        const u8* p=(const u8*)read.contents+(size_t)y*pitch+x*4;
+        u8 b=(u8)(x+y*37);
+        assert(p[0]==(cleared?255:b) && p[1]==(cleared?0:b) &&
+               p[2]==(cleared?0:b) && p[3]==255);
+    }
+}
+static void layout(u32 w,u32 h,u32 pad,int rollover)
+{
+    u32 pitch=w+pad,span=(h-1)*pitch+w;
+    u8* source=malloc(span);assert(source);memset(source,0xe7,span);
+    for(u32 y=0;y<h;++y)for(u32 x=0;x<w;++x)source[(size_t)y*pitch+x]=(u8)(x+y*37);
+    u32 seed=eng_color_target_create_b8(NULL,w,h,source,pitch);assert(seed);
+    memset(source,0xab,span);free(source); /* No deferred guest reads. */
+    u32 before=eng_color_snapshot(NULL,seed);assert(before);
+    const float red[4]={1,0,0,1};eng_clear_color(NULL,seed,red);
+    u32 after=eng_color_snapshot(NULL,seed);assert(after);
+    eng_obj_release(NULL,seed); /* Queued commands still own the old handle. */
+    if(rollover) {
+        u32 padding;
+        const u32 aligned=(s_eng_stage_used+255)&~255u;
+        assert(eng_stage_reserve(ENG_STAGE_MAX-256-aligned,&padding));
+        const u8 next[17]={0};
+        u32 following=eng_color_target_create_b8(NULL,17,1,next,17);assert(following);
+        /* 256-byte aligned 17-byte reservation still fits; force next seed
+         * across the arena boundary with a 257-byte row. */
+        u8 next_row[257]={0};
+        u32 crossed=eng_color_target_create_b8(NULL,257,1,next_row,257);assert(crossed);
+        assert(s_eng_rec_count==1 && s_eng_rec[0].packed_off==0);
+        eng_obj_release(NULL,following);eng_obj_release(NULL,crossed);
+    }
+    eng_submit_and_wait(NULL,0);assert(s_eng_checked_completed && !s_eng_encoding_failed);
+    check_texture(before,w,h,0);check_texture(after,w,h,1);
+    eng_obj_release(NULL,before);eng_obj_release(NULL,after);
+    eng_submit_and_wait(NULL,0);
+}
+int main(void) { @autoreleasepool {
+    s_dev=MTLCreateSystemDefaultDevice();assert(s_dev);s_queue=[s_dev newCommandQueue];
+    setenv("RSX_SURFACE_GPU_SEED","1",1);
+    for(int direct=0;direct<2;++direct) {
+        setenv("RSX_METAL_DIRECT_STAGE",direct?"1":"0",1);
+        assert(!eng_init(NULL,1280,720) && s_eng_b8_seed_pso);
+        layout(256,3,19,0);layout(17,13,7,1);layout(1,1,0,0);
+        layout(4096,4096,0,0);
+        const u8 byte=0;
+        assert(!eng_color_target_create_b8(NULL,0,1,&byte,1));
+        assert(!eng_color_target_create_b8(NULL,2,1,&byte,1));
+        assert(!eng_color_target_create_b8(NULL,1,1,NULL,1));
+        assert(!eng_color_target_create_b8(NULL,8192,8192,&byte,8192));
+        s_eng_b8_seed_pso=nil;
+        assert(!eng_color_target_create_b8(NULL,1,1,&byte,1));
+        eng_shutdown(NULL);
+    }
+    puts("PASS: all 256 B8 values, padded and tight final rows, 4096-square image, immutable source, seed/snapshot/clear order, retired handles, arena rollover, copied/shared staging and fallback guards");
+    return 0;
+}}
diff --git a/libs/video/tests/test_metal_bc_volume.m b/libs/video/tests/test_metal_bc_volume.m
new file mode 100644
index 0000000..fd801e6
--- /dev/null
+++ b/libs/video/tests/test_metal_bc_volume.m
@@ -0,0 +1,135 @@
+/* Exact upload check plus an independent BC palette/precision oracle.
+ * BC1-3 hardware decoding is not required to match bcdec bit for bit. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+float cellAvconfExt_display_gamma(void) { return 1; }
+int cellGcmOffsetIsDisplay(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveOffset(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveLocated(int loc,u32 off) { (void)loc;(void)off;assert(0);return 0; }
+void rsx_fetch_attrib(const rsx_state* s,int i,u32 v,float o[4])
+{ (void)s;(void)i;(void)v;(void)o;assert(0); }
+
+/* Direct3D 11.3 functional specification 19.5.2 and 19.5.6-8:
+ * https://microsoft.github.io/DirectX-Specs/d3d/archive/D3D11_3_FunctionalSpec.htm
+ * This is a format sanity check, not a claim of PS3 decoder equivalence. */
+static void bc_reference(const u8* block,u32 fmt,u32 x,u32 y,float value[4],float bound[4])
+{
+    const u8* rgb=block+(fmt==0x86 ? 0 : 8);
+    const unsigned c0=rgb[0]|rgb[1]<<8,c1=rgb[2]|rgb[3]<<8,p=y*4+x;
+    const unsigned selector=(rgb[4+p/4]>>(2*(p%4)))&3;
+    for(unsigned c=0;c<3;++c) {
+        unsigned shift=c==0 ? 11 : c==1 ? 5 : 0,bits=c==1 ? 6 : 5,mask=(1u<<bits)-1;
+        unsigned a=(c0>>shift)&mask,b=(c1>>shift)&mask;
+        float ap=((a<<(8-bits))|(a>>(2*bits-8)))/255.f;
+        float bp=((b<<(8-bits))|(b>>(2*bits-8)))/255.f;
+        bound[c]=1.f/255+.03f*fmaxf(fabsf(ap-bp),fabsf((float)a/mask-(float)b/mask));
+        value[c]=selector==0 ? ap : selector==1 ? bp :
+            (fmt!=0x86 || c0>c1) ? (selector==2 ? (2*ap+bp)/3 : (ap+2*bp)/3) :
+            selector==2 ? (ap+bp)/2 : 0;
+    }
+    value[3]=fmt==0x86 && c0<=c1 && selector==3 ? 0 : 1;
+    bound[3]=1.f/255;
+    if(fmt==0x87) value[3]=((block[p/2]>>(4*(p%2)))&15)/15.f;
+    if(fmt==0x88) {
+        uint64_t selectors=0;
+        for(unsigned b=0;b<6;++b)selectors|=(uint64_t)block[2+b]<<(8*b);
+        unsigned s=(selectors>>(3*p))&7;
+        float a=block[0]/255.f,b=block[1]/255.f;
+        bound[3]+=.03f*fabsf(a-b);
+        value[3]=s==0 ? a : s==1 ? b :
+            block[0]>block[1] ? ((8-s)*a+(s-1)*b)/7 :
+            s<6 ? ((6-s)*a+(s-1)*b)/5 : s==6 ? 0 : 1;
+    }
+}
+
+int main(void) { @autoreleasepool {
+    s_dev=MTLCreateSystemDefaultDevice();assert(s_dev);
+    s_queue=[s_dev newCommandQueue];
+    NSString* source=@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "kernel void compare(texture2d_array<float,access::read> bc [[texture(0)]],"
+        "texture3d<float,access::read> volume [[texture(1)]],"
+        "device float4* out [[buffer(0)]],constant uint4& p [[buffer(1)]],uint3 q [[thread_position_in_grid]]) {"
+        "if(q.x>=p.y||q.y>=p.z||q.z>=p.w)return;"
+        "uint i=(q.z*p.z+q.y)*p.y+q.x;"
+        "out[i*2]=bc.read(q.xy,q.z,p.x);out[i*2+1]=volume.read(q,p.x);}";
+    NSError* error=nil;
+    id<MTLLibrary> lib=[s_dev newLibraryWithSource:source options:nil error:&error];assert(lib);
+    id<MTLComputePipelineState> pipe=[s_dev newComputePipelineStateWithFunction:
+        [lib newFunctionWithName:@"compare"] error:&error];assert(pipe);
+    u32 random=0x91c0ffee; unsigned tested=0,unequal=0;float largest=0;
+    double total_difference=0;
+    for(u32 fmt=0x86;fmt<=0x88;++fmt) {
+        rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+        const u32 levels=rsx_texture_mip_chain(fmt,32,32,6,0,lv);assert(levels==6);
+        MTLTextureDescriptor* td=[MTLTextureDescriptor new];
+        td.textureType=MTLTextureType2DArray;td.width=td.height=32;td.arrayLength=16;
+        td.mipmapLevelCount=6;td.usage=MTLTextureUsageShaderRead;
+        td.storageMode=MTLStorageModeShared;
+        td.pixelFormat=fmt==0x86 ? MTLPixelFormatBC1_RGBA : fmt==0x87 ? MTLPixelFormatBC2_RGBA : MTLPixelFormatBC3_RGBA;
+        id<MTLTexture> reference=[s_dev newTextureWithDescriptor:td];assert(reference);
+        const u32 volume=eng_texture_create_3d(NULL,RSX_BE_FMT_R8G8B8A8,32,32,16,6,0xaae4,fmt);
+        assert(volume && eng_obj(volume).textureType==MTLTextureType3D);
+        u32 depth=16;
+        for(u32 mip=0;mip<levels;++mip) {
+            const rsx_tex_layout* tl=&lv[mip].tl;const u32 w=lv[mip].w,h=lv[mip].h;
+            size_t channels=(size_t)w*h*depth*4;
+            u8* expected=malloc(channels);assert(expected);
+            float* ideal=malloc(channels*sizeof(float));assert(ideal);
+            float* tolerance=malloc(channels*sizeof(float));assert(tolerance);
+            for(u32 z=0;z<depth;++z) {
+                u8 source_bytes[1025],rgba[32*32*4+32];
+                assert(tl->face_bytes<sizeof source_bytes);
+                /* Odd source alignment and guards exercise the thin wrapper. */
+                for(u32 b=0;b<tl->face_bytes;++b) {
+                    random=random*1664525u+1013904223u;source_bytes[b+1]=(u8)(random>>24);
+                }
+                memset(rgba,0xcd,sizeof rgba);
+                assert(rsx_texture_decode_bc_rgba8(rgba+16,w*4,source_bytes+1,w,h,tl));
+                for(unsigned b=0;b<16;++b) assert(rgba[b]==0xcd && rgba[16+w*h*4+b]==0xcd);
+                memcpy(expected+z*w*h*4,rgba+16,w*h*4);
+                for(u32 y=0;y<h;++y)for(u32 x=0;x<w;++x) {
+                    size_t i=((size_t)z*h*w+y*w+x)*4;
+                    const u8* block=source_bytes+1+(y/4)*tl->row_bytes+(x/4)*(fmt==0x86 ? 8 : 16);
+                    bc_reference(block,fmt,x%4,y%4,ideal+i,tolerance+i);
+                }
+                eng_texture_upload_3d(NULL,volume,z,mip,w,h,rgba+16,w*4);
+                [reference replaceRegion:MTLRegionMake2D(0,0,w,h) mipmapLevel:mip slice:z
+                    withBytes:source_bytes+1 bytesPerRow:tl->row_bytes bytesPerImage:tl->face_bytes];
+            }
+            id<MTLBuffer> output=[s_dev newBufferWithLength:w*h*depth*32 options:MTLResourceStorageModeShared];
+            const u32 dimensions[4]={mip,w,h,depth};
+            id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+            id<MTLComputeCommandEncoder> enc=[cb computeCommandEncoder];
+            [enc setComputePipelineState:pipe];[enc setTexture:reference atIndex:0];
+            [enc setTexture:eng_obj(volume) atIndex:1];
+            [enc setBuffer:output offset:0 atIndex:0];[enc setBytes:dimensions length:16 atIndex:1];
+            [enc dispatchThreads:MTLSizeMake(w,h,depth) threadsPerThreadgroup:MTLSizeMake(8,8,1)];
+            [enc endEncoding];[cb commit];[cb waitUntilCompleted];
+            assert(cb.status==MTLCommandBufferStatusCompleted);
+            const float* pixels=output.contents;
+            for(u32 i=0;i<w*h*depth;++i) for(unsigned c=0;c<4;++c) {
+                size_t j=i*4+c;
+                /* A byte-identical readback of every uploaded slice/mip is
+                 * required independently of the BC hardware comparison. */
+                assert(lroundf(pixels[i*8+4+c]*255)==expected[j]);
+                for(unsigned lane=0;lane<2;++lane) {
+                    float actual=pixels[i*8+lane*4+c];
+                    float error=fabsf(actual-ideal[j]);
+                    if(ideal[j]==0 || ideal[j]==1)assert(error<1e-6f);
+                    else assert(error<tolerance[j]+1e-6f);
+                }
+                float delta=fabsf(pixels[i*8+c]-pixels[i*8+4+c])*255;
+                if(delta>largest)largest=delta;
+                if(delta>.01f)++unequal;
+                total_difference+=delta;tested++;
+            }
+            free(tolerance);free(ideal);free(expected);
+            if(depth>1)depth>>=1;
+        }
+        eng_obj_release(NULL,volume);
+    }
+    eng_collect_retired_objects();
+    printf("PASS: %u BC1/2/3 volume channel samples read back byte-exactly across all slices and six mips; odd alignment and guards pass. Both bcdec and Metal BC satisfy the independent palette/precision oracle. Hardware/software differences: %u samples, max %.3f/255, mean %.6f/255 (not bit-exact decoder equivalence).\n",tested,unequal,largest,total_difference/tested);
+    return 0;
+} }
diff --git a/libs/video/tests/test_metal_color_crop.m b/libs/video/tests/test_metal_color_crop.m
new file mode 100644
index 0000000..ea66aee
--- /dev/null
+++ b/libs/video/tests/test_metal_color_crop.m
@@ -0,0 +1,111 @@
+/* Real-device tests for ordered, immutable render-target subresources. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+float cellAvconfExt_display_gamma(void) { return 1; }
+int cellGcmOffsetIsDisplay(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveOffset(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveLocated(int loc,u32 off) { (void)loc;(void)off;assert(0);return 0; }
+void rsx_fetch_attrib(const rsx_state* st,int idx,u32 vi,float out[4]) { (void)st;(void)idx;(void)vi;(void)out;assert(0); }
+
+static void read_private(u32 handle, void* out, u32 bpp)
+{
+    id<MTLTexture> t=eng_obj(handle);assert(t);
+    const NSUInteger pitch=(t.width*bpp+255)&~255u;
+    id<MTLBuffer> buffer=[s_dev newBufferWithLength:pitch*t.height options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    id<MTLBlitCommandEncoder> copy=[cb blitCommandEncoder];
+    [copy copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+              sourceSize:MTLSizeMake(t.width,t.height,1) toBuffer:buffer destinationOffset:0
+   destinationBytesPerRow:pitch destinationBytesPerImage:pitch*t.height];
+    [copy endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+    for(NSUInteger y=0;y<t.height;++y)
+        memcpy((u8*)out+y*t.width*bpp,(u8*)buffer.contents+y*pitch,t.width*bpp);
+}
+
+int main(void) { @autoreleasepool {
+    s_dev=MTLCreateSystemDefaultDevice();assert(s_dev);s_queue=[s_dev newCommandQueue];
+    assert(eng_init(NULL,1280,720)==0);
+    u8 seed[17*11*4];for(u32 i=0;i<sizeof seed;i++)seed[i]=(u8)(i*37u);
+    const u32 src=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,17,11,seed,17*4);
+    const u32 full=eng_color_snapshot(NULL,src);
+    const u32 crop=eng_color_region_snapshot(NULL,src,3,2,7,5);
+    assert(full && crop && eng_obj(crop).width==7 && eng_obj(crop).height==5);
+    const float red[4]={1,0,0,1};eng_clear_color(NULL,src,red);
+    const u32 after=eng_color_region_snapshot(NULL,src,3,2,7,5);assert(after && after!=crop);
+    const u32 view=eng_surface_view(NULL,crop,0xAAE4,0xA5);assert(view);
+    assert(eng_surface_view(NULL,crop,0xAAE4,0xA5)==view);
+    assert(eng_obj(view).width==7 && eng_obj(view).swizzle.red==MTLTextureSwizzleRed);
+    /* Retiring the source before submission must preserve queued copies. */
+    eng_obj_release(NULL,src);eng_submit_and_wait(NULL,0);assert(s_eng_checked_completed);
+    u8 all[sizeof seed],part[7*5*4],later[7*5*4];
+    read_private(full,all,4);read_private(crop,part,4);read_private(after,later,4);
+    assert(!memcmp(all,seed,sizeof seed));
+    for(u32 y=0;y<5;y++)for(u32 x=0;x<7;x++) {
+        assert(!memcmp(part+(y*7+x)*4,seed+((y+2)*17+x+3)*4,4));
+        assert(later[(y*7+x)*4]==255 && later[(y*7+x)*4+1]==0 &&
+               later[(y*7+x)*4+2]==0 && later[(y*7+x)*4+3]==255);
+    }
+    puts("PASS: exact RGBA crop, nonzero origin, full snapshot, write ordering, immutable copies, retired source and view reuse");
+    u16 half[13*9*4];for(u32 i=0;i<13*9*4;i++)half[i]=(u16)(0x2800u+i);
+    const u32 hdr=eng_color_target_create(NULL,RSX_BE_FMT_R16G16B16A16F,13,9,half,13*8);
+    const u32 hc=eng_color_region_snapshot(NULL,hdr,1,3,8,4);assert(hc);
+    eng_submit_and_wait(NULL,0);assert(s_eng_checked_completed);
+    u16 hback[8*4*4];read_private(hc,hback,8);
+    for(u32 y=0;y<4;y++)for(u32 x=0;x<8;x++)
+        assert(!memcmp(hback+(y*8+x)*4,half+((y+3)*13+x+1)*4,8));
+    puts("PASS: FP16 crop preserves every component bit");
+    const u32 before=s_eng_rec_count;
+    assert(!eng_color_region_snapshot(NULL,hdr,12,0,2,1));
+    assert(!eng_color_region_snapshot(NULL,hdr,0,0,0,1));
+    assert(!eng_color_region_snapshot(NULL,hdr,UINT32_MAX,0,1,1));
+    assert(s_eng_rec_count==before && !s_eng_dropped);
+    puts("PASS: out-of-bounds and empty copies emit no GPU record");
+    /* Hold the queue, then submit through the production draw-boundary hook.
+     * It must return before completion and preserve retired source objects. */
+    id<MTLSharedEvent> gate=[s_dev newSharedEvent];
+    id<MTLCommandBuffer> blocked=[s_queue commandBuffer];
+    [blocked encodeWaitForEvent:gate value:1];[blocked commit];
+    const u32 delayed=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,17,11,seed,17*4);
+    u32 copies[64];
+    for(u32 i=0;i<64;i++)copies[i]=eng_color_snapshot(NULL,delayed);
+    s_eng_early_records=64;
+    assert(eng_prepare_draw(NULL,0));
+    assert(s_eng_rec_count==0 && s_eng_early_count==1 && !s_eng_checked_completed);
+    assert(s_eng_early[0].status<MTLCommandBufferStatusCompleted);
+    eng_obj_release(NULL,delayed);
+    const u32 reused=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,17,11,NULL,0);
+    assert(reused==delayed); /* numeric handle recycled, GPU object retained */
+    eng_clear_color(NULL,reused,red);
+    gate.signaledValue=1;
+    eng_submit_and_wait(NULL,0);assert(s_eng_checked_completed && !s_eng_early_count);
+    for(u32 i=0;i<64;i++) {
+        read_private(copies[i],all,4);assert(!memcmp(all,seed,sizeof seed));
+        eng_obj_release(NULL,copies[i]);
+    }
+    puts("PASS: early draw-boundary submission is asynchronous and retains retired resources until GPU completion");
+
+    /* A caller overwriting a previously bound texture must fence its earlier
+     * consumers even while early submissions are enabled. */
+    eng_texture_upload(NULL,reused,0,0,17,11,seed,17*4,11);
+    u32 textures[RSX_BE_MAX_TEXTURES]={reused};
+    rsx_be_sampler_desc sampler[RSX_BE_MAX_TEXTURES]={0};
+    eng_bind_textures(NULL,textures,sampler,1);
+    gate=[s_dev newSharedEvent];blocked=[s_queue commandBuffer];
+    [blocked encodeWaitForEvent:gate value:1];[blocked commit];
+    const u32 old=eng_color_snapshot(NULL,reused);
+    eng_encode_and_commit_mode(nil,1);
+    __block int released=0;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW,20*NSEC_PER_MSEC),
+        dispatch_get_global_queue(QOS_CLASS_DEFAULT,0), ^{
+            __atomic_store_n(&released,1,__ATOMIC_RELEASE);gate.signaledValue=1;
+        });
+    u8 replacement[sizeof seed];memset(replacement,0x83,sizeof replacement);
+    eng_texture_upload(NULL,reused,0,0,17,11,replacement,17*4,11);
+    assert(__atomic_load_n(&released,__ATOMIC_ACQUIRE));
+    read_private(old,all,4);assert(!memcmp(all,seed,sizeof seed));
+    read_private(reused,all,4);assert(!memcmp(all,replacement,sizeof replacement));
+    puts("PASS: overwrite waits for earlier consumers and preserves the pre-update snapshot");
+    eng_shutdown(NULL);
+    return 0;
+}}
diff --git a/libs/video/tests/test_metal_cube_snapshot.m b/libs/video/tests/test_metal_cube_snapshot.m
new file mode 100644
index 0000000..9b7373f
--- /dev/null
+++ b/libs/video/tests/test_metal_cube_snapshot.m
@@ -0,0 +1,101 @@
+/* Actual GPU cube gathering, directional sampling and immutable lifetime. */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+u8* vm_base;
+float cellAvconfExt_display_gamma(void) { return 1; }
+int cellGcmOffsetIsDisplay(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveOffset(u32 off) { (void)off; assert(0); return 0; }
+u32 cellGcmResolveLocated(int loc,u32 off) { (void)loc;(void)off;assert(0);return 0; }
+void rsx_fetch_attrib(const rsx_state* s,int i,u32 v,float o[4])
+{ (void)s;(void)i;(void)v;(void)o;assert(0); }
+
+static void read_cube(u32 handle, unsigned bytes, void* pixels)
+{
+    id<MTLTexture> cube=eng_obj(handle); assert(cube.textureType==MTLTextureTypeCube);
+    const NSUInteger pitch=(cube.width*bytes+255)&~255u, plane=pitch*cube.height;
+    id<MTLBuffer> out=[s_dev newBufferWithLength:plane*6 options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    id<MTLBlitCommandEncoder> copy=[cb blitCommandEncoder];
+    for (unsigned f=0;f<6;++f)
+        [copy copyFromTexture:cube sourceSlice:f sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+            sourceSize:MTLSizeMake(cube.width,cube.height,1) toBuffer:out destinationOffset:plane*f
+            destinationBytesPerRow:pitch destinationBytesPerImage:plane];
+    [copy endEncoding];[cb commit];[cb waitUntilCompleted];
+    assert(cb.status==MTLCommandBufferStatusCompleted);
+    for(unsigned f=0;f<6;++f) for(NSUInteger y=0;y<cube.height;++y)
+        memcpy((u8*)pixels+(f*cube.height+y)*cube.width*bytes,
+               (u8*)out.contents+f*plane+y*pitch,cube.width*bytes);
+}
+
+static void sample_axes(u32 cube, const u8 seed[6][16*16*4])
+{
+    NSString* source=@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "vertex float4 vs(uint i [[vertex_id]]) {return float4(i==1?3.:-1.,i==2?3.:-1.,0.,1.);}\n"
+        "fragment float4 fs(float4 p [[position]],texturecube<float> t [[texture(0)]]) {"
+        "const float3 dir[6]={float3(1,0,0),float3(-1,0,0),float3(0,1,0),"
+        "float3(0,-1,0),float3(0,0,1),float3(0,0,-1)};"
+        "constexpr sampler s(filter::nearest);return t.sample(s,dir[uint(p.x)],level(0));}";
+    NSError* error=nil;
+    id<MTLLibrary> lib=[s_dev newLibraryWithSource:source options:nil error:&error];assert(lib);
+    MTLRenderPipelineDescriptor* pd=[MTLRenderPipelineDescriptor new];
+    pd.vertexFunction=[lib newFunctionWithName:@"vs"]; pd.fragmentFunction=[lib newFunctionWithName:@"fs"];
+    pd.colorAttachments[0].pixelFormat=MTLPixelFormatRGBA8Unorm;
+    id<MTLRenderPipelineState> p=[s_dev newRenderPipelineStateWithDescriptor:pd error:&error];assert(p);
+    MTLTextureDescriptor* td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:
+        MTLPixelFormatRGBA8Unorm width:6 height:1 mipmapped:NO];
+    td.usage=MTLTextureUsageRenderTarget;td.storageMode=MTLStorageModeShared;
+    id<MTLTexture> result=[s_dev newTextureWithDescriptor:td];
+    MTLRenderPassDescriptor* pass=[MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture=result;pass.colorAttachments[0].loadAction=MTLLoadActionDontCare;
+    pass.colorAttachments[0].storeAction=MTLStoreActionStore;
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    id<MTLRenderCommandEncoder> enc=[cb renderCommandEncoderWithDescriptor:pass];
+    [enc setRenderPipelineState:p];[enc setFragmentTexture:eng_obj(cube) atIndex:0];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];[enc endEncoding];
+    [cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+    u8 out[6*4];[result getBytes:out bytesPerRow:24 fromRegion:MTLRegionMake2D(0,0,6,1) mipmapLevel:0];
+    for(unsigned f=0;f<6;++f) {
+        const u8* expected=seed[f]+(8*16+8)*4;
+        assert(out[f*4]==expected[2] && out[f*4+1]==expected[1] &&
+               out[f*4+2]==expected[0] && out[f*4+3]==expected[3]);
+    }
+}
+
+int main(void) { @autoreleasepool {
+    s_dev=MTLCreateSystemDefaultDevice();assert(s_dev);s_queue=[s_dev newCommandQueue];
+    assert(!eng_init(NULL,16,16));
+    u32 faces[6];u8 seed[6][16*16*4],back[sizeof seed];
+    for(unsigned f=0;f<6;++f) {
+        for(unsigned i=0;i<sizeof seed[f];++i) seed[f][i]=(u8)(f*31+i*13+i/11);
+        faces[f]=eng_color_target_create(NULL,RSX_BE_FMT_R8G8B8A8,16,16,seed[f],64);
+        assert(faces[f]);
+    }
+    const u32 first=eng_cube_snapshot(NULL,faces,0xaae4,0xa5);
+    const u32 swizzled=eng_cube_snapshot(NULL,faces,0xaa6c,0xa5);
+    assert(first && swizzled && first!=faces[0]);
+    const float red[4]={1,0,0,1};
+    for(unsigned f=0;f<6;++f) eng_clear_color(NULL,faces[f],red);
+    const u32 later=eng_cube_snapshot(NULL,faces,0xaae4,0xa5);assert(later);
+    for(unsigned f=0;f<6;++f) eng_obj_release(NULL,faces[f]);
+    eng_submit_and_wait(NULL,0);assert(s_eng_checked_completed && !s_eng_encoding_failed);
+    read_cube(first,4,back);assert(!memcmp(seed,back,sizeof seed));
+    sample_axes(swizzled,seed);
+    read_cube(later,4,back);
+    for(unsigned i=0;i<sizeof back;i+=4)
+        assert(back[i]==255 && back[i+1]==0 && back[i+2]==0 && back[i+3]==255);
+    /* HDR bytes must also survive without quantization or channel rotation. */
+    u16 hdr[6][8*8*4],hback[6][8*8*4];
+    for(unsigned f=0;f<6;++f) {
+        for(unsigned i=0;i<8*8*4;++i) hdr[f][i]=(u16)(0x2800+f*257+i);
+        faces[f]=eng_color_target_create(NULL,RSX_BE_FMT_R16G16B16A16F,8,8,hdr[f],64);
+    }
+    const u32 hc=eng_cube_snapshot(NULL,faces,0xaae4,0xba);assert(hc);
+    eng_submit_and_wait(NULL,0);assert(s_eng_checked_completed);
+    read_cube(hc,8,hback);assert(!memcmp(hdr,hback,sizeof hdr));
+    faces[5]=eng_color_target_create(NULL,RSX_BE_FMT_R16G16B16A16F,4,4,NULL,0);
+    u32 records=s_eng_rec_count;
+    assert(!eng_cube_snapshot(NULL,faces,0xaae4,0xba) && s_eng_rec_count==records);
+    eng_shutdown(NULL);
+    puts("PASS: six distinct RGBA8/FP16 faces, all cube axes and crossbar, snapshot ordering, retired sources, and invalid dimensions");
+    return 0;
+} }
diff --git a/libs/video/tests/test_metal_depth_bias.m b/libs/video/tests/test_metal_depth_bias.m
