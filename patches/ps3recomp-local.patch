+/* The render owner polls once per present, never per draw/CPU hook. This arms
+ * a fresh window after a HUD has actually been observed. The ack gives the
+ * controller exact CLOCK_MONOTONIC boundaries, independent of boot duration. */
+static inline void ps3_ft_poll_trigger(void)
+{
+    ps3_ft_state* s=&g_ps3_ft;
+    if (__atomic_load_n(&s->on,__ATOMIC_ACQUIRE)!=4) return;
+    FILE* f=fopen(s->trigger_path,"r");
+    if (!f)return;
+    const int arm=fgetc(f)=='1';fclose(f);
+    if (!arm)return;
+    int expected=4;
+    if (!__atomic_compare_exchange_n(&s->on,&expected,1,0,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))return;
+    s->start=ps3_ft_now()+s->trigger_delay;
+    s->end=s->start+s->trigger_duration;
+    char ack[1100],tmp[1110];
+    snprintf(ack,sizeof ack,"%s.ack",s->trigger_path);
+    snprintf(tmp,sizeof tmp,"%s.tmp",ack);
+    f=fopen(tmp,"w");
+    if (f) {
+        fprintf(f,"{\"base_ns\":%llu,\"start_ns\":%llu,\"end_ns\":%llu}\n",
+            (unsigned long long)s->base,(unsigned long long)s->start,(unsigned long long)s->end);
+        if (fclose(f)==0)rename(tmp,ack);
+    }
+    fprintf(stderr,"[ftrace] armed %.3f..%.3f s after boot\n",
+        (double)(s->start-s->base)/1e9,(double)(s->end-s->base)/1e9);
+    __atomic_store_n(&s->on,2,__ATOMIC_RELEASE);
+}
