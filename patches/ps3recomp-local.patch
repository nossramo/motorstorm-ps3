+#!/usr/bin/env python3
+"""Run real GCM callback/flip regressions with legacy and counted vblank."""
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+import tempfile
+root = Path(__file__).resolve().parents[1]
+with tempfile.TemporaryDirectory(prefix="gcm-vblank-") as tmp:
+    binary=Path(tmp)/"fixture"
+    linker=["-Wl,-dead_strip"] if sys.platform=="darwin" else ["-Wl,--gc-sections","-lm"]
+    subprocess.run([os.environ.get("CC","cc"),"-std=gnu17","-O1","-UNDEBUG","-pthread",
+        "-ffunction-sections","-fdata-sections",*shlex.split(os.environ.get("CFLAGS","")),
+        "-I"+str(root/"include"),"-I"+str(root/"libs/video"),
+        str(root/"libs/video/tests/test_gcm_flip_status.c"),*linker,
+        "-o",str(binary)],check=True)
+    for mode in ("0","1"):
+        print("GCM_VBLANK_COUNTED="+mode,flush=True)
+        subprocess.run([str(binary)],env=dict(os.environ,GCM_VBLANK_COUNTED=mode),
+                       check=True,timeout=20)
diff --git a/tools/test_spu_lockline_host.py b/tools/test_spu_lockline_host.py
new file mode 100644
index 0000000..6062b26
--- /dev/null
+++ b/tools/test_spu_lockline_host.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Check real lock exclusion/publication and record synthetic contention costs."""
+import argparse
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+import tempfile
+
+p = argparse.ArgumentParser(description=__doc__)
+p.add_argument("--out", type=Path)
+p.add_argument("--coherency", action="store_true", help="Also run real PPU/SPU reservation regression fixtures")
+a = p.parse_args()
+if sys.platform != "darwin":
+    print("SKIP: Darwin host-lock comparison requires macOS")
+    raise SystemExit(0)
+root = Path(__file__).resolve().parents[1]
+env = {k: v for k, v in os.environ.items() if k != "SPU_LOCKLINE_HOST"}
+results = []
+coherency = []
+with tempfile.TemporaryDirectory(prefix="spu-host-lock-") as tmp:
+    binary = Path(tmp) / "fixture"
+    subprocess.run([os.environ.get("CC", "cc"), "-std=gnu17", "-O2", "-UNDEBUG",
+                    *shlex.split(os.environ.get("CFLAGS", "")), "-pthread",
+                    "-I" + str(root / "include"), "-I" + str(root / "runtime/spu"),
+                    str(root / "runtime/spu/tests/test_spu_lockline_host.c"),
+                    str(root / "runtime/spu/spu_coherency.c"), "-o", str(binary)], check=True)
+    for workers, iterations, delayed in ((1, 200000, 0), (6, 30000, 0), (6, 2000, 1)):
+        # Reverse order on the second repetition to expose order/load effects.
+        for repeat in range(2):
+            for mode in (("0", "1") if repeat == 0 else ("1", "0")):
+                r = subprocess.run([str(binary), str(workers), str(iterations), str(delayed)],
+                                   env=dict(env, SPU_LOCKLINE_HOST=mode),
+                                   check=True, capture_output=True, text=True, timeout=15)
+                results.append(dict(mode="native" if mode == "1" else "legacy", repeat=repeat,
+                                    **json.loads(r.stdout)))
+    if a.coherency:
+        spu = root / "runtime/spu"
+        common = ["spu_drain.c", "spu_lockstep.c", "spu_coherency.c", "spu_workload.c",
+                  "spurs_policy.c", "spurs_job.c", "spu_tsp_weak.c", "spu_vm_pagemap.c",
+                  "spurs_policy_blob_weak.c", "spu_interp.c"]
+        for name in ("test_spu_coherency", "test_spu_lockline_peer"):
+            fixture = Path(tmp) / name
+            sources = [spu / "tests" / (name + ".c")]
+            if name == "test_spu_lockline_peer":
+                sources += [spu / source for source in common]
+                sources.append(root / "runtime/platform/win32_compat.c")
+            subprocess.run([os.environ.get("CC", "cc"), "-std=gnu17", "-O1", "-UNDEBUG",
+                            *shlex.split(os.environ.get("CFLAGS", "")), "-pthread",
+                            "-I" + str(root / "include"), "-I" + str(spu),
+                            "-I" + str(root / "runtime/platform"),
+                            *map(str, sources), "-lm", "-o", str(fixture)], check=True)
+            for mode in ("0", "1"):
+                r = subprocess.run([str(fixture)], env=dict(env, SPU_LOCKLINE_HOST=mode),
