+                v = prefix[k]; b = operands(v)
+                if v.mnemonic in ('bl', 'bctrl', 'blrl', 'sc'):
+                    return None
+                if b and b[0] == 'r1' and not v.mnemonic.startswith(('st', 'lf', 'cmp')):
