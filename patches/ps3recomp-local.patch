+    pthread_cond_t changed;
+    struct spu_host_resv_waiter* next;
+} spu_host_resv_waiter;
+/* List and predicate are protected by the existing coherence lock. The
+ * notifier and the waiter both acquire coherence -> waiter mutex, in that
+ * order. The waiter releases coherence before cond_wait, and releases its
+ * mutex before reacquiring coherence to unlink. This closes check-to-sleep
+ * without holding the coherence lock while asleep or reversing lock order.
+ * TLS storage remains alive until the synchronous call has unlinked itself. */
+static spu_host_resv_waiter* s_host_waiters;
+static _Thread_local spu_host_resv_waiter t_host_waiter = {
+    .mutex = PTHREAD_MUTEX_INITIALIZER, .changed = PTHREAD_COND_INITIALIZER
+};
+static void spu_host_resv_notify(spu_context* ctx)
+{
+    for (spu_host_resv_waiter* w = s_host_waiters; w; w = w->next) {
+        if (w->ctx != ctx) continue;
+        pthread_mutex_lock(&w->mutex);
+        pthread_cond_signal(&w->changed);
+        pthread_mutex_unlock(&w->mutex);
+    }
+}
+
+int spu_coh_wait_reservation(spu_context* ctx, unsigned timeout_us)
+{
+    if (!ctx || !timeout_us || timeout_us > 1000000) return 3;
+    spu_host_resv_waiter* w = &t_host_waiter;
+    if (w->ctx) return 3; /* No nested wait on this host thread. */
+    struct timespec deadline = { .tv_sec = timeout_us / 1000000,
+                                .tv_nsec = (timeout_us % 1000000) * 1000L };
+#if !defined(__APPLE__)
+    struct timespec now;
+    clock_gettime(CLOCK_REALTIME, &now);
+    deadline.tv_sec += now.tv_sec;
+    deadline.tv_nsec += now.tv_nsec;
+    if (deadline.tv_nsec >= 1000000000L) {
+        deadline.tv_nsec -= 1000000000L;
+        deadline.tv_sec++;
+    }
+#endif
+    spu_lockline_lock();
+    if (!ctx->resv_valid) { spu_lockline_unlock(); return 0; }
+    pthread_mutex_lock(&w->mutex);
+    w->ctx = ctx;
+    w->next = s_host_waiters;
+    s_host_waiters = w;
+    spu_lockline_unlock();
+#if defined(__APPLE__)
+    int rc = pthread_cond_timedwait_relative_np(&w->changed, &w->mutex, &deadline);
+#else
+    int rc = pthread_cond_timedwait(&w->changed, &w->mutex, &deadline);
+#endif
+    pthread_mutex_unlock(&w->mutex);
+    spu_lockline_lock();
+    for (spu_host_resv_waiter** link = &s_host_waiters; *link; link = &(*link)->next) {
+        if (*link != w) continue;
+        *link = w->next;
+        break;
+    }
+    w->ctx = NULL;
+    w->next = NULL;
+    spu_lockline_unlock();
+    return rc == ETIMEDOUT ? 2 : rc == 0 ? 1 : 3;
+}
+#else
+static void spu_host_resv_notify(spu_context* ctx) { (void)ctx; }
+int spu_coh_wait_reservation(spu_context* ctx, unsigned timeout_us)
+{
+    (void)ctx; (void)timeout_us; return 3;
+}
