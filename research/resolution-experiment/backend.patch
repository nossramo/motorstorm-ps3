+/* Opt-in resolution experiment. Guest pitches/addresses remain unchanged.
+ * Rectangular scene/effect targets scale; square shadow maps and tiny lookup
+ * targets retain their original quality. Never infer scale from window size. */
+static u32 s_eng_guest_w[ENG_MAX_OBJECTS], s_eng_guest_h[ENG_MAX_OBJECTS];
+static u32 eng_scaled_extent(u32 n, u32 w, u32 h)
+{
+    if (w == h || w < 160 || h < 90) return n;
+    return (u32)(((u64)n * s_eng_internal_height + 360u) / 720u);
+}
+static u32 eng_pixel_bytes(MTLPixelFormat f)
+{
+    switch (f) {
+    case MTLPixelFormatR8Unorm: return 1;
+    case MTLPixelFormatRG8Unorm: case MTLPixelFormatR16Unorm: return 2;
+    case MTLPixelFormatRGBA8Unorm: case MTLPixelFormatBGRA8Unorm:
+    case MTLPixelFormatRG16Unorm: case MTLPixelFormatRG16Float:
+    case MTLPixelFormatR32Float: return 4;
+    case MTLPixelFormatRGBA16Float: return 8;
+    case MTLPixelFormatRGBA32Float: return 16;
+    default: return 0;
+    }
+}
 
